{% extends 'base.html.twig' %}

{% block title %}Réservation {{ reservation.codeConfirmation }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_user_reservation_index') }}" class="hover:text-gold-400 transition-colors">Mes Réservations</a>
    <i class="fa-solid fa-chevron-right mx-2 text-xs"></i>
    <span>{{ reservation.codeConfirmation }}</span>
{% endblock %}

{% block body %}
{% set panier = reservation.panier %}
{% set lieu = panier ? panier.lieuTouristique : null %}

<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-600 mb-2">Détails de la Réservation</h1>
        <p class="text-gray-400">Code: <span class="text-blue-500 font-semibold font-mono">{{ reservation.codeConfirmation }}</span></p>
    </div>
    <div class="flex gap-3">
        <a href="{{ path('app_user_reservation_pdf', {'id': reservation.id}) }}" target="_blank" class="btn-dark flex items-center gap-2">
            <i class="fa-solid fa-file-pdf"></i> Télécharger PDF
        </a>
        <a href="{{ path('app_user_reservation_index') }}" class="btn-gold flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i> Retour
        </a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Info -->
    <div class="lg:col-span-2 space-y-6">
        <div class="card">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-gold-500/10">
                <h2 class="text-xl font-bold text-blue-400">
                    <i class="fa-solid fa-ticket mr-2"></i>
                    Informations de la Réservation
                </h2>
                <span class="px-4 py-2 font-semibold rounded-full text-sm border {{ reservation.statutBadgeClass }}">
                    {{ reservation.statutPaiement }}
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <div>
                        <label class="text-gold-500/70 text-xs uppercase tracking-widest">Lieu</label>
                        <p class="text-white text-lg font-semibold mt-1">
                            {{ lieu ? lieu.nom : 'Non spécifié' }}
                        </p>
                    </div>
                    <div>
                        <label class="text-gold-500/70 text-xs uppercase tracking-widest">Ville</label>
                        <p class="text-white text-lg font-semibold mt-1">
                            {{ lieu ? lieu.ville : 'Non spécifié' }}
                        </p>
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="text-gold-500/70 text-xs uppercase tracking-widest">Mode de Paiement</label>
                        <p class="text-white text-lg font-semibold mt-1">
                            <i class="fa-solid fa-{{ reservation.modePaiementIcon }} mr-2 text-gold-500/50"></i>
                            {{ reservation.modePaiement }}
                        </p>
                    </div>
                    <div>
                        <label class="text-gold-500/70 text-xs uppercase tracking-widest">Date de Réservation</label>
                        <p class="text-white text-lg font-semibold mt-1">
                            {{ reservation.datePaiement|date('d/m/Y H:i') }}
                        </p>
                    </div>
                </div>
            </div>

            {% if panier %}
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6 pt-6 border-t border-gold-500/10">
                <div class="bg-dark-300/50 rounded-xl p-4 text-center">
                    <p class="text-gold-500/70 text-xs uppercase tracking-widest mb-2">Date Début</p>
                    <p class="text-white font-semibold">{{ panier.dateDebut|date('d/m/Y') }}</p>
                </div>
                <div class="bg-dark-300/50 rounded-xl p-4 text-center">
                    <p class="text-gold-500/70 text-xs uppercase tracking-widest mb-2">Date Fin</p>
                    <p class="text-white font-semibold">{{ panier.dateFin|date('d/m/Y') }}</p>
                </div>
                <div class="bg-dark-300/50 rounded-xl p-4 text-center">
                    <p class="text-gold-500/70 text-xs uppercase tracking-widest mb-2">Personnes</p>
                    <p class="text-white font-semibold">{{ panier.nbPersonnes }} ({{ panier.nbAdultes }}A + {{ panier.nbEnfants }}E)</p>
                </div>
                <div class="bg-dark-300/50 rounded-xl p-4 text-center">
                    <p class="text-gold-500/70 text-xs uppercase tracking-widest mb-2">Durée</p>
                    <p class="text-white font-semibold">{{ panier.nbJours }} jour(s)</p>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Rating Form -->
        <div class="card">
            <h2 class="text-xl font-bold text-gold-400 mb-6 pb-4 border-b border-gold-500/10">
                <i class="fa-solid fa-star mr-2"></i>
                Évaluation
            </h2>

            {% if reservation.rating %}
                <div class="space-y-4">
                    <div class="flex items-center gap-4">
                        <span class="text-4xl text-yellow-400">{{ reservation.starRating }}</span>
                        <span class="text-2xl text-white font-bold">{{ reservation.rating }}/5</span>
                    </div>
                    {% if reservation.reviewComment %}
                        <div class="bg-dark-300/50 rounded-xl p-4 mt-4">
                            <p class="text-gray-500 text-xs uppercase mb-2">Votre commentaire</p>
                            <p class="text-gray-300 italic">"{{ reservation.reviewComment }}"</p>
                        </div>
                    {% endif %}
                    <p class="text-green-400 text-sm"><i class="fa-solid fa-check mr-2"></i>Merci pour votre évaluation !</p>
                </div>
            {% elseif reservation.statutPaiement == 'Payé' %}
                <form method="post" action="{{ path('app_user_reservation_rate', {'id': reservation.id}) }}" class="space-y-6">
                    <div>
                        <label class="block text-gold-500/70 text-xs uppercase tracking-widest mb-3">Note (Cliquez sur une étoile)</label>
                        <div class="flex gap-2" id="star-rating">
                            {% for i in 1..5 %}
                                <button type="button" onclick="setRating({{ i }})" class="text-4xl text-gray-600 hover:text-yellow-400 transition-colors star-btn" data-rating="{{ i }}">
                                    ★
                                </button>
                            {% endfor %}
                        </div>
                        <input type="hidden" name="rating" id="rating-input" value="" required>
                    </div>

                    <div>
                        <label class="block text-gold-500/70 text-xs uppercase tracking-widest mb-2">Commentaire (optionnel)</label>
                        <textarea name="comment" rows="4" class="input-modern" placeholder="Partagez votre expérience..."></textarea>
                    </div>

                    <button type="submit" class="btn-gold w-full flex items-center justify-center gap-2">
                        <i class="fa-solid fa-paper-plane"></i>
                        Soumettre mon avis
                    </button>
                </form>

                <script>
                    function setRating(rating) {
                        document.getElementById('rating-input').value = rating;
                        document.querySelectorAll('.star-btn').forEach((btn, index) => {
                            if (index < rating) {
                                btn.classList.remove('text-gray-600');
                                btn.classList.add('text-yellow-400');
                            } else {
                                btn.classList.remove('text-yellow-400');
                                btn.classList.add('text-gray-600');
                            }
                        });
                    }
                </script>
            {% else %}
                <p class="text-gray-500">Vous pourrez évaluer cette réservation une fois le paiement confirmé.</p>
            {% endif %}
        </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
        <!-- Image -->
        {% if lieu and lieu.image %}
        <div class="card p-0 overflow-hidden">
            <img src="{{ asset(lieu.image) }}" alt="{{ lieu.nom }}" class="w-full h-48 object-cover">
            <div class="p-4">
                <h3 class="font-bold text-white">{{ lieu.nom }}</h3>
                <p class="text-gray-400 text-sm">{{ lieu.ville }}</p>
            </div>
        </div>
        {% endif %}

        <!-- Price Card -->
        <div class="card bg-gradient-to-br from-dark-300 to-black border-blue-500/20">
            <h3 class="text-lg font-bold text-blue-400 mb-4">Total</h3>
            <p class="text-4xl font-black text-white">{{ reservation.montantTotal|number_format(2) }} <span class="text-sm text-gold-500">TND</span></p>
        </div>

        <!-- Actions -->
        <div class="card">
            <h3 class="text-lg font-bold text-gold-400 mb-4">Actions</h3>
            <div class="space-y-3">
                <a href="{{ path('app_user_reservation_pdf', {'id': reservation.id}) }}" target="_blank" class="w-full btn-dark flex items-center justify-center gap-2">
                    <i class="fa-solid fa-file-pdf"></i> Télécharger PDF
                </a>

                {% if reservation.statutPaiement == 'En cours de paiement' %}
                <form method="post" action="{{ path('app_user_reservation_cancel', {'id': reservation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette réservation?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ reservation.id) }}">
                    <button type="submit" class="w-full bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 hover:border-red-500/40 px-4 py-2.5 rounded-xl transition-all flex items-center justify-center gap-2">
                        <i class="fa-solid fa-times"></i> Annuler
                    </button>
                </form>
                {% endif %}
            </div>
        </div>

        <!-- Confirmation Code -->
        <div class="card text-center">
            <p class="text-gray-400 text-sm mb-2">Code de Confirmation</p>
            <p class="text-2xl font-mono font-bold text-gold-500 bg-dark-300/50 px-4 py-3 rounded-xl">{{ reservation.codeConfirmation }}</p>
        </div>
    </div>
</div>
{% endblock %}
