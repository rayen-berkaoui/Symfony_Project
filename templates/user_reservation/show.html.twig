{% extends 'base_front.html.twig' %}

{% block title %}Réservation {{ reservation.codeConfirmation }}{% endblock %}

{% block body %}
<section class="mx-auto max-w-7xl px-4 py-8 space-y-8">
    <div class="flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between">
        <div>
            <p class="text-sm uppercase tracking-[0.3em] text-gold-500/70">Réservation intelligente</p>
            <h1 class="text-4xl font-black text-white">{{ reservation.codeConfirmation }}</h1>
            <p class="mt-2 text-gray-400">Suivi paiement, résumé du service et export PDF depuis une seule vue.</p>
        </div>
        <div class="flex flex-wrap gap-3">
            {% if calendarUrl %}<a href="{{ calendarUrl }}" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-2xl border border-sky-400/30 bg-sky-500/10 px-5 py-3 font-semibold text-sky-100 shadow-lg shadow-sky-500/10 transition hover:-translate-y-0.5 hover:border-sky-300/50 hover:bg-sky-500/20"><i class="fa-solid fa-calendar-days text-sky-300"></i><span>Ouvrir dans Google Calendar</span></a>{% endif %}
            <a href="{{ path('app_user_reservation_pdf', {'id': reservation.id}) }}" class="inline-flex items-center gap-2 rounded-2xl border border-gold-500/20 bg-gold-500/10 px-5 py-3 font-semibold text-gold-100 shadow-lg shadow-gold-500/10 transition hover:-translate-y-0.5 hover:bg-gold-500/20"><i class="fa-solid fa-file-pdf text-gold-400"></i><span>Télécharger le PDF</span></a>
            <a href="{{ path('app_user_reservation_index') }}" class="inline-flex items-center gap-2 rounded-2xl border border-white/10 bg-white/5 px-5 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:border-white/20 hover:bg-white/10"><i class="fa-solid fa-arrow-left"></i><span>Retour aux réservations</span></a>
        </div>
    </div>

    <div class="grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
        <div class="space-y-6">
            <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
                <div class="rounded-3xl border border-white/10 bg-dark-300/80 p-5"><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Service</p><p class="mt-3 text-2xl font-black text-white">{{ row.displayName }}</p><p class="mt-2 text-sm text-gray-500">{{ row.displayCity ?: row.typeService }}</p></div>
                <div class="rounded-3xl border border-white/10 bg-dark-300/80 p-5"><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Statut</p><p class="mt-3"><span class="rounded-full border px-3 py-1 text-xs font-semibold {{ reservation.statutBadgeClass }}">{{ reservation.normalizedStatutPaiement }}</span></p><p class="mt-2 text-sm text-gray-500">Mode {{ reservation.modePaiementLabel }}</p></div>
                <div class="rounded-3xl border border-white/10 bg-dark-300/80 p-5"><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Montant</p><p class="mt-3 text-3xl font-black text-gold-400">{{ reservation.montantTotal|number_format(2, '.', ' ') }}</p><p class="mt-2 text-sm text-gray-500">TND</p></div>
                <div class="rounded-3xl border border-white/10 bg-dark-300/80 p-5"><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Voyageurs</p><p class="mt-3 text-3xl font-black text-white">{{ row.nbPersonnes ?: '—' }}</p><p class="mt-2 text-sm text-gray-500">{{ row.nbChambres ?: 0 }} chambre(s)</p></div>
            </div>

            <div class="rounded-3xl border border-white/10 bg-dark-300/80 p-6 shadow-luxury grid gap-4 md:grid-cols-2">
                <div><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Début</p><p class="mt-2 text-white">{{ row.dateDebut ? row.dateDebut|date('d/m/Y H:i') : '—' }}</p></div>
                <div><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Fin</p><p class="mt-2 text-white">{{ row.dateFin ? row.dateFin|date('d/m/Y H:i') : '—' }}</p></div>
                <div><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Ville</p><p class="mt-2 text-white">{{ row.displayCity ?: 'Tunisie' }}</p></div>
                <div><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Référence</p><p class="mt-2 text-white">{{ reservation.codeConfirmation }}</p></div>
            </div>

            {% if reviewInfo is not empty %}
            <div class="grid gap-6 lg:grid-cols-2">
                <article class="rounded-3xl border border-sky-500/20 bg-sky-500/10 p-6 shadow-luxury">
                    <p class="text-xs uppercase tracking-[0.22em] text-sky-200">Reviews API</p>
                    <h2 class="mt-2 text-2xl font-black text-white">Réputation du lieu</h2>
                    <p class="mt-4 text-sm text-sky-100/85">{{ reviewInfo.summary ?: 'Résumé indisponible.' }}</p>
                    <div class="mt-5 flex flex-wrap gap-4 text-sm text-white">
                        <span class="rounded-full border border-white/10 bg-black/20 px-3 py-2">Note {{ reviewInfo.rating ?: '—' }}</span>
                        <span class="rounded-full border border-white/10 bg-black/20 px-3 py-2">Avis {{ reviewInfo.user_rating_count ?: '—' }}</span>
                        {% if reviewInfo.maps_url %}<a href="{{ reviewInfo.maps_url }}" target="_blank" rel="noopener" class="rounded-full border border-white/10 bg-black/20 px-3 py-2">Voir sur Maps</a>{% endif %}
                    </div>
                </article>
                <article class="rounded-3xl border border-violet-500/20 bg-violet-500/10 p-6 shadow-luxury">
                    <p class="text-xs uppercase tracking-[0.22em] text-violet-200">LibreTranslate API</p>
                    <h2 class="mt-2 text-2xl font-black text-white">Résumé multilingue</h2>
                    <div class="mt-4 space-y-3 text-sm text-violet-100/85">
                        <div><strong class="text-white">EN</strong><p class="mt-1">{{ reviewTranslations.en ?: 'LibreTranslate est utilisé automatiquement quand le service public est disponible.' }}</p></div>
                        <div><strong class="text-white">AR</strong><p class="mt-1">{{ reviewTranslations.ar ?: 'LibreTranslate est utilisé automatiquement quand le service public est disponible.' }}</p></div>
                    </div>
                </article>
            </div>
            {% endif %}
        </div>

        <aside class="space-y-6">
            <div class="rounded-3xl border border-white/10 bg-dark-300/80 p-6 shadow-luxury">
                <h2 class="text-xl font-bold text-white">Votre avis</h2>
                {% if reservation.rating %}
                    <p class="mt-4 text-gold-400 text-2xl">{{ reservation.starRating }}</p>
                    <p class="mt-3 text-sm text-gray-400">{{ reservation.reviewComment ?: 'Sans commentaire.' }}</p>
                {% elseif reservation.isPaid %}
                    <form method="post" action="{{ path('app_user_reservation_rate', {'id': reservation.id}) }}" class="mt-4 space-y-4">
                        <input type="number" name="rating" min="1" max="5" class="w-full rounded-xl border border-white/10 bg-dark-200 px-4 py-3 text-white" placeholder="Note entre 1 et 5" required>
                        <textarea name="comment" rows="4" class="w-full rounded-xl border border-white/10 bg-dark-200 px-4 py-3 text-white" placeholder="Votre retour"></textarea>
                        <button class="btn-gold">Envoyer</button>
                    </form>
                {% else %}
                    <p class="mt-4 text-sm text-gray-400">L'avis devient disponible après validation du paiement.</p>
                {% endif %}
            </div>

            {% if reservation.normalizedStatutPaiement in ['En cours de paiement', 'En attente'] %}
                <div class="rounded-3xl border border-rose-500/20 bg-rose-500/5 p-6">
                    <form method="post" action="{{ path('app_user_reservation_cancel', {'id': reservation.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ reservation.id) }}">
                        <button class="w-full rounded-2xl bg-rose-500/10 px-4 py-3 font-semibold text-rose-300 hover:bg-rose-500/20">Annuler la réservation</button>
                    </form>
                </div>
            {% endif %}
        </aside>
    </div>
</section>
{% endblock %}
