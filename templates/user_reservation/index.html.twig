{% extends 'base.html.twig' %}

{% block title %}Mes Réservations{% endblock %}

{% block breadcrumb %}
    <span>Mes Réservations</span>
{% endblock %}

{% block body %}
<div class="mb-10 flex flex-col md:flex-row md:items-start justify-between gap-4 animate-[fade-in_0.5s_ease-out]">
    <div>
        <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-600 mb-2 drop-shadow-[0_4px_15px_rgba(59,130,246,0.4)]">Mes Réservations</h1>
        <p class="text-gray-400 text-lg">Consultez l'historique de vos réservations et téléchargez vos confirmations.</p>
    </div>

    <a href="{{ path('app_lieu_touristique_index') }}" class="group flex items-center justify-center gap-2 bg-gradient-to-r from-gold-500 to-yellow-600 hover:from-gold-400 hover:to-yellow-500 text-black px-5 py-2.5 rounded-xl transition-all duration-300 shadow-[0_0_15px_rgba(255,215,0,0.3)] hover:shadow-[0_4px_20px_rgba(255,215,0,0.5)] whitespace-nowrap font-bold">
        <i class="fa-solid fa-plus text-lg"></i>
        <span>Nouvelle Réservation</span>
    </a>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
    <div class="card bg-gradient-to-br from-dark-300 to-black border-blue-500/10 hover:border-blue-500/30 transition-all">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500/20 to-blue-700/10 flex items-center justify-center text-blue-500">
                <i class="fa-solid fa-ticket text-2xl"></i>
            </div>
            <div>
                <p class="text-blue-500/70 text-xs font-bold uppercase tracking-widest">Total</p>
                <h3 class="text-3xl font-black text-white">{{ stats.total }}</h3>
            </div>
        </div>
    </div>

    <div class="card bg-gradient-to-br from-dark-300 to-black border-green-500/10 hover:border-green-500/30 transition-all">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-500/20 to-green-700/10 flex items-center justify-center text-green-500">
                <i class="fa-solid fa-check-circle text-2xl"></i>
            </div>
            <div>
                <p class="text-green-500/70 text-xs font-bold uppercase tracking-widest">Payées</p>
                <h3 class="text-3xl font-black text-white">{{ stats.paye }}</h3>
            </div>
        </div>
    </div>

    <div class="card bg-gradient-to-br from-dark-300 to-black border-yellow-500/10 hover:border-yellow-500/30 transition-all">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-yellow-500/20 to-yellow-700/10 flex items-center justify-center text-yellow-500">
                <i class="fa-solid fa-hourglass-half text-2xl"></i>
            </div>
            <div>
                <p class="text-yellow-500/70 text-xs font-bold uppercase tracking-widest">En Attente</p>
                <h3 class="text-3xl font-black text-white">{{ stats.en_cours }}</h3>
            </div>
        </div>
    </div>

    <div class="card bg-gradient-to-br from-dark-300 to-black border-gold-500/10 hover:border-gold-500/30 transition-all">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-gold-500/20 to-gold-700/10 flex items-center justify-center text-gold-500">
                <i class="fa-solid fa-coins text-2xl"></i>
            </div>
            <div>
                <p class="text-gold-500/70 text-xs font-bold uppercase tracking-widest">Dépensé</p>
                <h3 class="text-2xl font-black text-white">{{ stats.total_spent|number_format(2) }} <span class="text-sm">TND</span></h3>
            </div>
        </div>
    </div>
</div>

{% if reservations is empty %}
    <div class="card text-center py-16">
        <div class="w-24 h-24 rounded-full bg-dark-200 flex items-center justify-center mx-auto mb-6">
            <i class="fa-solid fa-calendar-xmark text-4xl text-gray-600"></i>
        </div>
        <h2 class="text-2xl font-bold text-white mb-4">Aucune réservation</h2>
        <p class="text-gray-400 mb-8">Vous n'avez pas encore effectué de réservations.</p>
        <a href="{{ path('app_lieu_touristique_index') }}" class="btn-gold inline-flex items-center gap-2">
            <i class="fa-solid fa-map-location-dot"></i>
            Découvrir les lieux
        </a>
    </div>
{% else %}
    <div class="space-y-6">
        {% for reservation in reservations %}
            {% set panier = reservation.panier %}
            {% set lieu = panier ? panier.lieuTouristique : null %}
            <div class="card group hover:border-blue-500/30 transition-all duration-300">
                <div class="flex flex-col md:flex-row gap-6">
                    <!-- Image -->
                    <div class="w-full md:w-48 h-48 md:h-auto rounded-xl overflow-hidden bg-black/50 flex-shrink-0">
                        {% if lieu and lieu.image %}
                            <img src="{{ asset(lieu.image) }}" alt="{{ lieu.nom }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                        {% else %}
                            <div class="w-full h-full flex items-center justify-center text-gray-600">
                                <i class="fa-solid fa-ticket text-3xl"></i>
                            </div>
                        {% endif %}
                    </div>

                    <!-- Content -->
                    <div class="flex-1 flex flex-col">
                        <div class="flex items-start justify-between mb-4">
                            <div>
                                <span class="text-blue-400/70 text-xs font-bold uppercase tracking-widest font-mono">{{ reservation.codeConfirmation }}</span>
                                <h3 class="text-xl font-bold text-white group-hover:text-blue-400 transition-colors">
                                    {{ lieu ? lieu.nom : 'Lieu non disponible' }}
                                </h3>
                                {% if lieu %}
                                <p class="text-gray-400 text-sm">
                                    <i class="fa-solid fa-location-dot mr-1 text-gold-500/50"></i>
                                    {{ lieu.ville }}
                                </p>
                                {% endif %}
                            </div>
                            <span class="px-3 py-1 font-semibold rounded-full text-xs border {{ reservation.statutBadgeClass }}">
                                {{ reservation.statutPaiement }}
                            </span>
                        </div>

                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                            <div>
                                <p class="text-gray-500 text-xs uppercase">Date début</p>
                                <p class="text-white font-semibold">{{ panier ? panier.dateDebut|date('d/m/Y') : '-' }}</p>
                            </div>
                            <div>
                                <p class="text-gray-500 text-xs uppercase">Date fin</p>
                                <p class="text-white font-semibold">{{ panier ? panier.dateFin|date('d/m/Y') : '-' }}</p>
                            </div>
                            <div>
                                <p class="text-gray-500 text-xs uppercase">Mode</p>
                                <p class="text-white font-semibold">
                                    <i class="fa-solid fa-{{ reservation.modePaiementIcon }} mr-1 text-gold-500/50"></i>
                                    {{ reservation.modePaiement }}
                                </p>
                            </div>
                            <div>
                                <p class="text-gray-500 text-xs uppercase">Personnes</p>
                                <p class="text-white font-semibold">{{ panier ? panier.nbPersonnes : '-' }}</p>
                            </div>
                        </div>

                        {% if reservation.rating %}
                        <div class="mb-4">
                            <span class="text-yellow-400">{{ reservation.starRating }}</span>
                        </div>
                        {% endif %}

                        <div class="flex items-center justify-between mt-auto pt-4 border-t border-white/5">
                            <p class="text-blue-400 font-black text-2xl">{{ reservation.montantTotal|number_format(2) }} <span class="text-sm">TND</span></p>

                            <div class="flex gap-2">
                                <a href="{{ path('app_user_reservation_show', {'id': reservation.id}) }}" class="px-4 py-2 rounded-xl bg-blue-500/10 hover:bg-blue-500/20 text-blue-400 border border-blue-500/20 hover:border-blue-500/40 transition-all flex items-center gap-2">
                                    <i class="fa-solid fa-eye"></i>
                                    <span class="hidden sm:inline">Détails</span>
                                </a>
                                <a href="{{ path('app_user_reservation_pdf', {'id': reservation.id}) }}" target="_blank" class="px-4 py-2 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 hover:border-red-500/40 transition-all flex items-center gap-2">
                                    <i class="fa-solid fa-file-pdf"></i>
                                    <span class="hidden sm:inline">PDF</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
