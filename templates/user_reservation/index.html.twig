{% extends 'base_front.html.twig' %}

{% block title %}Mes réservations{% endblock %}

{% block body %}
<section class="mx-auto max-w-7xl px-4 py-8 space-y-8">
    <div>
        <p class="text-sm uppercase tracking-[0.3em] text-gold-500/70">Tableau de bord client</p>
        <h1 class="text-4xl font-black text-white">Mes réservations</h1>
        <p class="mt-2 text-gray-400">Toutes vos réservations validées ou en attente, avec accès direct au PDF et aux évaluations.</p>
    </div>

    <div class="grid gap-4 md:grid-cols-4">
        <div class="rounded-3xl border border-white/10 bg-dark-300/80 p-5"><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Total</p><p class="mt-3 text-4xl font-black text-white">{{ stats.total }}</p></div>
        <div class="rounded-3xl border border-white/10 bg-dark-300/80 p-5"><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Payées</p><p class="mt-3 text-4xl font-black text-emerald-300">{{ stats.paye }}</p></div>
        <div class="rounded-3xl border border-white/10 bg-dark-300/80 p-5"><p class="text-xs uppercase tracking-[0.2em] text-gray-500">À suivre</p><p class="mt-3 text-4xl font-black text-amber-300">{{ stats.en_cours }}</p></div>
        <div class="rounded-3xl border border-gold-500/20 bg-dark-300/80 p-5"><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Total payé</p><p class="mt-3 text-4xl font-black text-gold-400">{{ stats.total_spent|number_format(2, '.', ' ') }}</p></div>
    </div>

    <div class="grid gap-6 lg:grid-cols-2 xl:grid-cols-3">
        {% for row in rows %}
            {% set badgeClass = row.normalizedStatutPaiement == 'Paye' ? 'bg-emerald-500/10 text-emerald-300 border-emerald-500/20' : (row.normalizedStatutPaiement in ['En cours de paiement', 'En attente'] ? 'bg-amber-500/10 text-amber-300 border-amber-500/20' : 'bg-slate-500/10 text-slate-300 border-slate-500/20') %}
            <article class="rounded-3xl border border-white/10 bg-dark-300/80 p-6 shadow-luxury">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <p class="text-xs uppercase tracking-[0.2em] text-gray-500">{{ row.codeConfirmation }}</p>
                        <h2 class="mt-2 text-2xl font-black text-white">{{ row.displayName }}</h2>
                        <p class="mt-2 text-sm text-gray-400">{{ row.displayCity ?: row.typeService }}</p>
                        {% if row.orphaned %}
                            <p class="mt-2 inline-flex rounded-full border border-amber-500/20 bg-amber-500/10 px-3 py-1 text-xs font-semibold text-amber-200">Archive sécurisée</p>
                        {% endif %}
                    </div>
                    <span class="rounded-full border px-3 py-1 text-xs font-semibold {{ badgeClass }}">{{ row.normalizedStatutPaiement }}</span>
                </div>
                <div class="mt-5 grid gap-3 text-sm text-gray-300">
                    <div class="flex items-center justify-between"><span>Période</span><strong class="text-white">{{ row.dateDebut ? row.dateDebut|date('d/m H:i') : '—' }} → {{ row.dateFin ? row.dateFin|date('d/m H:i') : '—' }}</strong></div>
                    <div class="flex items-center justify-between"><span>Montant</span><strong class="text-gold-400">{{ row.montantTotal|number_format(2, '.', ' ') }} TND</strong></div>
                    <div class="flex items-center justify-between"><span>Voyageurs</span><strong class="text-white">{{ row.nbPersonnes ?: '—' }}</strong></div>
                </div>
                <div class="mt-6 flex flex-wrap gap-3">
                    <a href="{{ path('app_user_reservation_show', {'id': row.id}) }}" class="inline-flex items-center gap-2 rounded-2xl border border-sky-400/30 bg-sky-500/10 px-5 py-3 text-sm font-semibold text-sky-100 shadow-lg shadow-sky-500/10 transition hover:-translate-y-0.5 hover:border-sky-300/50 hover:bg-sky-500/20"><i class="fa-solid fa-eye text-sky-300"></i><span>Voir la réservation</span></a>
                    <a href="{{ path('app_user_reservation_pdf', {'id': row.id}) }}" class="inline-flex items-center gap-2 rounded-2xl border border-gold-500/20 bg-gold-500/10 px-4 py-3 text-sm font-semibold text-gold-200 transition hover:bg-gold-500/20"><i class="fa-solid fa-file-pdf text-gold-400"></i>Voir PDF</a>
                </div>
            </article>
        {% else %}
            <div class="col-span-full rounded-3xl border border-white/10 bg-dark-300/80 p-12 text-center text-gray-500">Aucune réservation pour le moment.</div>
        {% endfor %}
    </div>
</section>
{% endblock %}
