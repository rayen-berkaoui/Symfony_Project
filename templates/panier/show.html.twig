{% extends 'base.html.twig' %}

{% block title %}Panier #{{ panier.id }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_panier_index') }}" class="hover:text-gold-400 transition-colors">Paniers</a>
    <i class="fa-solid fa-chevron-right mx-2 text-xs"></i>
    <span>Détails #{{ panier.id }}</span>
{% endblock %}

{% block body %}
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-yellow-600 mb-2">Détails du Panier</h1>
        <p class="text-gray-400">Référence: <span class="text-gold-500 font-semibold">#{{ panier.id }}</span></p>
    </div>
    <div class="flex gap-3">
        <a href="{{ path('app_panier_edit', {'id': panier.id}) }}" class="btn-dark flex items-center gap-2">
            <i class="fa-solid fa-pen"></i> Modifier
        </a>
        <a href="{{ path('app_panier_index') }}" class="btn-gold flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i> Retour
        </a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Info Card -->
    <div class="lg:col-span-2">
        <div class="card">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-gold-500/10">
                <h2 class="text-xl font-bold text-gold-400">
                    <i class="fa-solid fa-shopping-cart mr-2"></i>
                    Informations du Panier
                </h2>
                <span class="px-4 py-2 font-semibold rounded-full text-sm border {{ panier.statutBadgeClass }}">
                    {{ panier.statutLabel }}
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <div>
                        <label class="text-gold-500/70 text-xs uppercase tracking-widest">Lieu Touristique</label>
                        <p class="text-white text-lg font-semibold mt-1">
                            {% if panier.lieuTouristique %}
                                <a href="{{ path('app_lieu_touristique_show', {'id': panier.lieuTouristique.id}) }}" class="hover:text-gold-400 transition-colors">
                                    {{ panier.lieuTouristique.nom }}
                                </a>
                            {% else %}
                                <span class="text-gray-500">Non spécifié</span>
                            {% endif %}
                        </p>
                    </div>
                    <div>
                        <label class="text-gold-500/70 text-xs uppercase tracking-widest">Type de Service</label>
                        <p class="text-white text-lg font-semibold mt-1">{{ panier.typeService }}</p>
                    </div>
                    <div>
                        <label class="text-gold-500/70 text-xs uppercase tracking-widest">Session ID</label>
                        <p class="text-gray-400 text-sm mt-1 font-mono">{{ panier.sessionId|slice(0, 20) }}...</p>
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="text-gold-500/70 text-xs uppercase tracking-widest">Date de Début</label>
                        <p class="text-white text-lg font-semibold mt-1">
                            <i class="fa-regular fa-calendar mr-2 text-gold-500/50"></i>
                            {{ panier.dateDebut|date('d/m/Y H:i') }}
                        </p>
                    </div>
                    <div>
                        <label class="text-gold-500/70 text-xs uppercase tracking-widest">Date de Fin</label>
                        <p class="text-white text-lg font-semibold mt-1">
                            <i class="fa-regular fa-calendar-check mr-2 text-gold-500/50"></i>
                            {{ panier.dateFin|date('d/m/Y H:i') }}
                        </p>
                    </div>
                    <div>
                        <label class="text-gold-500/70 text-xs uppercase tracking-widest">Durée</label>
                        <p class="text-white text-lg font-semibold mt-1">{{ panier.nbJours }} jour(s)</p>
                    </div>
                </div>
            </div>

            <div class="mt-6 pt-6 border-t border-gold-500/10">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-dark-300/50 rounded-xl p-4 text-center">
                        <p class="text-gold-500/70 text-xs uppercase tracking-widest mb-2">Total Personnes</p>
                        <p class="text-3xl font-black text-white">{{ panier.nbPersonnes }}</p>
                    </div>
                    <div class="bg-dark-300/50 rounded-xl p-4 text-center">
                        <p class="text-gold-500/70 text-xs uppercase tracking-widest mb-2">Adultes</p>
                        <p class="text-3xl font-black text-blue-400">{{ panier.nbAdultes }}</p>
                    </div>
                    <div class="bg-dark-300/50 rounded-xl p-4 text-center">
                        <p class="text-gold-500/70 text-xs uppercase tracking-widest mb-2">Enfants</p>
                        <p class="text-3xl font-black text-purple-400">{{ panier.nbEnfants }}</p>
                    </div>
                    <div class="bg-dark-300/50 rounded-xl p-4 text-center">
                        <p class="text-gold-500/70 text-xs uppercase tracking-widest mb-2">Prix Estimé</p>
                        <p class="text-2xl font-black text-green-400">{{ panier.prixEstime|number_format(2) }} <span class="text-sm">TND</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Side Panel -->
    <div class="space-y-6">
        <!-- Lieu Image -->
        {% if panier.lieuTouristique and panier.lieuTouristique.image %}
        <div class="card p-0 overflow-hidden">
            <img src="{{ asset(panier.lieuTouristique.image) }}" alt="{{ panier.lieuTouristique.nom }}" class="w-full h-48 object-cover">
            <div class="p-4">
                <h3 class="font-bold text-white">{{ panier.lieuTouristique.nom }}</h3>
                <p class="text-gray-400 text-sm">{{ panier.lieuTouristique.ville }}</p>
            </div>
        </div>
        {% endif %}

        <!-- Actions -->
        <div class="card">
            <h3 class="text-lg font-bold text-gold-400 mb-4">Actions</h3>
            <div class="space-y-3">
                <a href="{{ path('app_panier_edit', {'id': panier.id}) }}" class="w-full btn-dark flex items-center justify-center gap-2">
                    <i class="fa-solid fa-pen"></i> Modifier
                </a>
                <form method="post" action="{{ path('app_panier_delete', {'id': panier.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce panier?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ panier.id) }}">
                    <button type="submit" class="w-full bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 hover:border-red-500/40 px-4 py-2.5 rounded-xl transition-all flex items-center justify-center gap-2">
                        <i class="fa-solid fa-trash"></i> Supprimer
                    </button>
                </form>
            </div>
        </div>

        <!-- Metadata -->
        <div class="card">
            <h3 class="text-lg font-bold text-gold-400 mb-4">Métadonnées</h3>
            <div class="space-y-3 text-sm">
                <div class="flex justify-between">
                    <span class="text-gray-400">Créé le</span>
                    <span class="text-white">{{ panier.createdAt|date('d/m/Y H:i') }}</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-400">ID Panier</span>
                    <span class="text-white font-mono">#{{ panier.id }}</span>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
