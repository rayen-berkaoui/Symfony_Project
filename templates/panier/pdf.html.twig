<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
body{font-family:DejaVu Sans,sans-serif;color:#0f172a;margin:0;padding:28px;background:#f8fafc} .hero{background:linear-gradient(135deg,#0f172a,#1e293b);color:#fff;padding:24px;border-radius:20px;margin-bottom:20px}.muted{color:#cbd5e1}.grid{display:table;width:100%;border-spacing:12px 0;margin-bottom:20px}.card{display:table-cell;background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:16px}.label{font-size:11px;text-transform:uppercase;color:#64748b;letter-spacing:.16em}.value{font-size:24px;font-weight:700;margin-top:8px}.table{width:100%;border-collapse:collapse;background:#fff;border-radius:18px;overflow:hidden}.table th{background:#111827;color:#fff;font-size:11px;text-transform:uppercase;letter-spacing:.12em;padding:12px;text-align:left}.table td{padding:12px;border-bottom:1px solid #e5e7eb;font-size:12px}.pill{display:inline-block;padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700}.wait{background:#fef3c7;color:#92400e}.ok{background:#dcfce7;color:#166534}.cancel{background:#fee2e2;color:#991b1b}</style></head><body>
<div class="hero"><div style="font-size:12px;letter-spacing:.22em;text-transform:uppercase">Tabaany</div><h1 style="margin:10px 0 6px;font-size:30px">Rapport paniers clients</h1><div class="muted">Document cohérent avec l'identité du site • généré le {{ generatedAt|date('d/m/Y H:i') }}</div></div>
<div class="grid"><div class="card"><div class="label">Total paniers</div><div class="value">{{ stats.total }}</div></div><div class="card"><div class="label">En attente</div><div class="value">{{ stats.en_attente }}</div></div><div class="card"><div class="label">Confirmés</div><div class="value">{{ stats.confirme }}</div></div><div class="card"><div class="label">Valeur estimée</div><div class="value">{{ stats.total_prix|number_format(2, '.', ' ') }} TND</div></div></div>
<table class="table"><thead><tr><th>ID</th><th>Client</th><th>Service</th><th>Période</th><th>Personnes</th><th>Chambres</th><th>Prix</th><th>Statut</th></tr></thead><tbody>{% for panier in paniers %}<tr><td>#{{ panier.id }}</td><td>{{ panier.utilisateur ? panier.utilisateur.prenom ~ ' ' ~ panier.utilisateur.nom : 'Client indisponible' }}</td><td>{{ panier.displayName }}</td><td>{{ panier.dateDebut|date('d/m/Y H:i') }} → {{ panier.dateFin|date('d/m/Y H:i') }}</td><td>{{ panier.nbPersonnes }}</td><td>{{ panier.nbChambres }}</td><td>{{ panier.prixEstime|number_format(2, '.', ' ') }} TND</td><td><span class="pill {{ panier.statutLabel == 'Confirmé' ? 'ok' : (panier.statutLabel starts with 'En attente' ? 'wait' : 'cancel') }}">{{ panier.statutLabel }}</span></td></tr>{% endfor %}</tbody></table>
</body></html>