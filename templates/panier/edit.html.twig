{% extends 'base.html.twig' %}

{% block title %}Modifier Panier #{{ panier.id }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_panier_index') }}" class="hover:text-gold-400 transition-colors">Paniers</a>
    <i class="fa-solid fa-chevron-right mx-2 text-xs"></i>
    <span>Modifier #{{ panier.id }}</span>
{% endblock %}

{% block body %}
<div class="mb-8">
    <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-yellow-600 mb-2">Modifier le Panier</h1>
    <p class="text-gray-400">Référence: <span class="text-gold-500 font-semibold">#{{ panier.id }}</span></p>
</div>

<div class="card max-w-3xl">
    {{ include('panier/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
</div>
{% endblock %}
