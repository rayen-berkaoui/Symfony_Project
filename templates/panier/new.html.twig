{% extends 'base.html.twig' %}

{% block title %}Nouveau Panier{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_panier_index') }}" class="hover:text-gold-400 transition-colors">Paniers</a>
    <i class="fa-solid fa-chevron-right mx-2 text-xs"></i>
    <span>Nouveau</span>
{% endblock %}

{% block body %}
<div class="mb-8">
    <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-yellow-600 mb-2">Nouveau Panier</h1>
    <p class="text-gray-400">Créez un nouveau panier manuellement.</p>
</div>

<div class="card max-w-3xl">
    {{ include('panier/_form.html.twig', {'button_label': 'Créer le panier'}) }}
</div>
{% endblock %}
