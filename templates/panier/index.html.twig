{% extends 'base.html.twig' %}

{% block title %}Backoffice paniers{% endblock %}

{% block body %}
<div class="space-y-8">
    <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
        <div>
            <p class="text-sm uppercase tracking-[0.35em] text-gold-500/70">Backoffice</p>
            <h1 class="text-4xl font-black text-white">Dashboard paniers clients</h1>
            <p class="mt-2 text-gray-400">Tableau de bord en lecture seule : consultez les paniers clients, leur valeur, leur statut et leur répartition sans pouvoir les modifier.</p>
        </div>
        <div class="flex flex-wrap gap-3">
            <a href="{{ path('app_panier_pdf') }}" class="btn-dark"><i class="fa-solid fa-file-pdf mr-2"></i>PDF</a>
            <a href="{{ path('app_panier_excel') }}" class="btn-dark"><i class="fa-solid fa-file-excel mr-2"></i>Excel</a>
        </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <div class="card"><p class="text-xs uppercase tracking-[0.3em] text-gray-500">Total</p><p class="mt-3 text-4xl font-black text-white">{{ stats.total }}</p></div>
        <div class="card"><p class="text-xs uppercase tracking-[0.3em] text-gray-500">En attente</p><p class="mt-3 text-4xl font-black text-amber-300">{{ stats.en_attente }}</p></div>
        <div class="card"><p class="text-xs uppercase tracking-[0.3em] text-gray-500">Confirmés</p><p class="mt-3 text-4xl font-black text-emerald-300">{{ stats.confirme }}</p></div>
        <div class="card"><p class="text-xs uppercase tracking-[0.3em] text-gray-500">Montant estimé</p><p class="mt-3 text-4xl font-black text-gold-400">{{ stats.total_prix|number_format(2, '.', ' ') }}</p></div>
    </div>

    <div class="grid gap-6 xl:grid-cols-[1.4fr_0.6fr]">
        <div class="card">
            <form class="grid gap-4 lg:grid-cols-4">
                <input type="text" name="search" value="{{ searchQuery }}" placeholder="Client, service, statut, identifiant..." class="rounded-xl border border-white/10 bg-dark-200 px-4 py-3 text-white lg:col-span-2">
                <select name="status" class="rounded-xl border border-white/10 bg-dark-200 px-4 py-3 text-white">
                    <option value="">Tous les statuts</option>
                    <option value="attente" {{ statusFilter == 'attente' ? 'selected' }}>En attente</option>
                    <option value="conf" {{ statusFilter == 'conf' ? 'selected' }}>Confirmé</option>
                    <option value="annul" {{ statusFilter == 'annul' ? 'selected' }}>Annulé</option>
                </select>
                <select name="type" class="rounded-xl border border-white/10 bg-dark-200 px-4 py-3 text-white">
                    <option value="">Tous les types</option>
                    {% for row in typeBreakdown %}
                        <option value="{{ row.type_service }}" {{ typeFilter == row.type_service ? 'selected' }}>{{ row.type_service }}</option>
                    {% endfor %}
                </select>
            </form>

            <div class="mt-6 overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead>
                        <tr class="text-left text-gray-500 uppercase tracking-[0.2em] text-xs border-b border-white/10">
                            <th class="py-3 pr-4">Panier</th>
                            <th class="py-3 pr-4">Client</th>
                            <th class="py-3 pr-4">Service</th>
                            <th class="py-3 pr-4">Période</th>
                            <th class="py-3 pr-4">Prix</th>
                            <th class="py-3 pr-4">Statut</th>
                            <th class="py-3">Consultation</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for panier in paniers %}
                            <tr class="border-b border-white/5 align-top">
                                <td class="py-4 pr-4">
                                    <p class="font-bold text-white">#{{ panier.id }}</p>
                                    <p class="text-xs text-gray-500">{{ panier.serviceTypeLabel }}</p>
                                </td>
                                <td class="py-4 pr-4">
                                    <p class="font-semibold text-white">{{ panier.utilisateur ? (panier.utilisateur.prenom ~ ' ' ~ panier.utilisateur.nom) : 'Client indisponible' }}</p>
                                    <p class="text-xs text-gray-500">{{ panier.utilisateur ? panier.utilisateur.email : '—' }}</p>
                                </td>
                                <td class="py-4 pr-4">
                                    <p class="font-semibold text-white">{{ panier.displayName }}</p>
                                    <p class="text-xs text-gray-500">{{ panier.displayCity ?: 'Ville non renseignée' }}</p>
                                </td>
                                <td class="py-4 pr-4 text-gray-300">
                                    {{ panier.dateDebut|date('d/m/Y H:i') }}<br>
                                    <span class="text-xs text-gray-500">→ {{ panier.dateFin|date('d/m/Y H:i') }}</span>
                                </td>
                                <td class="py-4 pr-4 text-gold-400 font-bold">{{ panier.prixEstime|number_format(2, '.', ' ') }} TND</td>
                                <td class="py-4 pr-4"><span class="rounded-full border px-3 py-1 text-xs font-semibold {{ panier.statutBadgeClass }}">{{ panier.statutLabel }}</span></td>
                                <td class="py-4 flex gap-2">
                                    <a href="{{ path('app_panier_show', {'id': panier.id}) }}" class="btn-dark">Détail</a>
                                    <span class="rounded-2xl border border-white/10 bg-black/10 px-4 py-2 text-xs font-semibold text-gray-400">Lecture seule</span>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="7" class="py-10 text-center text-gray-500">Aucun panier trouvé.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-6">{{ knp_pagination_render(paniers) }}</div>
        </div>

        <div class="space-y-6">
            <div class="card">
                <h2 class="text-xl font-bold text-white">Top clients</h2>
                <div class="mt-4 space-y-4">
                    {% for client in topClients %}
                        <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
                            <p class="font-semibold text-white">{{ client.prenom }} {{ client.nom }}</p>
                            <p class="text-xs text-gray-500">{{ client.email }}</p>
                            <div class="mt-2 flex items-center justify-between text-sm">
                                <span class="text-gray-400">{{ client.panier_count }} panier(s)</span>
                                <span class="text-gold-400 font-bold">{{ client.total_estime|number_format(2, '.', ' ') }} TND</span>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-gray-500">Aucune donnée.</p>
                    {% endfor %}
                </div>
            </div>
            <div class="card">
                <h2 class="text-xl font-bold text-white">Répartition par type</h2>
                <div class="mt-4 space-y-3">
                    {% for row in typeBreakdown %}
                        <div>
                            <div class="mb-1 flex items-center justify-between text-sm"><span class="text-gray-300">{{ row.type_service }}</span><span class="text-white font-semibold">{{ row.total }}</span></div>
                            <div class="h-2 rounded-full bg-black/20"><div class="h-2 rounded-full bg-gold-500" style="width: {{ stats.total ? (row.total / stats.total * 100) : 0 }}%"></div></div>
                        </div>
                    {% else %}
                        <p class="text-gray-500">Aucune donnée.</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
