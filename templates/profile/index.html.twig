{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Tabaany{% endblock %}

{% block body %}
<div class="profile-header">
    <div class="container">
        <a href="{{ path('app_dashboard') }}" class="back-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Retour au dashboard
        </a>
        <h1 class="page-title">Mon Profil</h1>
        <p class="page-subtitle">Gérez vos informations personnelles et vos préférences de voyage</p>
    </div>
</div>

<div class="container profile-container">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="profile-flash profile-flash-{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% if app.user and app.user.needsPhoneUpdate %}
        <div class="profile-flash profile-flash-warning">
            Votre compte Google/GitHub a ete cree avec un numero temporaire. Veuillez saisir votre vrai numero (8 chiffres).
        </div>
    {% endif %}

    <div class="profile-layout-modern">
        <!-- Profile Sidebar -->
        <aside class="profile-sidebar">
            <div class="profile-avatar-section">
                <div class="avatar-circle-large">
                    {% if app.user and app.user.profilePicture %}
                        <img src="{{ app.user.profilePicture }}" alt="Photo de profil">
                    {% else %}
                        <span class="avatar-initials">{{ app.user ? (app.user.nom|slice(0,1) ~ app.user.prenom|slice(0,1)) : 'U' }}</span>
                    {% endif %}
                </div>
                <h2 class="profile-name">{{ app.user ? app.user.nom ~ ' ' ~ app.user.prenom : 'Utilisateur' }}</h2>
                <p class="profile-role">{{ app.user ? app.user.role.nom : 'Touriste' }}</p>
                
                <div class="profile-stats">
                    <div class="stat-box">
                        <span class="stat-value">0</span>
                        <span class="stat-label">Favoris</span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-value">0</span>
                        <span class="stat-label">Voyages</span>
                    </div>
                    <div class="stat-box">
                        <span class="stat-value">0</span>
                        <span class="stat-label">Avis</span>
                    </div>
                </div>
            </div>
            
            <div class="profile-menu">
                <a href="#info" class="menu-item active" data-section="info">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    Informations personnelles
                </a>
                <a href="#security" class="menu-item" data-section="security">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    Sécurité
                </a>
                <a href="#danger" class="menu-item menu-item-danger" data-section="danger">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 9v4m0 4h.01M5 19h14a2 2 0 0 0 1.84-2.75l-7-14a2 2 0 0 0-3.68 0l-7 14A2 2 0 0 0 5 19z"/>
                    </svg>
                    Zone de danger
                </a>
            </div>
        </aside>

        <!-- Profile Main Content -->
        <section class="profile-main">
            <!-- Personal Information Section -->
            <div id="info" class="profile-section">
                <div class="section-header-inline">
                    <div>
                        <h2 class="section-title">Informations personnelles</h2>
                        <p class="muted">Mettez à jour vos informations et votre photo de profil.</p>
                    </div>
                    <span class="badge badge-info">Public</span>
                </div>

                <form id="profile_form" class="form js-validate modern-form" action="{{ path('app_profile') }}" method="post" enctype="multipart/form-data" novalidate>
                    <input type="hidden" name="_token" value="{{ csrf_token('profile_update') }}">
                    
                    <!-- Photo Upload Section -->
                    <div class="form-section">
                        <h3 class="form-section-title">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                <circle cx="8.5" cy="8.5" r="1.5"/>
                                <path d="M21 15l-5-5L5 21"/>
                            </svg>
                            Photo de profil
                        </h3>
                        <div class="upload-zone">
                            <div class="upload-preview">
                                <div class="preview-circle">
                                    {{ app.user ? (app.user.nom|slice(0,1) ~ app.user.prenom|slice(0,1)) : 'U' }}
                                </div>
                            </div>
                            <div class="upload-controls">
                                <input type="file" name="profile_picture" accept="image/*" id="profile_picture" class="file-input">
                                <label for="profile_picture" class="btn ghost">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
                                    </svg>
                                    Choisir une photo
                                </label>
                                <p class="upload-hint">JPG, PNG ou GIF. Max 2MB</p>
                            </div>
                        </div>
                    </div>

                    <!-- Basic Information -->
                    <div class="form-section">
                        <h3 class="form-section-title">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                            Informations de base
                        </h3>
                        <div class="form-grid">
                            <div class="form-row">
                                <label for="profile_nom">Nom</label>
                                <input id="profile_nom" name="nom" type="text" value="{{ app.user ? app.user.nom : '' }}" data-validate="required|alpha|minlength:2|maxlength:100" data-label="Nom" autocomplete="family-name" required>
                            </div>
                            <div class="form-row">
                                <label for="profile_prenom">Prénom</label>
                                <input id="profile_prenom" name="prenom" type="text" value="{{ app.user ? app.user.prenom : '' }}" data-validate="required|alpha|minlength:2|maxlength:100" data-label="Prénom" autocomplete="given-name" required>
                            </div>
                        </div>
                    </div>

                    <!-- Contact Information -->
                    <div class="form-section">
                        <h3 class="form-section-title">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                <path d="M22 6l-10 7L2 6"/>
                            </svg>
                            Contact
                        </h3>
                        <div class="form-row">
                            <label for="profile_email">Email</label>
                            <div class="input-with-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                    <path d="M22 6l-10 7L2 6"/>
                                </svg>
                                <input id="profile_email" name="email" type="email" value="{{ app.user ? app.user.email : '' }}" data-validate="required|email|maxlength:150" data-label="Email" autocomplete="email" inputmode="email" required>
                            </div>
                        </div>
                        <div class="form-row">
                            <label for="profile_phone">Numéro de téléphone</label>
                            <div class="input-with-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                                </svg>
                                <input id="profile_phone" name="num_tel" type="tel" value="{{ app.user and app.user.numTel ? app.user.numTel : '' }}" placeholder="Entrez votre vrai numéro" data-validate="required|phone|minlength:8|maxlength:8" data-label="Numéro de téléphone" autocomplete="tel" inputmode="numeric" pattern="[0-9]{8}" required>
                            </div>
                            <p class="upload-hint">Entrez exactement 8 chiffres.</p>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button class="btn solid btn-large" type="submit">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                                <path d="M17 21v-8H7v8M7 3v5h8"/>
                            </svg>
                            Enregistrer les modifications
                        </button>
                        <a href="{{ path('app_dashboard') }}" class="btn ghost">Annuler</a>
                    </div>
                </form>
            </div>

            <!-- Security Section -->
            <div id="security" class="profile-section" style="display: none;">
                <div class="section-header-inline">
                    <div>
                        <h2 class="section-title">Sécurité</h2>
                        <p class="muted">Gérez votre mot de passe et la sécurité de votre compte</p>
                    </div>
                    <span class="badge badge-preferences">Sécurisé</span>
                </div>

                <div class="security-card">
                    <div class="security-card-header">
                        <div>
                            <h3 class="security-card-title">Double authentification</h3>
                            <p class="muted">Activez la 2FA pour renforcer l'accès à votre compte avec une application d'authentification.</p>
                        </div>
                        <span class="badge {{ app.user and app.user.totpEnabled ? 'badge-success' : 'badge-warning' }}">
                            {{ app.user and app.user.totpEnabled ? 'Activée' : 'Désactivée' }}
                        </span>
                    </div>

                    <form class="form modern-form security-form" action="{{ path('app_profile') }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('profile_update') }}">
                        <div class="form-section security-form-section">
                            <div class="totp-summary">
                                <div class="totp-summary-text">
                                    <strong>{{ app.user and app.user.totpEnabled ? '2FA active' : '2FA desactivee' }}</strong>
                                    <span>Ajoutez une protection supplementaire en confirmant vos connexions via une application 2FA.</span>
                                </div>
                                <div class="totp-summary-actions">
                                    {% if app.user and app.user.totpEnabled %}
                                        <button type="button" class="btn ghost" id="show-2fa-qr">Afficher le QR code</button>
                                        <button type="submit" class="btn ghost" name="totp_action" value="disable">Desactiver</button>
                                    {% else %}
                                        <button type="submit" class="btn solid btn-large" name="totp_action" value="enable">Activer la 2FA</button>
                                    {% endif %}
                                </div>
                            </div>

                            {% if not app.user or not app.user.totpEnabled %}
                                <p class="totp-help">Cliquez sur "Activer la 2FA" pour afficher le QR code de configuration.</p>
                            {% endif %}
                        </div>
                    </form>
                </div>

                <form class="form js-validate modern-form" method="post" novalidate>
                    <div class="form-section">
                        <h3 class="form-section-title">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                            Changer le mot de passe
                        </h3>
                        
                        <div class="form-row">
                            <label for="current_password">Mot de passe actuel</label>
                            <div class="password-field">
                                <input type="password" id="current_password" name="current_password" autocomplete="current-password" data-validate="required|minlength:6" data-label="Mot de passe actuel" required>
                                <button type="button" class="password-toggle" data-target="current_password" aria-label="Afficher le mot de passe">
                                    <svg class="icon-eye" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M12 5c5.2 0 9.2 4.2 10.5 6.7a1 1 0 0 1 0 .6C21.2 14.8 17.2 19 12 19S2.8 14.8 1.5 12.3a1 1 0 0 1 0-.6C2.8 9.2 6.8 5 12 5zm0 2C8 7 4.7 10 3.6 12c1.1 2 4.4 5 8.4 5s7.3-3 8.4-5C19.3 10 16 7 12 7zm0 2.5A2.5 2.5 0 1 1 9.5 12 2.5 2.5 0 0 1 12 9.5z" fill="currentColor" />
                                    </svg>
                                    <svg class="icon-eye-off" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M3.7 4.3a1 1 0 0 1 1.4 0l15 15a1 1 0 0 1-1.4 1.4l-2.3-2.3A10.9 10.9 0 0 1 12 19C6.8 19 2.8 14.8 1.5 12.3a1 1 0 0 1 0-.6 14.2 14.2 0 0 1 4.2-4.9L3.7 5.7a1 1 0 0 1 0-1.4zM12 7c5.2 0 9.2 4.2 10.5 6.7a1 1 0 0 1 0 .6 14.8 14.8 0 0 1-3.4 4.2l-1.5-1.5A12.1 12.1 0 0 0 20.4 12C19.3 10 16 7 12 7a9.3 9.3 0 0 0-2 .2L8.4 5.7A10.8 10.8 0 0 1 12 7zm0 3a2 2 0 0 1 2 2 1.9 1.9 0 0 1-.3 1l-2.7-2.7a1.9 1.9 0 0 1 1-.3zm-2.7 1.3 2.7 2.7a2 2 0 0 1-2.7-2.7z" fill="currentColor" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div class="form-row">
                            <label for="new_password">Nouveau mot de passe</label>
                            <div class="password-field">
                                <input type="password" id="new_password" name="new_password" autocomplete="new-password" data-validate="required|minlength:6" data-label="Nouveau mot de passe" data-password-strength="true" required>
                                <button type="button" class="password-toggle" data-target="new_password" aria-label="Afficher le mot de passe">
                                    <svg class="icon-eye" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M12 5c5.2 0 9.2 4.2 10.5 6.7a1 1 0 0 1 0 .6C21.2 14.8 17.2 19 12 19S2.8 14.8 1.5 12.3a1 1 0 0 1 0-.6C2.8 9.2 6.8 5 12 5zm0 2C8 7 4.7 10 3.6 12c1.1 2 4.4 5 8.4 5s7.3-3 8.4-5C19.3 10 16 7 12 7zm0 2.5A2.5 2.5 0 1 1 9.5 12 2.5 2.5 0 0 1 12 9.5z" fill="currentColor" />
                                    </svg>
                                    <svg class="icon-eye-off" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M3.7 4.3a1 1 0 0 1 1.4 0l15 15a1 1 0 0 1-1.4 1.4l-2.3-2.3A10.9 10.9 0 0 1 12 19C6.8 19 2.8 14.8 1.5 12.3a1 1 0 0 1 0-.6 14.2 14.2 0 0 1 4.2-4.9L3.7 5.7a1 1 0 0 1 0-1.4zM12 7c5.2 0 9.2 4.2 10.5 6.7a1 1 0 0 1 0 .6 14.8 14.8 0 0 1-3.4 4.2l-1.5-1.5A12.1 12.1 0 0 0 20.4 12C19.3 10 16 7 12 7a9.3 9.3 0 0 0-2 .2L8.4 5.7A10.8 10.8 0 0 1 12 7zm0 3a2 2 0 0 1 2 2 1.9 1.9 0 0 1-.3 1l-2.7-2.7a1.9 1.9 0 0 1 1-.3zm-2.7 1.3 2.7 2.7a2 2 0 0 1-2.7-2.7z" fill="currentColor" />
                                    </svg>
                                </button>
                            </div>
                            <div class="password-strength-bar" id="password-strength-new_password">
                                <div class="password-strength-fill"></div>
                            </div>
                            <p class="password-strength-text"></p>
                        </div>

                        <div class="form-row">
                            <label for="confirm_password">Confirmer le nouveau mot de passe</label>
                            <div class="password-field">
                                <input type="password" id="confirm_password" name="confirm_password" autocomplete="new-password" data-validate="required|minlength:6" data-label="Confirmation" required>
                                <button type="button" class="password-toggle" data-target="confirm_password" aria-label="Afficher le mot de passe">
                                    <svg class="icon-eye" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M12 5c5.2 0 9.2 4.2 10.5 6.7a1 1 0 0 1 0 .6C21.2 14.8 17.2 19 12 19S2.8 14.8 1.5 12.3a1 1 0 0 1 0-.6C2.8 9.2 6.8 5 12 5zm0 2C8 7 4.7 10 3.6 12c1.1 2 4.4 5 8.4 5s7.3-3 8.4-5C19.3 10 16 7 12 7zm0 2.5A2.5 2.5 0 1 1 9.5 12 2.5 2.5 0 0 1 12 9.5z" fill="currentColor" />
                                    </svg>
                                    <svg class="icon-eye-off" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M3.7 4.3a1 1 0 0 1 1.4 0l15 15a1 1 0 0 1-1.4 1.4l-2.3-2.3A10.9 10.9 0 0 1 12 19C6.8 19 2.8 14.8 1.5 12.3a1 1 0 0 1 0-.6 14.2 14.2 0 0 1 4.2-4.9L3.7 5.7a1 1 0 0 1 0-1.4zM12 7c5.2 0 9.2 4.2 10.5 6.7a1 1 0 0 1 0 .6 14.8 14.8 0 0 1-3.4 4.2l-1.5-1.5A12.1 12.1 0 0 0 20.4 12C19.3 10 16 7 12 7a9.3 9.3 0 0 0-2 .2L8.4 5.7A10.8 10.8 0 0 1 12 7zm0 3a2 2 0 0 1 2 2 1.9 1.9 0 0 1-.3 1l-2.7-2.7a1.9 1.9 0 0 1 1-.3zm-2.7 1.3 2.7 2.7a2 2 0 0 1-2.7-2.7z" fill="currentColor" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button class="btn solid btn-large" type="submit">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            </svg>
                            Mettre à jour le mot de passe
                        </button>
                    </div>
                </form>
            </div>

            <!-- Danger Zone Section -->
            <div id="danger" class="profile-section" style="display: none;">
                <div class="section-header-inline">
                    <div>
                        <h2 class="section-title text-danger">Zone de danger</h2>
                        <p class="muted">Actions irréversibles sur votre compte</p>
                    </div>
                    <span class="badge badge-danger">Attention</span>
                </div>

                <div class="danger-zone-card">
                    <div class="danger-zone-content">
                        <div>
                            <h3>Supprimer mon compte</h3>
                            <p class="muted">Une fois votre compte supprimé, toutes vos données seront définitivement effacées. Cette action est irréversible.</p>
                        </div>
                        <button type="button" class="btn btn-danger" onclick="confirmDeleteAccount()">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                            </svg>
                            Supprimer mon compte
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

{% if app.user and app.user.totpSecret %}
    <div class="totp-modal-overlay" id="totp-modal" aria-hidden="true">
        <div class="totp-modal" role="dialog" aria-modal="true" aria-labelledby="totp-modal-title">
            <div class="totp-modal-header">
                <div>
                    <h3 id="totp-modal-title">Configurer la double authentification</h3>
                    <p class="muted">Scannez le QR code avec votre application pour activer la protection.</p>
                </div>
                <button type="button" class="totp-modal-close" id="totp-modal-close" aria-label="Fermer">
                    ×
                </button>
            </div>
            <div class="totp-modal-qr" id="totp-modal-qr" data-otpauth="otpauth://totp/{{ ('Tabaany:' ~ app.user.email)|url_encode }}?secret={{ app.user.totpSecret|url_encode }}&issuer={{ 'Tabaany'|url_encode }}&algorithm=SHA1&digits=6&period=30"></div>
            <button type="button" class="btn solid" id="totp-modal-done">J'ai scanne</button>
        </div>
    </div>
{% endif %}

<script src="{{ asset('vendor/qrcodejs/qrcode.min.js') }}"></script>

<script>
// Profile menu navigation
document.addEventListener('DOMContentLoaded', function() {
    const menuItems = document.querySelectorAll('.menu-item');
    const sections = document.querySelectorAll('.profile-section');
    
    menuItems.forEach(item => {
        item.addEventListener('click', function(e) {
            e.preventDefault();
            
            // Remove active class from all menu items
            menuItems.forEach(mi => mi.classList.remove('active'));
            
            // Add active class to clicked item
            this.classList.add('active');
            
            // Hide all sections
            sections.forEach(section => section.style.display = 'none');
            
            // Show target section
            const targetId = this.getAttribute('data-section');
            const targetSection = document.getElementById(targetId);
            if (targetSection) {
                targetSection.style.display = 'block';
            }
        });
    });

        const totpModal = document.getElementById('totp-modal');
        const showTotpButton = document.getElementById('show-2fa-qr');
        const closeTotpButton = document.getElementById('totp-modal-close');
        const doneTotpButton = document.getElementById('totp-modal-done');
        const shouldOpenTotp = new URLSearchParams(window.location.search).get('show_2fa') === '1';

        function openTotpModal() {
            if (!totpModal) {
                return;
            }

            const qrContainer = document.getElementById('totp-modal-qr');
            if (qrContainer) {
                const otpauth = qrContainer.dataset.otpauth;
                if (otpauth && window.QRCode && !qrContainer.dataset.rendered) {
                    qrContainer.innerHTML = '';
                    new QRCode(qrContainer, {
                        text: otpauth,
                        width: 180,
                        height: 180,
                        correctLevel: QRCode.CorrectLevel.M
                    });
                    qrContainer.dataset.rendered = '1';
                } else if (!window.QRCode) {
                    qrContainer.textContent = 'QR code indisponible';
                    qrContainer.classList.add('totp-qr-fallback');
                }
            }

            totpModal.classList.add('show');
            totpModal.setAttribute('aria-hidden', 'false');
        }

        function closeTotpModal() {
            if (!totpModal) {
                return;
            }

            totpModal.classList.remove('show');
            totpModal.setAttribute('aria-hidden', 'true');
        }

        if (showTotpButton) {
            showTotpButton.addEventListener('click', openTotpModal);
        }

        if (closeTotpButton) {
            closeTotpButton.addEventListener('click', closeTotpModal);
        }

        if (doneTotpButton) {
            doneTotpButton.addEventListener('click', closeTotpModal);
        }

        if (totpModal) {
            totpModal.addEventListener('click', function(event) {
                if (event.target === totpModal) {
                    closeTotpModal();
                }
            });
        }

        if (shouldOpenTotp) {
            openTotpModal();
        }
});

// Delete account confirmation with modal
function confirmDeleteAccount() {
    showDeleteModal();
}

function showDeleteModal() {
    const modal = document.createElement('div');
    modal.className = 'delete-modal-overlay';
    modal.innerHTML = `
        <div class="delete-modal">
            <div class="delete-modal-icon">
                <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2">
                    <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
            </div>
            <h2 class="delete-modal-title">Supprimer votre compte ?</h2>
            <p class="delete-modal-text">
                Cette action est <strong>irréversible</strong>. Toutes vos données personnelles, 
                réservations, favoris et historique seront définitivement supprimés.
            </p>
            <p class="delete-modal-warning">
                ⚠️ Vous ne pourrez pas récupérer ces informations une fois le compte supprimé.
            </p>
            <div class="delete-modal-actions">
                <button type="button" class="btn-modal-cancel" onclick="closeDeleteModal()">
                    Annuler
                </button>
                <button type="button" class="btn-modal-delete" onclick="proceedDeleteAccount()">
                    Oui, supprimer définitivement
                </button>
            </div>
        </div>
    `;
    document.body.appendChild(modal);
    
    setTimeout(() => modal.classList.add('show'), 10);
}

function closeDeleteModal() {
    const modal = document.querySelector('.delete-modal-overlay');
    if (modal) {
        modal.classList.remove('show');
        setTimeout(() => modal.remove(), 300);
    }
}

function proceedDeleteAccount() {
    const modal = document.querySelector('.delete-modal');
    if (!modal) return;
    
    modal.innerHTML = `
        <div class="delete-modal-loading">
            <div class="spinner"></div>
            <p>Suppression de votre compte en cours...</p>
        </div>
    `;
    
    const formData = new FormData();
    formData.append('_token', '{{ csrf_token('delete_profile') }}');
    
    fetch('{{ path('app_profile_delete') }}', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            modal.innerHTML = `
                <div class="delete-modal-success">
                    <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
                        <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <h2>Compte supprimé</h2>
                    <p>Votre compte a été supprimé avec succès. Vous allez être redirigé...</p>
                </div>
            `;
            setTimeout(() => {
                window.location.href = data.redirect;
            }, 2000);
        } else {
            throw new Error(data.message || 'Erreur lors de la suppression');
        }
    })
    .catch(error => {
        modal.innerHTML = `
            <div class="delete-modal-error">
                <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <h2>Erreur</h2>
                <p>${error.message}</p>
                <button type="button" class="btn-modal-cancel" onclick="closeDeleteModal()">Fermer</button>
            </div>
        `;
    });
}

// Close modal on outside click
document.addEventListener('click', function(e) {
    if (e.target.classList.contains('delete-modal-overlay')) {
        closeDeleteModal();
    }
});
</script>

