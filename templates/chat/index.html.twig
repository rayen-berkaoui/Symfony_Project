{% extends 'base.html.twig' %}

{% block title %}Salon de discussion — Tabaani Connect{% endblock %}

{% block body %}
<div class="tbn-chat-page">
    {% include '_partials/tbn_topbar.html.twig' with {
        back_href: path('app_home'),
        back_label: '← Retour',
    } %}

    {% for message in app.flashes('success') %}
        <div class="flash flash-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="flash flash-warning">{{ message }}</div>
    {% endfor %}

    <div class="tbn-chat-subbar">
        <div class="tbn-chat-subbar__head">
            <div class="tbn-chat-subbar__title">
                <h1 class="tbn-page-title tbn-page-title--chat">Salon de discussion</h1>
            </div>
            <p class="tbn-chat-subbar__online">Estimation d’activité : <strong id="tbn-chat-online-count">{{ online_count }}</strong></p>
        </div>
        <div class="tbn-chat-subbar__identity">
            {% if sessionUserKey %}
                <p class="tbn-chat-session-line">
                    <span class="tbn-chat-session-line__label">Pseudo actif :</span>
                    <strong class="chat-username tbn-chat-session-line__name" style="--chat-user-hue: {{ sessionUserKey|chat_user_hue }};">{{ sessionUserKey }}</strong>
                </p>
                <form method="post" action="{{ path('app_chat_leave') }}" class="tbn-inline-form tbn-chat-leave-form" novalidate>
                    <input type="hidden" name="_token" value="{{ csrf_token('chat_leave') }}">
                    <button type="submit" class="btn btn-ghost btn--sm">Quitter le salon</button>
                </form>
            {% else %}
                <p class="tbn-muted tbn-chat-pseudo-hint">
                    <a href="{{ path('app_home') }}">Définissez votre pseudo depuis l’accueil</a> pour participer à la discussion.
                </p>
            {% endif %}
        </div>
    </div>

    <div class="tbn-chat-main">
        <div id="chat-log" class="chat-log tbn-chat-log" aria-label="Messages du salon">
            {% for m in messages|reverse %}
                {% set is_broadcast = m.userKey == constant('App\\Chat\\ChatAdmin::BROADCAST_USER_KEY') %}
                <div class="chat-line{% if is_broadcast %} chat-line--admin{% endif %}" data-msg-id="{{ m.id }}">
                    <div class="chat-meta">
                        {% if is_broadcast %}
                            <strong>{{ m.userKey }}</strong>
                        {% else %}
                            <strong class="chat-username" style="--chat-user-hue: {{ m.userKey|chat_user_hue }};">{{ m.userKey }}</strong>
                        {% endif %}
                        — {{ m.createdAt ? m.createdAt|date('d/m/Y H:i') : '—' }}
                    </div>
                    <div class="chat-body">{{ m.content }}</div>
                </div>
            {% else %}
                <p class="tbn-muted tbn-chat-empty">Le salon est encore silencieux — lancez la conversation.</p>
            {% endfor %}
        </div>
        <aside class="tbn-chat-sidebar" aria-label="Estimation de présence">
            <div class="tbn-chat-sidebar__head">
                <span aria-hidden="true">👥</span>
                <span>Activité</span>
            </div>
            <p class="tbn-chat-sidebar__body tbn-muted">Présence active : <strong class="tbn-gold-text" id="tbn-chat-online-count-side">{{ online_count }}</strong> utilisateur(s).</p>
        </aside>
    </div>

    <footer class="tbn-chat-footer">
        {{ form_start(form, { attr: { class: 'tbn-chat-footer__form', novalidate: 'novalidate' } }) }}
            {% if not sessionUserKey %}
                <p class="tbn-chat-footer__hint">Identifiez-vous sur <a href="{{ path('app_home') }}">l’accueil</a> pour écrire dans le salon.</p>
            {% endif %}
            <div class="tbn-chat-footer__row">
                {{ form_widget(form.content, {
                    attr: { class: 'tbn-input tbn-chat-footer__input', placeholder: sessionUserKey ? 'Saisissez votre message…' : 'Pseudo requis — via l’accueil', rows: 2 }
                        |merge(sessionUserKey ? {} : { readonly: 'readonly' }),
                }) }}
                <button type="submit" class="btn btn-primary"{% if not sessionUserKey %} disabled{% endif %}>Envoyer le message</button>
            </div>
            {{ form_errors(form.content) }}
        {{ form_end(form) }}
    </footer>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    (function () {
        var pingUrl = {{ path('app_chat_presence_ping')|json_encode|raw }};
        var topCount = document.getElementById('tbn-chat-online-count');
        var sideCount = document.getElementById('tbn-chat-online-count-side');

        function applyOnlineCount(n) {
            if (topCount) {
                topCount.textContent = String(n);
            }
            if (sideCount) {
                sideCount.textContent = String(n);
            }
        }

        function ping() {
            fetch(pingUrl, {
                method: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin'
            }).then(function (r) {
                if (!r.ok) {
                    return null;
                }
                return r.json();
            }).then(function (data) {
                if (!data || typeof data.online === 'undefined') {
                    return;
                }
                var n = parseInt(String(data.online), 10);
                if (!isNaN(n) && n >= 0) {
                    applyOnlineCount(n);
                }
            }).catch(function () {});
        }

        ping();
        window.setInterval(ping, 25000);
    })();
    </script>
{% endblock %}
