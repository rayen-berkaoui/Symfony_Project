{% extends 'base.html.twig' %}

{% block title %}Catégorie: {{ categorie.nomCategorie }}{% endblock %}

{% block body %}
<div class="mb-6 flex justify-between items-center">
    <h1 class="text-3xl font-bold text-gold-500 drop-shadow-[0_2px_10px_rgba(255,215,0,0.3)]">
        <i class="fa-solid fa-tags mr-2"></i> {{ categorie.nomCategorie }}
    </h1>
    <div class="space-x-3 flex">
        <a href="{{ path('app_categorie_index') }}" class="btn-dark"><i class="fa-solid fa-arrow-left mr-2"></i>Retour</a>
        <a href="{{ path('app_categorie_edit', {'id': categorie.id}) }}" class="btn-gold"><i class="fa-solid fa-pen mr-2"></i>Modifier</a>
    </div>
</div>

<div class="card max-w-2xl">
    <table class="w-full text-left">
        <tbody>
            <tr class="border-b border-white/5">
                <th class="py-3 text-gray-400 w-1/3">ID</th>
                <td class="font-medium text-gold-400">#{{ categorie.id }}</td>
            </tr>
            <tr class="border-b border-white/5">
                <th class="py-3 text-gray-400">Nom</th>
                <td class="font-bold text-lg">{{ categorie.nomCategorie }}</td>
            </tr>
            <tr class="border-b border-white/5">
                <th class="py-3 text-gray-400">Date de Création</th>
                <td><i class="fa-regular fa-calendar mr-2 text-gray-500"></i>{{ categorie.dateCreation ? categorie.dateCreation|date('Y-m-d') : '-' }}</td>
            </tr>
            <tr>
                <th class="py-3 text-gray-400 align-top">Description</th>
                <td class="pt-3 pb-6 text-gray-300">{{ categorie.description ?: 'Aucune description.' }}</td>
            </tr>
        </tbody>
    </table>
    
    <div class="mt-4 pt-4 border-t border-red-500/20 text-right">
        {{ include('categorie/_delete_form.html.twig') }}
    </div>
</div>

{% if lieux is defined and lieux|length > 0 %}
<div class="mt-10 max-w-4xl animate-[fade-in_0.5s_ease-out]">
    <h2 class="text-2xl font-bold text-white mb-6 border-b border-white/10 pb-2 flex items-center">
        <i class="fa-solid fa-map-location-dot text-gold-500 mr-3"></i> Lieux associés ({{ lieux|length }})
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {% for lieu in lieux %}
            <a href="{{ path('app_lieu_touristique_show', {'id': lieu.id}) }}" class="bg-dark-200 border border-white/5 hover:border-gold-500/30 rounded-xl p-5 flex flex-col group transition-all duration-300 hover:-translate-y-1 shadow-[0_4px_15px_rgba(0,0,0,0.2)] hover:shadow-[0_4px_20px_rgba(255,215,0,0.1)]">
                <div class="flex justify-between items-start mb-3">
                    <h3 class="text-lg font-black text-white group-hover:text-gold-400 transition-colors leading-tight">{{ lieu.nom }}</h3>
                    {% if lieu.statut %}
                        <span class="w-2.5 h-2.5 rounded-full bg-green-500 mt-1.5 shadow-[0_0_8px_rgba(34,197,94,0.8)] flex-shrink-0"></span>
                    {% else %}
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500 mt-1.5 shadow-[0_0_8px_rgba(239,68,68,0.8)] flex-shrink-0"></span>
                    {% endif %}
                </div>
                <p class="text-gray-400 text-sm mb-4 font-medium">
                    <i class="fa-solid fa-location-dot mr-1 text-gold-500/50"></i> {{ lieu.ville ?: '-' }}
                </p>
                <div class="mt-auto pt-4 border-t border-white/5 flex items-center justify-between">
                    <span class="font-black text-white">{{ lieu.prix }} <span class="text-gold-500 text-xs text-medium">DT</span></span>
                    <i class="fa-solid fa-arrow-right text-gray-500 group-hover:text-gold-400 transition-colors -translate-x-2 opacity-0 group-hover:opacity-100 group-hover:translate-x-0"></i>
                </div>
            </a>
        {% endfor %}
    </div>
</div>
{% endif %}
{% endblock %}
