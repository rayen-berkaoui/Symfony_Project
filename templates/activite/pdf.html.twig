<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Fiche Activite</title>
    <style>
        body {
            font-family: Helvetica, Arial, sans-serif;
            color: #111111;
            margin: 24px;
            font-size: 13px;
            line-height: 1.5;
        }
        h1 {
            margin: 0 0 6px;
            font-size: 24px;
        }
        .subtitle {
            color: #555;
            margin-bottom: 16px;
            font-size: 12px;
        }
        .section {
            border: 1px solid #e4e4e4;
            border-radius: 8px;
            margin-bottom: 14px;
            padding: 12px;
        }
        .section h2 {
            margin: 0 0 10px;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #666;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        td {
            padding: 6px 0;
            vertical-align: top;
            border-bottom: 1px dashed #ececec;
        }
        td.label {
            width: 30%;
            color: #666;
            font-weight: bold;
        }
        .footer {
            margin-top: 14px;
            font-size: 11px;
            color: #666;
        }
    </style>
</head>
<body>
    <h1>{{ activite.nomActivite ?: 'Activite' }}</h1>
    <p class="subtitle">Fiche exportee le {{ "now"|date("d/m/Y H:i") }}</p>

    <div class="section">
        <h2>Informations generales</h2>
        <table>
            <tr><td class="label">Categorie</td><td>{{ activite.categorie ?: 'Non renseigne' }}</td></tr>
            <tr><td class="label">Statut</td><td>{{ activite.statut ?: 'Non renseigne' }}</td></tr>
            <tr><td class="label">Niveau</td><td>{{ activite.niveau ?: 'Non renseigne' }}</td></tr>
            <tr><td class="label">Prix</td><td>{{ activite.prix ?: 'Non renseigne' }} {{ activite.devise ?: '' }}</td></tr>
            <tr><td class="label">Etablissement</td><td>{{ activite.etablissement ? activite.etablissement.nom : 'Non renseigne' }}</td></tr>
        </table>
    </div>

    <div class="section">
        <h2>Description</h2>
        <p>{{ activite.description ?: 'Aucune description fournie.' }}</p>
    </div>

    <p class="footer">Document genere automatiquement.</p>
</body>
</html>
