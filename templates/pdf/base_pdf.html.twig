<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <style>
        @page { margin: 48pt 40pt 56pt 40pt; }
        * { box-sizing: border-box; }
        body {
            font-family: DejaVu Sans, Helvetica, Arial, sans-serif;
            font-size: 10.5pt;
            line-height: 1.45;
            color: #1a1a24;
        }
        .pdf-header {
            border-bottom: 3pt solid #c9a227;
            padding-bottom: 10pt;
            margin-bottom: 16pt;
        }
        .pdf-header__row { width: 100%; }
        .pdf-header__brand { vertical-align: top; }
        .pdf-header__meta { vertical-align: top; text-align: right; font-size: 8.5pt; color: #555; }
        .pdf-mark {
            display: inline-block;
            width: 42pt;
            height: 42pt;
            border-radius: 10pt;
            background: #252a3a;
            color: #f5d76e;
            font-weight: 700;
            font-size: 14pt;
            text-align: center;
            line-height: 42pt;
            letter-spacing: -0.5pt;
        }
        .pdf-title-block { padding-left: 10pt; }
        .pdf-site { font-size: 16pt; font-weight: 700; color: #111; letter-spacing: 0.02em; }
        .pdf-tagline { font-size: 9pt; color: #666; margin-top: 2pt; }
        .pdf-doc-title { font-size: 13pt; font-weight: 700; margin: 14pt 0 6pt; color: #222; }
        .pdf-source {
            font-size: 8.5pt;
            color: #444;
            border: 1pt solid #e2e2ea;
            padding: 6pt 8pt;
            background: #fafafa;
            margin-bottom: 12pt;
            word-break: break-all;
        }
        .pdf-kpi-table { width: 100%; border-collapse: collapse; margin: 10pt 0; }
        .pdf-kpi-table th, .pdf-kpi-table td {
            border: 0.75pt solid #d8d8e0;
            padding: 6pt 8pt;
            text-align: left;
        }
        .pdf-kpi-table th { background: #f4f4f8; font-size: 9pt; }
        .pdf-data-table { width: 100%; border-collapse: collapse; margin-top: 8pt; font-size: 9pt; }
        .pdf-data-table th, .pdf-data-table td {
            border: 0.6pt solid #ccc;
            padding: 5pt 6pt;
            vertical-align: top;
        }
        .pdf-data-table th { background: #eeeef4; text-align: left; }
        .pdf-muted { color: #666; font-size: 8.5pt; }
        .pdf-block { margin-bottom: 10pt; page-break-inside: avoid; }
        tr { page-break-inside: avoid; }
        .pdf-footer-note {
            margin-top: 18pt;
            font-size: 8pt;
            color: #777;
            border-top: 0.5pt solid #ddd;
            padding-top: 8pt;
        }
    </style>
    {% block pdf_extra_styles %}{% endblock %}
</head>
<body>
    <header class="pdf-header">
        <table class="pdf-header__row" width="100%">
            <tr>
                <td class="pdf-header__brand" width="52pt">
                    {% if pdf_logo_data_uri is defined and pdf_logo_data_uri %}
                        <img src="{{ pdf_logo_data_uri }}" alt="" width="42" height="42" style="border-radius:8pt;">
                    {% else %}
                        <span class="pdf-mark">TC</span>
                    {% endif %}
                </td>
                <td class="pdf-header__brand">
                    <div class="pdf-title-block">
                        <div class="pdf-site">{{ pdf_site_name }}</div>
                        <div class="pdf-tagline">{{ pdf_site_tagline }}</div>
                    </div>
                </td>
                <td class="pdf-header__meta" width="38%">
                    Document généré le<br>
                    <strong>{{ pdf_generated_at|date('d/m/Y à H:i') }}</strong>
                    {% if pdf_admin_user is defined and pdf_admin_user %}
                        <br>Émis par : {{ pdf_admin_user }}
                    {% endif %}
                </td>
            </tr>
        </table>
    </header>

    {% block pdf_body %}{% endblock %}

    <p class="pdf-footer-note">
        Ce fichier est un extrait officiel au format PDF pour {{ pdf_site_name }}.
        Les graphiques interactifs du tableau de bord web ne sont pas reproduits ici : seules les données chiffrées et listes exportées sont incluses.
    </p>
</body>
</html>
