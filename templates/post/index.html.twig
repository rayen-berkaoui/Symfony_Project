{% extends 'base.html.twig' %}

{% block title %}Espace publications — Tabaani Connect{% endblock %}

{% block body %}
<div class="connect-wrap connect-wrap--feed">
    {% include '_partials/tbn_topbar.html.twig' with {
        back_href: path('app_home'),
        back_label: '← Retour',
        primary_href: path('app_post_new'),
        primary_label: '+ Nouvelle publication',
    } %}

    {% for message in app.flashes('success') %}
        <div class="flash flash-success">{{ message }}</div>
    {% endfor %}

    <header class="tbn-feed-head">
        <p class="tbn-kicker">Fil d’actualité</p>
        <div class="tbn-feed-head__row">
            <h1 class="tbn-page-title tbn-page-title--feed">Espace publications</h1>
            <p class="tbn-feed-head__stat" aria-live="polite">{{ total }} publication{% if total > 1 %}s{% endif %}</p>
        </div>
    </header>

    <form method="get" action="{{ path('app_post_index') }}" class="tbn-filter-bar" aria-label="Filtrer les publications" data-turbo="false">
        <div class="tbn-filter-bar__grid">
            <div class="tbn-field tbn-field--grow">
                <label class="tbn-field__label" for="filter-q">Recherche</label>
                <div class="tbn-input-shell">
                    <span class="tbn-input-shell__icon tbn-input-shell__icon--search" aria-hidden="true">
                        <svg class="tbn-input-shell__svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
                            <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.5"/>
                            <path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    </span>
                    <input id="filter-q" type="search" name="q" value="{{ filter_q }}" placeholder="Texte…" class="tbn-input tbn-input--in-shell" enterkeyhint="search">
                </div>
            </div>
            <div class="tbn-field tbn-field--grow">
                <label class="tbn-field__label" for="filter-hashtag">Hashtag(s)</label>
                <div class="tbn-input-shell">
                    <span class="tbn-input-shell__icon tbn-input-shell__icon--hash" aria-hidden="true">
                        <svg class="tbn-input-shell__svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
                            <path d="M4 9h16M4 15h16M10 3L8 21M16 3L14 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                    <input id="filter-hashtag" type="text" name="hashtag" value="{{ filter_hashtag }}" placeholder="sport , art or musique ..." autocomplete="off" class="tbn-input tbn-input--in-shell" title="Un hashtag par recherche (avec ou sans #). Plusieurs : séparer par virgule, ou, or." inputmode="search">
                </div>
            </div>
            <div class="tbn-field tbn-field--date">
                <label class="tbn-field__label" for="filter-df">Du</label>
                <input id="filter-df" type="date" name="date_from" value="{{ filter_date_from }}" class="tbn-input tbn-input--date" autocomplete="off">
            </div>
            <div class="tbn-field tbn-field--date">
                <label class="tbn-field__label" for="filter-dt">Au</label>
                <input id="filter-dt" type="date" name="date_to" value="{{ filter_date_to }}" class="tbn-input tbn-input--date" autocomplete="off">
            </div>
        </div>
        <div class="tbn-filter-bar__actions">
            <input type="hidden" name="per_page" value="{{ per_page }}">
            <button type="submit" class="btn btn-primary">Filtrer</button>
            <a href="{{ path('app_post_index', { per_page: per_page }) }}" class="btn btn-ghost">Effacer</a>
        </div>
    </form>

    {% if posts is empty %}
        <div class="tbn-empty-state" role="status">
            {% if filters_active %}
                <div class="tbn-empty-state__icon" aria-hidden="true">
                    <svg class="tbn-svg-icon tbn-svg-icon--muted" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M20 20l-3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </div>
                <h2 class="tbn-empty-state__title">Aucun résultat</h2>
                <p class="tbn-empty-state__text">Modifiez les critères ou réinitialisez les filtres.</p>
                <a href="{{ path('app_post_index', { per_page: per_page }) }}" class="btn btn-primary">Réinitialiser les filtres</a>
            {% else %}
                <div class="tbn-empty-state__icon" aria-hidden="true">
                    <svg class="tbn-svg-icon tbn-svg-icon--muted" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 6h12M8 12h12M8 18h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="3" y="4" width="3" height="16" rx="1" stroke="currentColor" stroke-width="1.5"/></svg>
                </div>
                <h2 class="tbn-empty-state__title">Aucune publication</h2>
                <p class="tbn-empty-state__text">Soyez le premier à publier sur Tabaani Connect.</p>
                <a href="{{ path('app_post_new') }}" class="btn btn-primary">Créer une publication</a>
            {% endif %}
        </div>
    {% else %}
        <div class="tbn-feed-list">
        {% for post in posts %}
            <article class="post-card post-card--feed">
                <header class="post-card__head">
                    <span class="tbn-post-badge">Post #{{ post.id }}</span>
                    <time class="post-card__time" datetime="{{ post.createdAt ? post.createdAt|date('c') : '' }}">
                        {{ post.createdAt ? post.createdAt|date('d/m/Y — H:i') : '—' }}
                    </time>
                </header>
                <a href="{{ path('app_post_show', { id: post.id }) }}" class="post-card__link post-card__body">
                    <p class="post-excerpt" dir="auto">{{ post.content|length > 280 ? post.content|slice(0, 280) ~ '…' : post.content }}</p>
                </a>
                <footer class="post-card__stats" aria-label="Statistiques">
                    <div class="post-card__stats-inner">
                        <span class="tbn-stat-pill tbn-stat-pill--like"><span class="tbn-stat-pill__icon" aria-hidden="true">👍</span> {{ post_likes[post.id]|default(0) }}</span>
                        <span class="tbn-stat-pill tbn-stat-pill--dislike"><span class="tbn-stat-pill__icon" aria-hidden="true">👎</span> {{ post_dislikes[post.id]|default(0) }}</span>
                        <span class="tbn-stat-pill tbn-stat-pill--comment"><span class="tbn-stat-pill__icon" aria-hidden="true">💬</span> {{ post_comment_counts[post.id]|default(0) }}</span>
                        <span class="tbn-stat-pill tbn-stat-pill--share"><span class="tbn-stat-pill__icon" aria-hidden="true">🔗</span> {{ post_share_counts[post.id]|default(0) }}</span>
                    </div>
                </footer>
            </article>
        {% endfor %}
        </div>

        <footer class="tbn-pagination" aria-label="Pagination des publications">
            <div class="tbn-pagination__cell tbn-pagination__cell--info">
                <p class="tbn-pagination__info">
                    <span class="tbn-pagination__info-label">Affichage</span>
                    <span class="tbn-pagination__info-range">{{ display_from }} – {{ display_to }}</span>
                    <span class="tbn-pagination__info-sep">sur</span>
                    <span class="tbn-pagination__info-total">{{ total }}</span>
                </p>
            </div>
            <div class="tbn-pagination__cell tbn-pagination__cell--per">
                <form method="get" action="{{ path('app_post_index') }}" class="tbn-pagination__per-form" data-turbo="false">
                    {% for k, v in filter_params %}
                        <input type="hidden" name="{{ k }}" value="{{ v }}">
                    {% endfor %}
                    <input type="hidden" name="page" value="1">
                    <label class="tbn-pagination__per-label" for="per-page">Par page</label>
                    <div class="tbn-pagination__select-wrap">
                        <select id="per-page" name="per_page" class="tbn-pagination__select" aria-label="Nombre d’éléments par page" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()">
                            {% for n in [5, 10, 20, 50] %}
                                <option value="{{ n }}"{% if per_page == n %} selected{% endif %}>{{ n }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </form>
            </div>
            <nav class="tbn-pagination__cell tbn-pagination__cell--nav" aria-label="Pages">
                {% if page > 1 %}
                    <a class="tbn-pagination__btn tbn-pagination__btn--prev" href="{{ path('app_post_index', filter_params|merge({ page: page - 1, per_page: per_page })) }}">Précédent</a>
                {% else %}
                    <span class="tbn-pagination__btn tbn-pagination__btn--prev is-disabled">Précédent</span>
                {% endif %}
                <span class="tbn-pagination__page-indicator"><span class="tbn-pagination__page-label">Page</span> <strong>{{ page }}</strong><span class="tbn-pagination__page-slash">/</span>{{ total_pages }}</span>
                {% if page < total_pages %}
                    <a class="tbn-pagination__btn tbn-pagination__btn--next" href="{{ path('app_post_index', filter_params|merge({ page: page + 1, per_page: per_page })) }}">Suivant</a>
                {% else %}
                    <span class="tbn-pagination__btn tbn-pagination__btn--next is-disabled">Suivant</span>
                {% endif %}
            </nav>
        </footer>
    {% endif %}
</div>
{% endblock %}
