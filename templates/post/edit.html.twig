{% extends 'base.html.twig' %}

{% block title %}Modifier #{{ post.id }} — Tabaani Connect{% endblock %}

{% block body %}
<div class="connect-wrap connect-wrap--form">
    {% include '_partials/tbn_topbar.html.twig' with {
        back_href: path('app_post_show', { id: post.id }),
        back_label: '← Retour',
        primary_href: path('app_post_new'),
        primary_label: '+ Nouvelle publication',
    } %}

    <header class="tbn-feed-head tbn-feed-head__row">
        <div>
            <p class="tbn-kicker">Édition</p>
            <h1 class="tbn-page-title">Modifier la publication #{{ post.id }}</h1>
        </div>
        {% if viewer_is_author %}
            <a href="{{ path('app_post_export_pdf', { id: post.id }) }}" class="btn btn-ghost">Exporter PDF</a>
        {% endif %}
    </header>
    {% include 'post/_form.html.twig' with {
        submit_label: 'Mettre à jour',
        cancel_path: path('app_post_show', { id: post.id }),
        post: post,
    } %}
</div>
{% endblock %}
