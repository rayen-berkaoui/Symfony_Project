{% extends 'base.html.twig' %}

{% block title %}Nouvelle publication — Tabaani Connect{% endblock %}

{% block body %}
<div class="connect-wrap connect-wrap--form">
    {% include '_partials/tbn_topbar.html.twig' with {
        back_href: path('app_post_index'),
        back_label: '← Retour',
        primary_href: path('app_post_new'),
        primary_label: '+ Nouvelle publication',
    } %}

    <header class="tbn-feed-head">
        <p class="tbn-kicker">Publication</p>
        <h1 class="tbn-page-title">Nouvelle publication</h1>
    </header>
    {% include 'post/_form.html.twig' with {
        submit_label: 'Créer',
        cancel_path: path('app_post_index'),
        post: post,
    } %}
</div>
{% endblock %}
