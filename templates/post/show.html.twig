{% extends 'base.html.twig' %}

{% block title %}Publication n°{{ post.id }} — Tabaani Connect{% endblock %}

{% block head_extra %}
    {% set og_desc = post.content|striptags|replace({"\n": ' ', "\r": ' ', "\t": ' '})|trim %}
    {% if og_desc|length > 200 %}
        {% set og_desc = og_desc|slice(0, 200) ~ '…' %}
    {% endif %}
    <meta name="description" content="{{ og_desc|e('html_attr') }}">
    <meta property="og:type" content="article">
    <meta property="og:title" content="{{ ('Publication n°' ~ post.id ~ ' — Tabaani Connect')|e('html_attr') }}">
    <meta property="og:description" content="{{ og_desc|e('html_attr') }}">
    <meta property="og:url" content="{{ postPublicUrl|e('html_attr') }}">
    {% set first_img = post.images|first %}
    {% if first_img %}
        {% set p0 = first_img.path %}
        {% set og_img = (p0 starts with 'http://' or p0 starts with 'https://') ? p0 : absolute_url(asset(p0|trim('/'))) %}
        <meta property="og:image" content="{{ og_img|e('html_attr') }}">
    {% endif %}
    <meta name="twitter:card" content="{{ first_img ? 'summary_large_image' : 'summary' }}">
{% endblock %}

{% block body %}
<main class="connect-wrap connect-wrap--detail" id="publication-detail" lang="fr">
    {% include '_partials/tbn_topbar.html.twig' with {
        back_href: path('app_post_index'),
        back_label: '← Publications',
        primary_href: path('app_post_new'),
        primary_label: '+ Nouvelle publication',
    } %}

    {% for message in app.flashes('success') %}
        <div class="flash flash-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="flash flash-warning">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('danger') %}
        <div class="flash flash-danger">{{ message }}</div>
    {% endfor %}

    <header class="tbn-detail-head" aria-labelledby="publication-detail-title">
        <div class="tbn-detail-head__titles">
            <p class="tbn-kicker">Fiche · n°{{ post.id }}</p>
            <h1 class="tbn-page-title tbn-page-title--detail" id="publication-detail-title">Vue de la publication</h1>
            <p class="tbn-detail-lead tbn-muted">Contenu, médias, partage et fil de discussion — vue complète de la fiche.</p>
        </div>
        <div class="tbn-detail-head__actions" role="toolbar" aria-label="Actions éditoriales">
            {% if viewer_is_author %}
                <a href="{{ path('app_post_export_pdf', { id: post.id }) }}" class="btn btn-ghost">Exporter PDF</a>
            {% endif %}
            <a href="{{ path('app_post_edit', { id: post.id }) }}" class="btn btn-primary">Modifier</a>
            <form method="post" action="{{ path('app_post_delete', { id: post.id }) }}" class="tbn-inline-form" novalidate data-tbn-confirm="Supprimer cette publication ?">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                <button type="submit" class="btn btn-danger">Supprimer</button>
            </form>
        </div>
    </header>

    <div class="tbn-detail-body">
    <article class="post-card post-card--detail" aria-labelledby="publication-content-heading">
        <h2 class="sr-only" id="publication-content-heading">Corps de la publication</h2>
        <header class="post-card__head">
            <span class="tbn-post-badge">Post #{{ post.id }}</span>
            <time class="post-card__time" datetime="{{ post.createdAt ? post.createdAt|date('c') : '' }}">
                {{ post.createdAt ? post.createdAt|date('d/m/Y — H:i') : '—' }}
                {% if post.updatedAt %}<span class="tbn-muted"> · mis à jour {{ post.updatedAt|date('d/m/Y H:i') }}</span>{% endif %}
            </time>
        </header>
        <div class="post-card__body">
        {% if post_summary %}
            <div class="tbn-post-summary">
                <strong>Synthèse automatique —</strong> {{ post_summary }}
            </div>
        {% endif %}
        <div class="tbn-post-body content-box content-box--in-card" dir="auto">{{ post.content }}</div>

        {% if post.images|length > 0 or post.videoPath %}
            <p class="tbn-detail-media-edit">
                <a href="{{ path('app_post_edit', { id: post.id }) }}" class="btn btn-ghost btn--sm">Éditer texte et médias</a>
            </p>
        {% endif %}

        {% if post.images|length > 0 %}
            <figure class="tbn-media-block tbn-media-block--gallery">
                <figcaption class="tbn-media-label">Galerie — {{ post.images|length }} visuel(s)</figcaption>
                <div class="tbn-post-gallery">
                    {% for postImage in post.images %}
                        {% set p = postImage.path %}
                        {% set img_http = p starts with 'http://' or p starts with 'https://' %}
                        {% set img_src = img_http ? p : asset(p|trim('/')) %}
                        <div class="tbn-post-gallery__item">
                            <div class="tbn-media-frame tbn-post-gallery__frame">
                                <img class="tbn-media-img" src="{{ img_src }}" alt="Visuel {{ loop.index }} — publication n°{{ post.id }}" loading="lazy">
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <details class="tbn-media-path">
                    <summary>Chemins fichiers (mode technique)</summary>
                    {% for postImage in post.images %}
                        <code class="tbn-media-path__code">{{ postImage.path }}</code>
                    {% endfor %}
                </details>
            </figure>
        {% endif %}

        {% if post.videoPath %}
            {% set vid_http = post.videoPath starts with 'http://' or post.videoPath starts with 'https://' %}
            <figure class="tbn-media-block">
                <figcaption class="tbn-media-label">Vidéo</figcaption>
                {% if vid_http %}
                    <div class="tbn-media-frame tbn-media-frame--video">
                        <a href="{{ post.videoPath }}" class="btn btn-primary btn--sm" target="_blank" rel="noopener noreferrer">Lire la vidéo</a>
                    </div>
                {% else %}
                    <div class="tbn-media-frame tbn-media-frame--video">
                        <video class="tbn-media-video" controls playsinline preload="metadata" src="{{ asset(post.videoPath|trim('/')) }}"></video>
                    </div>
                {% endif %}
                <details class="tbn-media-path">
                    <summary>Chemin fichier (mode technique)</summary>
                    <code class="tbn-media-path__code">{{ post.videoPath }}</code>
                </details>
            </figure>
        {% endif %}
        </div>
    </article>

    <section class="tbn-detail-engage" aria-label="Réactions et accès au partage">
    <div class="post-reactions post-reactions--center" aria-label="Vote et partage">
        {% if sessionUserKey %}
            <form method="post" action="{{ path('app_post_react', { id: post.id }) }}" class="tbn-inline-form" novalidate>
                <input type="hidden" name="_token" value="{{ csrf_token('react_post' ~ post.id) }}">
                <input type="hidden" name="type" value="like">
                <button type="submit" class="btn btn-react btn-react--like{% if userPostReaction == 'LIKE' %} is-like-active{% endif %}">👍 {{ postLikesCount }}</button>
            </form>
            <form method="post" action="{{ path('app_post_react', { id: post.id }) }}" class="tbn-inline-form" novalidate>
                <input type="hidden" name="_token" value="{{ csrf_token('react_post' ~ post.id) }}">
                <input type="hidden" name="type" value="dislike">
                <button type="submit" class="btn btn-react btn-react--dislike{% if userPostReaction == 'DISLIKE' %} is-dislike-active{% endif %}">👎 {{ postDislikesCount }}</button>
            </form>
        {% else %}
            <p class="tbn-reactions-gate tbn-muted">Pour indiquer votre avis (👍 / 👎), <a href="{{ path('app_home') }}">définissez d’abord votre pseudo sur l’accueil</a>.</p>
        {% endif %}
        <a class="btn btn-react btn-react--share" href="#tbn-share-section">Partager <span class="tbn-share-count">({{ shareCount }})</span></a>
    </div>
    </section>

    <section class="comments-section comments-section--premium">
        <h2 class="tbn-comments-title">Fil de discussion</h2>

        {% if sessionUserKey %}
            <p class="tbn-comment-session-line tbn-muted">Vous participez sous le pseudo <strong class="chat-username" style="--chat-user-hue: {{ sessionUserKey|chat_user_hue }};">{{ sessionUserKey }}</strong></p>
            <div class="tbn-comment-composer tbn-comment-composer--premium">
                {{ form_start(commentForm, { attr: { class: 'comment-form comment-form--premium', novalidate: 'novalidate' } }) }}
                    {{ form_errors(commentForm.content) }}
                    <div class="tbn-comment-premium__grid tbn-comment-premium__grid--identified">
                        <div class="tbn-comment-premium__message">
                            {{ form_widget(commentForm.content, {
                                attr: {
                                    placeholder: 'Rédigez votre commentaire…',
                                    rows: 3,
                                    class: 'tbn-input tbn-comment-premium__textarea',
                                },
                            }) }}
                        </div>
                        <div class="tbn-comment-premium__submit">
                            <button type="submit" class="btn btn-primary tbn-comment-premium__btn">Publier le commentaire</button>
                        </div>
                    </div>
                {{ form_end(commentForm) }}
            </div>
        {% else %}
            <div class="tbn-comment-gate" role="status">
                Commentaires et réactions sont réservés aux visiteurs identifiés — <a href="{{ path('app_home') }}">choisissez votre pseudo sur l’accueil</a>.
            </div>
        {% endif %}

        {% for comment in post.comments %}
            <article class="comment-card">
                <p class="comment-meta">
                    <span class="comment-card__user" aria-hidden="true">👤</span>
                    <strong class="chat-username" style="--chat-user-hue: {{ comment.userKey|chat_user_hue }};">{{ comment.userKey }}</strong>
                    — {{ comment.createdAt ? comment.createdAt|date('d/m/Y H:i') : '—' }}
                    {% if comment.updatedAt %}<span class="tbn-muted"> · édité {{ comment.updatedAt|date('d/m/Y H:i') }}</span>{% endif %}
                </p>
                <p class="comment-body">{{ comment.content }}</p>
                <div class="comment-actions" aria-label="Actions sur ce commentaire">
                    {% if sessionUserKey %}
                        <form method="post" action="{{ path('app_comment_react', { id: post.id, commentId: comment.id }) }}" class="tbn-inline-form" novalidate>
                            <input type="hidden" name="_token" value="{{ csrf_token('react_comment' ~ comment.id) }}">
                            <input type="hidden" name="type" value="like">
                            <button type="submit" class="btn btn-react btn--sm btn-react--like{% if commentReactions[comment.id] ?? null == 'LIKE' %} is-like-active{% endif %}">👍 {{ comment.likesCount }}</button>
                        </form>
                        <form method="post" action="{{ path('app_comment_react', { id: post.id, commentId: comment.id }) }}" class="tbn-inline-form" novalidate>
                            <input type="hidden" name="_token" value="{{ csrf_token('react_comment' ~ comment.id) }}">
                            <input type="hidden" name="type" value="dislike">
                            <button type="submit" class="btn btn-react btn--sm btn-react--dislike{% if commentReactions[comment.id] ?? null == 'DISLIKE' %} is-dislike-active{% endif %}">👎 {{ comment.dislikesCount }}</button>
                        </form>
                    {% endif %}
                    {% if sessionUserKey and sessionUserKey == comment.userKey %}
                        <a href="{{ path('app_comment_edit', { id: post.id, commentId: comment.id }) }}" class="btn btn-ghost btn--sm">Modifier</a>
                        <form method="post" action="{{ path('app_comment_delete', { id: post.id, commentId: comment.id }) }}" class="tbn-inline-form" novalidate data-tbn-confirm="Supprimer ce commentaire ?">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_comment' ~ comment.id) }}">
                            <button type="submit" class="btn btn-danger btn--sm">Supprimer</button>
                        </form>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <p class="tbn-comments-empty" role="status">Aucun échange pour le moment — soyez le premier à réagir.</p>
        {% endfor %}
    </section>

    <section class="share-section share-section--v2" id="tbn-share-section" aria-labelledby="tbn-share-heading">
        <div class="tbn-share-panel tbn-share-panel--v2">
            <header class="tbn-share-panel__head tbn-share-panel__head--v2">
                <p class="tbn-kicker tbn-kicker--share-v2">Diffusion</p>
                <h2 class="tbn-share-heading-v2" id="tbn-share-heading">Partager cette publication</h2>
                <p class="share-hint share-hint--v2">Envoyez le lien public par le canal de votre choix. Les partages peuvent être enregistrés lorsque vous utilisez un pseudo défini sur l’accueil.</p>
            </header>

            {% include '_partials/tbn_share_bar.html.twig' with {
                waText: waText,
                postPublicUrl: postPublicUrl,
                sharePlain: sharePlain,
                mailSubject: mailSubject,
                mailBody: mailBody,
            } only %}

            <footer class="tbn-share-panel__footer tbn-share-panel__footer--v2">
                <p class="share-copy-feedback" id="share-copy-feedback" role="status" aria-live="polite"></p>
                {% if recentShares is not empty %}
                    <aside class="tbn-share-recent" aria-label="Historique récent des partages">
                        <h3 class="tbn-share-recent-title">Derniers partages enregistrés</h3>
                        <ul class="share-list share-list--v2">
                            {% for s in recentShares %}
                                <li>
                                    <span class="tbn-share-recent__who">{{ s.userKey }}</span>
                                    <span class="tbn-share-recent__meta">{{ s.platform }} · {{ s.createdAt ? s.createdAt|date('d/m/Y H:i') : '—' }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </aside>
                {% endif %}
            </footer>
        </div>
    </section>
    </div>
</main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    (function () {
        var shareLogUrl = {{ path('app_post_share_log', { id: post.id })|json_encode|raw }};
        var csrf = {{ csrf_token('share_log' ~ post.id)|json_encode|raw }};
        var publicUrl = {{ postPublicUrl|json_encode|raw }};
        var shareTitle = {{ ('Publication n°' ~ post.id ~ ' — Tabaani Connect')|json_encode|raw }};
        var shareText = {{ sharePlain|json_encode|raw }};

        function logShare(platform) {
            var fd = new FormData();
            fd.append('_token', csrf);
            fd.append('platform', platform);
            fetch(shareLogUrl, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' }).catch(function () {});
        }

        document.querySelectorAll('a[data-log-share]').forEach(function (el) {
            el.addEventListener('click', function () {
                var p = el.getAttribute('data-log-share');
                if (p) {
                    logShare(p);
                }
            });
        });

        var copyBtn = document.getElementById('share-copy-btn');
        var copyFb = document.getElementById('share-copy-feedback');
        if (copyBtn && copyFb) {
            copyBtn.addEventListener('click', function () {
                if (!navigator.clipboard || !navigator.clipboard.writeText) {
                    copyFb.textContent = 'Copie indisponible — sélectionnez l’URL dans la barre d’adresse.';
                    return;
                }
                navigator.clipboard.writeText(publicUrl).then(function () {
                    logShare('copie_lien');
                    copyFb.textContent = 'Lien copié dans le presse-papiers.';
                    setTimeout(function () { copyFb.textContent = ''; }, 3500);
                }).catch(function () {
                    copyFb.textContent = 'Copie impossible — copiez l’URL manuellement.';
                });
            });
        }

        var nativeBtn = document.getElementById('share-native-btn');
        if (nativeBtn && navigator.share) {
            nativeBtn.hidden = false;
            nativeBtn.addEventListener('click', function () {
                navigator.share({ title: shareTitle, text: shareText, url: publicUrl }).then(function () {
                    logShare('native');
                }).catch(function () {});
            });
        }
    })();
    </script>
{% endblock %}
