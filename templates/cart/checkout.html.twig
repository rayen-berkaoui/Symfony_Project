{% extends 'base.html.twig' %}

{% block title %}Finaliser la Commande{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_cart_index') }}" class="hover:text-gold-400 transition-colors">Mon Panier</a>
    <i class="fa-solid fa-chevron-right mx-2 text-xs"></i>
    <span>Paiement</span>
{% endblock %}

{% block body %}
<div class="mb-8">
    <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-600 mb-2">Finaliser la Commande</h1>
    <p class="text-gray-400">Choisissez votre mode de paiement pour confirmer vos réservations.</p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Order Summary -->
    <div class="lg:col-span-2 space-y-6">
        <div class="card">
            <h2 class="text-xl font-bold text-gold-400 mb-6 pb-4 border-b border-gold-500/10">
                <i class="fa-solid fa-list-check mr-2"></i>
                Récapitulatif de la Commande
            </h2>

            <div class="space-y-4">
                {% for item in cartItems %}
                    {% set lieu = item.lieuTouristique %}
                    <div class="flex items-center gap-4 p-4 bg-dark-300/50 rounded-xl border border-white/5">
                        <div class="w-20 h-20 rounded-lg overflow-hidden bg-black/50 flex-shrink-0">
                            {% if lieu and lieu.image %}
                                <img src="{{ asset(lieu.image) }}" alt="{{ lieu.nom }}" class="w-full h-full object-cover">
                            {% else %}
                                <div class="w-full h-full flex items-center justify-center text-gray-600">
                                    <i class="fa-solid fa-image"></i>
                                </div>
                            {% endif %}
                        </div>
                        <div class="flex-1">
                            <h3 class="font-bold text-white">{{ lieu ? lieu.nom : 'Lieu' }}</h3>
                            <p class="text-gray-400 text-sm">
                                {{ item.dateDebut|date('d/m/Y') }} - {{ item.dateFin|date('d/m/Y') }}
                                • {{ item.nbPersonnes }} pers.
                            </p>
                        </div>
                        <div class="text-right">
                            <p class="text-green-400 font-bold">{{ item.prixEstime|number_format(2) }} TND</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Payment Form -->
        <div class="card">
            <h2 class="text-xl font-bold text-gold-400 mb-6 pb-4 border-b border-gold-500/10">
                <i class="fa-solid fa-credit-card mr-2"></i>
                Mode de Paiement
            </h2>

            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {% for child in form.modePaiement %}
                        <label class="relative cursor-pointer">
                            {{ form_widget(child, {'attr': {'class': 'peer sr-only'}}) }}
                            <div class="p-6 rounded-xl border-2 border-dark-100 bg-dark-300/50 peer-checked:border-green-500 peer-checked:bg-green-500/10 transition-all hover:border-gold-500/50">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-full bg-dark-200 flex items-center justify-center text-gold-500">
                                        {% if child.vars.value == 'Carte' %}
                                            <i class="fa-solid fa-credit-card text-xl"></i>
                                        {% elseif child.vars.value == 'Espèces' %}
                                            <i class="fa-solid fa-money-bill-wave text-xl"></i>
                                        {% elseif child.vars.value == 'Virement' %}
                                            <i class="fa-solid fa-building-columns text-xl"></i>
                                        {% else %}
                                            <i class="fa-brands fa-paypal text-xl"></i>
                                        {% endif %}
                                    </div>
                                    <div>
                                        <p class="font-bold text-white">{{ child.vars.label }}</p>
                                        <p class="text-gray-400 text-sm">
                                            {% if child.vars.value == 'Carte' %}
                                                Paiement sécurisé par carte
                                            {% elseif child.vars.value == 'Espèces' %}
                                                Payer sur place
                                            {% elseif child.vars.value == 'Virement' %}
                                                Transfert bancaire
                                            {% else %}
                                                Paiement via PayPal
                                            {% endif %}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </label>
                    {% endfor %}
                </div>
                {{ form_errors(form.modePaiement) }}

                <div class="flex justify-between items-center pt-6 border-t border-gold-500/10">
                    <a href="{{ path('app_cart_index') }}" class="btn-dark">
                        <i class="fa-solid fa-arrow-left mr-2"></i> Retour au Panier
                    </a>
                    <button type="submit" class="bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-400 hover:to-emerald-500 text-white px-8 py-4 rounded-xl transition-all duration-300 shadow-lg hover:shadow-green-500/30 font-bold text-lg flex items-center gap-3">
                        <i class="fa-solid fa-check"></i>
                        Confirmer la Commande
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    <!-- Sidebar Summary -->
    <div class="space-y-6">
        <div class="card bg-gradient-to-br from-dark-300 to-black border-green-500/20 sticky top-28">
            <h3 class="text-lg font-bold text-green-400 mb-6">Résumé</h3>

            <div class="space-y-4 mb-6">
                <div class="flex justify-between">
                    <span class="text-gray-400">Articles</span>
                    <span class="text-white font-semibold">{{ cartItems|length }}</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-400">Sous-total</span>
                    <span class="text-white font-semibold">{{ totalPrice|number_format(2) }} TND</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-400">Frais</span>
                    <span class="text-green-400 font-semibold">Gratuit</span>
                </div>
            </div>

            <div class="border-t border-gold-500/10 pt-4">
                <div class="flex justify-between items-center">
                    <span class="text-gold-500 font-bold uppercase tracking-widest">Total</span>
                    <span class="text-3xl font-black text-white">{{ totalPrice|number_format(2) }} <span class="text-sm text-gold-500">TND</span></span>
                </div>
            </div>

            <div class="mt-6 p-4 bg-green-500/10 rounded-xl border border-green-500/20">
                <div class="flex items-start gap-3">
                    <i class="fa-solid fa-shield-check text-green-400 text-xl mt-1"></i>
                    <div>
                        <p class="text-green-400 font-semibold text-sm">Paiement sécurisé</p>
                        <p class="text-gray-400 text-xs">Vos informations sont protégées.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
