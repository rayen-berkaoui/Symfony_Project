{% extends 'base.html.twig' %}

{% block title %}Optimiseur d'itineraire{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_cart_index') }}" class="text-gold-400 hover:text-gold-300 transition-colors">Mon Panier</a>
    <span class="mx-2 text-gray-600">/</span>
    <span>Optimiseur d'itineraire</span>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin=""
    >
{% endblock %}

{% block body %}
{% set totals = plan.totals %}
<div class="mb-8 flex flex-col xl:flex-row xl:items-start justify-between gap-4">
    <div>
        <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-500 mb-2">Smart Day Trip Planner</h1>
        <p class="text-gray-400 text-lg">Itineraire optimise sur vos lieux du panier avec contraintes de temps et budget.</p>
    </div>

    <div class="flex items-center gap-2">
        <a href="{{ path('app_cart_index') }}" class="btn-dark inline-flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i>
            Retour au panier
        </a>
        {% if plan.map.googleMapsUrl %}
            <a href="{{ plan.map.googleMapsUrl }}" target="_blank" rel="noopener" class="btn-gold inline-flex items-center gap-2">
                <i class="fa-solid fa-route"></i>
                Ouvrir dans Google Maps
            </a>
        {% endif %}
    </div>
</div>

<div class="card mb-8 border-blue-500/20">
    <form method="get" action="{{ path('app_cart_itinerary') }}" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-6 gap-4 items-end">
        <div class="xl:col-span-2">
            <label for="start-address-input">Point de depart (adresse ou "lat,lng")</label>
            <div class="relative">
                <i class="fa-solid fa-location-dot absolute left-3 top-1/2 -translate-y-1/2 text-gray-500"></i>
                <input
                    id="start-address-input"
                    type="text"
                    name="start_address"
                    value="{{ startAddress|default('') }}"
                    placeholder="Ex: 34.74056,10.76028 ou Tunis centre"
                    class="w-full pl-9"
                >
                <input id="start-lat-input" type="hidden" name="start_lat" value="{{ startLat is not null ? startLat : '' }}">
                <input id="start-lng-input" type="hidden" name="start_lng" value="{{ startLng is not null ? startLng : '' }}">
            </div>
        </div>

        <div>
            <label for="transport-mode-input">Mode transport</label>
            <select id="transport-mode-input" name="transport_mode" class="w-full">
                <option value="car" {% if transportMode == 'car' %}selected{% endif %}>Voiture</option>
                <option value="walk" {% if transportMode == 'walk' %}selected{% endif %}>Marche</option>
            </select>
        </div>

        <div>
            <label for="max-budget-input">Budget max (TND)</label>
            <input id="max-budget-input" type="number" step="0.01" min="0" name="max_budget" value="{{ maxBudget is not null ? maxBudget : '' }}" placeholder="Optionnel" class="w-full">
        </div>

        <div>
            <label for="max-duration-input">Duree max (heures)</label>
            <input id="max-duration-input" type="number" step="0.5" min="1" max="16" name="max_duration_hours" value="{{ maxDurationHours is not null ? maxDurationHours : '' }}" placeholder="Optionnel" class="w-full">
        </div>

        <div class="flex gap-2">
            <button type="button" id="use-my-position-btn" class="btn-dark flex-1 inline-flex items-center justify-center gap-2 whitespace-nowrap">
                <i class="fa-solid fa-location-crosshairs"></i>
                Ma position
            </button>
            <button type="submit" class="btn-gold flex-1 inline-flex items-center justify-center gap-2 whitespace-nowrap">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                Optimiser
            </button>
        </div>
    </form>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-8">
    <div class="card border-blue-500/20">
        <p class="text-xs uppercase tracking-widest text-blue-300/80 mb-1">Etapes retenues</p>
        <p class="text-3xl font-black text-white">{{ totals.selectedCount }}</p>
    </div>
    <div class="card border-cyan-500/20">
        <p class="text-xs uppercase tracking-widest text-cyan-300/80 mb-1">Distance totale</p>
        <p class="text-3xl font-black text-white">{{ totals.distanceKm|number_format(2) }} <span class="text-sm">km</span></p>
    </div>
    <div class="card border-gold-500/20">
        <p class="text-xs uppercase tracking-widest text-gold-400/80 mb-1">Duree estimee</p>
        <p class="text-3xl font-black text-white">{{ (totals.durationMinutes / 60)|round(1, 'common') }} <span class="text-sm">h</span></p>
    </div>
    <div class="card border-green-500/20">
        <p class="text-xs uppercase tracking-widest text-green-400/80 mb-1">Budget cumule</p>
        <p class="text-3xl font-black text-white">{{ totals.budget|number_format(2) }} <span class="text-sm">TND</span></p>
    </div>
</div>

<div class="grid grid-cols-1 xl:grid-cols-5 gap-6">
    <div class="xl:col-span-3 space-y-6">
        <div class="card border-white/10">
            <h2 class="text-xl font-bold text-white mb-4">Ordre optimise des visites</h2>

            {% if plan.selectedStops is empty %}
                <p class="text-gray-400">Aucune etape compatible avec les contraintes actuelles.</p>
            {% else %}
                <div class="space-y-4">
                    {% for stop in plan.selectedStops %}
                        {% set isFirst = stop.step == 1 %}
                        <div class="p-4 rounded-xl border border-white/10 bg-dark-200/50">
                            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3">
                                <div>
                                    <p class="text-xs uppercase tracking-widest text-gold-400/80 mb-1">Etape {{ stop.step }}</p>
                                    <h3 class="text-lg font-bold text-white">{{ stop.name }}</h3>
                                    {% if stop.ville %}
                                        <p class="text-sm text-gray-400"><i class="fa-solid fa-location-dot mr-1"></i>{{ stop.ville }}</p>
                                    {% endif %}
                                </div>
                                <div class="text-left md:text-right">
                                    <p class="text-green-400 font-bold">{{ stop.cumulativeBudget|number_format(2) }} TND</p>
                                    <p class="text-xs text-gray-400">Budget cumule</p>
                                </div>
                            </div>

                            <div class="mt-3 grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
                                <div class="bg-dark-300/70 rounded-lg p-2 border border-white/5">
                                    <p class="text-gray-500 text-xs uppercase">Distance segment</p>
                                    <p class="text-white font-semibold">{{ stop.distanceFromPreviousKm|number_format(2) }} km</p>
                                </div>
                                <div class="bg-dark-300/70 rounded-lg p-2 border border-white/5">
                                    <p class="text-gray-500 text-xs uppercase">Trajet segment</p>
                                    <p class="text-white font-semibold">{{ stop.travelMinutesFromPrevious }} min</p>
                                </div>
                                <div class="bg-dark-300/70 rounded-lg p-2 border border-white/5">
                                    <p class="text-gray-500 text-xs uppercase">Distance cumulee</p>
                                    <p class="text-white font-semibold">{{ stop.cumulativeDistanceKm|number_format(2) }} km</p>
                                </div>
                                <div class="bg-dark-300/70 rounded-lg p-2 border border-white/5">
                                    <p class="text-gray-500 text-xs uppercase">Temps cumule</p>
                                    <p class="text-white font-semibold">{{ (stop.cumulativeDurationMinutes / 60)|round(1, 'common') }} h</p>
                                </div>
                            </div>

                            {% if isFirst and plan.startPoint %}
                                <p class="mt-2 text-xs text-blue-300/90">Depart depuis: {{ plan.startPoint.label|default('Point de depart') }}</p>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {% if plan.droppedByConstraints is not empty or unplannableItems is not empty %}
            <div class="card border-yellow-500/20">
                <h2 class="text-xl font-bold text-white mb-4">Elements non integres</h2>
                <div class="space-y-3">
                    {% for dropped in plan.droppedByConstraints %}
                        <div class="p-3 rounded-lg bg-yellow-500/5 border border-yellow-500/20">
                            <p class="text-yellow-200 font-semibold">{{ dropped.name }}</p>
                            <p class="text-yellow-300/80 text-sm">Raison: {{ dropped.reason }}{% if dropped.estimatedPrice is defined %} - {{ dropped.estimatedPrice|number_format(2) }} TND{% endif %}</p>
                        </div>
                    {% endfor %}
                    {% for item in unplannableItems %}
                        <div class="p-3 rounded-lg bg-red-500/5 border border-red-500/20">
                            <p class="text-red-200 font-semibold">{{ item.label }}</p>
                            <p class="text-red-300/80 text-sm">{{ item.reason }}</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>

    <div class="xl:col-span-2 space-y-6">
        <div class="card border-white/10">
            <h2 class="text-xl font-bold text-white mb-4">Carte de l'itineraire</h2>
            <div id="itinerary-map" class="h-[520px] rounded-xl border border-white/10 overflow-hidden" data-points='{{ plan.map.points|json_encode|e('html_attr') }}'></div>
        </div>

        {% if plan.map.googleMapsUrl %}
            <div class="card border-blue-500/20">
                <p class="text-sm text-gray-300 mb-3">Ouvrez l'itineraire dans l'application Google Maps pour la navigation en temps reel.</p>
                <a href="{{ plan.map.googleMapsUrl }}" target="_blank" rel="noopener" class="btn-gold w-full text-center inline-flex items-center justify-center gap-2">
                    <i class="fa-brands fa-google"></i>
                    Lancer l'itineraire
                </a>
            </div>
        {% endif %}
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
    const geocodeAddress = async (address) => {
        const query = encodeURIComponent(address);
        const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${query}`);
        if (!response.ok) {
            throw new Error('GEOCODE_FAILED');
        }

        const data = await response.json();
        if (!Array.isArray(data) || data.length === 0) {
            throw new Error('ADDRESS_NOT_FOUND');
        }

        return {
            lat: Number.parseFloat(data[0].lat),
            lng: Number.parseFloat(data[0].lon),
        };
    };

    const parseCoordinates = (value) => {
        const trimmed = (value || '').trim();
        if (!trimmed) {
            return null;
        }

        const patterns = [
            /^([+-]?\d+(?:[.,]\d+)?)\s*[,;]\s*([+-]?\d+(?:[.,]\d+)?)$/,
            /^([+-]?\d+(?:[.,]\d+)?)\s+([+-]?\d+(?:[.,]\d+)?)$/,
        ];

        for (const pattern of patterns) {
            const match = trimmed.match(pattern);
            if (!match) {
                continue;
            }

            const lat = Number.parseFloat(match[1].replace(',', '.'));
            const lng = Number.parseFloat(match[2].replace(',', '.'));
            if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
                continue;
            }

            if (lat < -90 || lat > 90 || lng < -180 || lng > 180) {
                continue;
            }

            return { lat, lng };
        }

        return null;
    };

    const initItineraryForm = () => {
        const form = document.querySelector('form[action="{{ path('app_cart_itinerary') }}"]');
        const useMyPositionBtn = document.getElementById('use-my-position-btn');
        const addressInput = document.getElementById('start-address-input');
        const latInput = document.getElementById('start-lat-input');
        const lngInput = document.getElementById('start-lng-input');

        if (!form || !useMyPositionBtn || !addressInput || !latInput || !lngInput) {
            return;
        }

        if (form.dataset.boundPlanner === '1') {
            return;
        }
        form.dataset.boundPlanner = '1';

        addressInput.addEventListener('input', () => {
            latInput.value = '';
            lngInput.value = '';
        });

        useMyPositionBtn.addEventListener('click', () => {
            if (!('geolocation' in navigator)) {
                window.alert('La geolocalisation n\'est pas disponible sur ce navigateur.');
                return;
            }

            useMyPositionBtn.disabled = true;
            const originalHtml = useMyPositionBtn.innerHTML;
            useMyPositionBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Position...';

            navigator.geolocation.getCurrentPosition(
                (position) => {
                    latInput.value = position.coords.latitude.toFixed(6);
                    lngInput.value = position.coords.longitude.toFixed(6);
                    if (!addressInput.value.trim()) {
                        addressInput.value = 'Ma position actuelle';
                    }
                    if (typeof form.requestSubmit === 'function') {
                        form.requestSubmit();
                    } else {
                        form.submit();
                    }
                },
                () => {
                    useMyPositionBtn.disabled = false;
                    useMyPositionBtn.innerHTML = originalHtml;
                    window.alert('Impossible de recuperer votre position. Verifiez les permissions GPS.');
                },
                { enableHighAccuracy: true, timeout: 10000 }
            );
        });

        form.addEventListener('submit', async (event) => {
            if (form.dataset.geoSubmitted === '1') {
                form.dataset.geoSubmitted = '0';
                return;
            }

            const address = addressInput.value.trim();
            const hasCoordinates = latInput.value.trim() !== '' && lngInput.value.trim() !== '';

            if (address === '' || hasCoordinates) {
                return;
            }

            const directCoordinates = parseCoordinates(address);
            if (directCoordinates) {
                event.preventDefault();
                latInput.value = directCoordinates.lat.toFixed(6);
                lngInput.value = directCoordinates.lng.toFixed(6);
                form.dataset.geoSubmitted = '1';
                form.submit();
                return;
            }

            event.preventDefault();
            try {
                const coords = await geocodeAddress(address);
                latInput.value = coords.lat.toFixed(6);
                lngInput.value = coords.lng.toFixed(6);
                form.dataset.geoSubmitted = '1';
                form.submit();
            } catch {
                window.alert('Adresse introuvable. Merci de verifier la saisie.');
            }
        });
    };

    const initItineraryMap = () => {
        const mapElement = document.getElementById('itinerary-map');
        if (!mapElement) {
            return;
        }

        let points = [];
        try {
            points = JSON.parse(mapElement.dataset.points || '[]');
        } catch {
            points = [];
        }

        if (!Array.isArray(points) || points.length === 0 || typeof L === 'undefined') {
            mapElement.innerHTML = '<div class="h-full w-full flex items-center justify-center text-gray-400">Aucun point a afficher sur la carte.</div>';
            return;
        }

        if (mapElement.dataset.mapReady === '1') {
            return;
        }
        mapElement.dataset.mapReady = '1';

        const firstPoint = points[0];
        const map = L.map(mapElement).setView([firstPoint.latitude, firstPoint.longitude], 8);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        const latLngs = [];

        points.forEach((point) => {
            const latLng = [point.latitude, point.longitude];
            latLngs.push(latLng);

            const markerColor = point.kind === 'start' ? '#3B82F6' : '#22C55E';
            const marker = L.circleMarker(latLng, {
                radius: point.kind === 'start' ? 9 : 7,
                color: markerColor,
                fillColor: markerColor,
                fillOpacity: 0.9,
                weight: 2,
            }).addTo(map);

            marker.bindPopup(`<strong>${point.label || 'Etape'}</strong>`);
        });

        if (latLngs.length >= 2) {
            L.polyline(latLngs, {
                color: '#FFD700',
                weight: 4,
                opacity: 0.85,
                dashArray: '8 6',
            }).addTo(map);
        }

        map.fitBounds(latLngs, { padding: [30, 30] });
    };

    document.addEventListener('turbo:load', initItineraryForm);
    document.addEventListener('DOMContentLoaded', initItineraryForm);
    document.addEventListener('turbo:load', initItineraryMap);
    document.addEventListener('DOMContentLoaded', initItineraryMap);

    initItineraryForm();
    initItineraryMap();
</script>
{% endblock %}
