{% extends 'base.html.twig' %}

{% block title %}Ajouter au Panier - {{ etablissement.nom }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_etablissement_index') }}" class="hover:text-gold-400 transition-colors">Établissements</a>
    <i class="fa-solid fa-chevron-right mx-2 text-xs"></i>
    <a href="{{ path('app_etablissement_show', {'idEtablissement': etablissement.idEtablissement}) }}" class="hover:text-gold-400 transition-colors">{{ etablissement.nom }}</a>
    <i class="fa-solid fa-chevron-right mx-2 text-xs"></i>
    <span>Ajouter au Panier</span>
{% endblock %}

{% block body %}
<div class="mb-8">
    <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-600 mb-2">Ajouter au Panier</h1>
    <p class="text-gray-400">Configurez votre visite pour <span class="text-gold-500 font-semibold">{{ etablissement.nom }}</span></p>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Info -->
    <div class="card p-0 overflow-hidden">
        <div class="w-full h-64 bg-dark-300 flex items-center justify-center">
            <i class="fa-solid fa-image text-4xl text-gray-600"></i>
        </div>
        <div class="p-6">
            <h2 class="text-2xl font-bold text-white mb-2">{{ etablissement.nom }}</h2>
            <div class="text-xl text-green-400 font-bold mb-4">
                {# Etablissement gammes dont have a single price, so default #}
                {% if etablissement.gammePrix %}
                    {{ etablissement.gammePrix }}
                {% else %}
                    Sur devis
                {% endif %}
            </div>
            <p class="text-gray-400 mb-6">{{ etablissement.description|striptags }}</p>
        </div>
    </div>

    <!-- Form -->
    <div class="card bg-dark-300 rounded-xl p-8">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit" class="mt-6 w-full btn-primary py-3 rounded-lg font-bold text-lg flex justify-center items-center gap-2">
                <i class="fa-solid fa-cart-plus"></i> Confirmer l'ajout
            </button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
