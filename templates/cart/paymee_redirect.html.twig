{% extends 'base_front.html.twig' %}

{% block title %}Paiement Paymee{% endblock %}

{% block body %}
<section class="mx-auto max-w-3xl px-4 py-16">
    <div class="rounded-3xl border border-white/10 bg-dark-300/85 p-8 text-center shadow-luxury">
        <p class="text-sm uppercase tracking-[0.3em] text-gold-500/70">Paiement sécurisé</p>
        <h1 class="mt-3 text-4xl font-black text-white">Ouvrez Paymee puis revenez ici</h1>
        <p class="mt-4 text-gray-300">Le paiement ne vous enverra plus automatiquement vers vos réservations. Après avoir terminé sur Paymee, revenez sur cette page puis cliquez sur le bouton de vérification.</p>
        <div class="mt-6 rounded-2xl border px-4 py-3 {{ sandboxEnabled ? 'border-sky-500/20 bg-sky-500/10 text-sky-200' : 'border-emerald-500/20 bg-emerald-500/10 text-emerald-200' }}">
            {{ sandboxEnabled ? 'Mode sandbox actif' : 'Mode production actif' }} • Référence {{ orderId }}
        </div>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a id="paymee-open" href="{{ paymentUrl }}" target="_blank" rel="noopener" class="rounded-2xl bg-gold-500 px-6 py-4 font-bold text-black transition hover:bg-gold-400">Ouvrir Paymee</a>
            <button id="paymee-check" type="button" class="rounded-2xl border border-emerald-500/30 bg-emerald-500/10 px-6 py-4 font-semibold text-emerald-200">J'ai terminé, vérifier le paiement</button>
            <a href="{{ path('app_cart_index') }}" class="rounded-2xl border border-white/10 bg-black/20 px-6 py-4 font-semibold text-white">Retour panier</a>
        </div>
        <p id="paymee-status" class="mt-6 text-sm text-gray-400">Sandbox Paymee : téléphone 11111111 • mot de passe 11111111. Après paiement, revenez ici et cliquez sur “J'ai terminé, vérifier le paiement”.</p>
    </div>
</section>
<script>
(() => {
    const checkBtn = document.getElementById('paymee-check');
    const statusEl = document.getElementById('paymee-status');

    const checkStatus = async () => {
        statusEl.textContent = 'Vérification du paiement en cours...';
        try {
            const response = await fetch({{ path('app_cart_paymee_status')|json_encode|raw }}, {headers: {'X-Requested-With': 'XMLHttpRequest'}});
            const data = await response.json();
            if (data.success && data.redirect) {
                statusEl.textContent = 'Paiement confirmé. Vous pouvez maintenant consulter vos réservations.';
                window.location.href = data.redirect;
                return;
            }
            statusEl.textContent = 'Paiement non confirmé pour le moment. Si vous venez de payer, attendez quelques secondes puis réessayez.';
        } catch (e) {
            statusEl.textContent = 'Impossible de vérifier le paiement pour le moment.';
        }
    };

    checkBtn.addEventListener('click', checkStatus);
})();
</script>
{% endblock %}
