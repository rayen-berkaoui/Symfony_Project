                                            <span class="mb-2 block text-xs uppercase tracking-[0.2em] text-gray-500">Début</span>
                                            <input type="datetime-local" name="dateDebut" value="{{ item.dateDebut|date('Y-m-d\TH:i') }}" class="w-full bg-transparent font-semibold text-white outline-none cart-date-start">
                                        </label>
                                        <label class="rounded-2xl border border-white/10 bg-black/20 px-4 py-3 text-sm text-gray-300">
