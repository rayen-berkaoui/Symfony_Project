        </div>
        <div class="rounded-3xl border border-white/10 bg-dark-300/80 p-5 shadow-luxury">
            <p class="text-xs uppercase tracking-[0.2em] text-gray-500">Panier moyen</p>
            <p class="mt-3 text-4xl font-black text-white">{{ averagePrice|number_format(2, '.', ' ') }}</p>
