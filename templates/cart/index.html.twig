{% extends 'base_front.html.twig' %}

{% block title %}Mon panier
<script>
    document.querySelectorAll('.cart-update-form').forEach((form) => {
        const unit = parseFloat(form.dataset.unitPrice || '0');
        const type = form.dataset.serviceType || 'Lieu';
        const start = form.querySelector('.cart-date-start');
        const end = form.querySelector('.cart-date-end');
        const adults = form.querySelector('.cart-adults');
        const children = form.querySelector('.cart-children');
        const rooms = form.querySelector('.cart-rooms');
        const output = form.querySelector('.cart-live-price');

        const recalc = () => {
            const adultCount = Math.max(1, parseInt(adults?.value || '1', 10));
            const childCount = Math.max(0, parseInt(children?.value || '0', 10));
            const roomCount = Math.max(1, parseInt(rooms?.value || '1', 10));
            const people = adultCount + childCount;
            let days = 1;
            if (start?.value && end?.value) {
                const diff = new Date(end.value) - new Date(start.value);
                days = diff > 0 ? Math.ceil(diff / 86400000) : 1;
            }
            const total = type === 'Hotel' ? unit * roomCount * days : unit * Math.max(1, people) * days;
            if (output) output.textContent = total.toFixed(2) + ' TND';
        };

        [start, end, adults, children, rooms].forEach((field) => {
            field?.addEventListener('input', recalc);
            field?.addEventListener('change', recalc);
        });
        recalc();
    });
</script>

{% endblock %}

{% block body %}
<section class="mx-auto max-w-7xl px-4 py-8 space-y-8" data-cart-insight-url="{{ insightUrl }}" data-cart-weather-url="{{ weatherAdviceUrl }}">
    <div class="flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
        <div>
            <p class="text-sm uppercase tracking-[0.35em] text-gold-500/70">Panier intelligent</p>
            <h1 class="text-4xl font-black text-white">Votre sélection voyage</h1>
