                                            <p class="text-xs uppercase tracking-[0.2em] text-gray-500">Capacité</p>
                                            <p class="mt-2 font-semibold text-white">{{ item.typeService == 'Hotel' ? (item.nbChambres ~ ' chambre(s)') : 'Service unitaire' }}</p>
                                            <p class="text-xs text-gray-500">{{ item.nbJours }} jour(s)</p>
                                        </div>
                                    </div>

                                    <form method="post" action="{{ path('app_cart_update', {'id': item.id}) }}" class="cart-update-form grid gap-3 lg:grid-cols-6" data-unit-price="{{ (item.nbJours > 0 and item.nbPersonnes > 0) ? (item.prixEstime / (item.typeService == 'Hotel' ? (item.nbChambres * item.nbJours) : (item.nbPersonnes * item.nbJours))) : item.prixEstime }}" data-service-type="{{ item.typeService }}">
