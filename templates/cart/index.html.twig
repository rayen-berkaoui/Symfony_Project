                                            <input type="datetime-local" name="dateFin" value="{{ item.dateFin|date('Y-m-d\TH:i') }}" class="w-full bg-transparent font-semibold text-white outline-none cart-date-end">
                                        </label>
                                        <label class="rounded-2xl border border-white/10 bg-black/20 px-4 py-3 text-sm text-gray-300">
                                            <span class="mb-2 block text-xs uppercase tracking-[0.2em] text-gray-500">Adultes</span>
                                            <input type="number" name="nbAdultes" min="1" max="20" value="{{ item.nbAdultes }}" class="w-full bg-transparent font-semibold text-white outline-none cart-adults">
                                        </label>
                                        <label class="rounded-2xl border border-white/10 bg-black/20 px-4 py-3 text-sm text-gray-300">
                                            <span class="mb-2 block text-xs uppercase tracking-[0.2em] text-gray-500">Enfants</span>
                                            <input type="number" name="nbEnfants" min="0" max="20" value="{{ item.nbEnfants }}" class="w-full bg-transparent font-semibold text-white outline-none cart-children">
                                        </label>
                                        {% if item.typeService == 'Hotel' %}
                                            <label class="rounded-2xl border border-white/10 bg-black/20 px-4 py-3 text-sm text-gray-300">
                                                <span class="mb-2 block text-xs uppercase tracking-[0.2em] text-gray-500">Chambres</span>
                                                <input type="number" name="nbChambres" min="1" max="10" value="{{ item.nbChambres }}" class="w-full bg-transparent font-semibold text-white outline-none cart-rooms">
                                            </label>
