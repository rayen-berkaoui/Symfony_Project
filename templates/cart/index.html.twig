            <div class="grid gap-6 lg:grid-cols-2">
                <article class="rounded-3xl border border-violet-500/20 bg-gradient-to-br from-violet-500/12 to-sky-500/8 p-6 shadow-luxury">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <p class="text-xs uppercase tracking-[0.25em] text-violet-300">Insight achat</p>
                            <h2 class="mt-2 text-2xl font-black text-white">Suggestions complémentaires</h2>
                        </div>
                        <span class="rounded-full border border-violet-400/20 bg-violet-400/10 px-3 py-1 text-xs font-semibold text-violet-200">IA + logique panier</span>
                    </div>
                    <p class="mt-4 text-sm leading-7 text-violet-100/85" id="purchaseInsightSummary">Analyse en cours…</p>
                    <div class="mt-5 space-y-3" id="purchaseInsightSuggestions">
                        <div class="rounded-2xl border border-white/10 bg-black/20 p-4 text-sm text-gray-400">Les recommandations apparaîtront ici dès que l’analyse du panier sera terminée.</div>
                    </div>
                </article>

                <article class="rounded-3xl border border-sky-500/20 bg-gradient-to-br from-sky-500/12 to-cyan-500/8 p-6 shadow-luxury">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <p class="text-xs uppercase tracking-[0.25em] text-sky-300">Météo décisionnelle</p>
