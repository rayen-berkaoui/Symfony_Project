                                        <div>
                                            <div class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-[0.22em] text-gold-500/70">
                                                <span>{{ item.serviceTypeLabel }}</span>
                                                <span class="h-1 w-1 rounded-full bg-gold-500/50"></span>
