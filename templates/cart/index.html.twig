{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block breadcrumb %}
    <span>Mon Panier</span>
{% endblock %}

{% block body %}
<div class="mb-10 flex flex-col md:flex-row md:items-start justify-between gap-4 animate-[fade-in_0.5s_ease-out]">
    <div>
        <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-600 mb-2 drop-shadow-[0_4px_15px_rgba(34,197,94,0.4)]">Mon Panier</h1>
        <p class="text-gray-400 text-lg">Gérez vos articles et finalisez votre réservation.</p>
    </div>

    {% if cartItems|length > 0 %}
    <a href="{{ path('app_cart_checkout') }}" class="group flex items-center justify-center gap-2 bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-400 hover:to-emerald-500 text-white px-6 py-3 rounded-xl transition-all duration-300 shadow-[0_0_15px_rgba(34,197,94,0.3)] hover:shadow-[0_4px_20px_rgba(34,197,94,0.5)] whitespace-nowrap font-bold">
        <i class="fa-solid fa-credit-card text-lg transition-transform group-hover:-translate-y-0.5"></i>
        <span>Passer la commande</span>
    </a>
    {% endif %}
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
    <div class="card bg-gradient-to-br from-dark-300 to-black border-green-500/10 hover:border-green-500/30 transition-all">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-500/20 to-green-700/10 flex items-center justify-center text-green-500">
                <i class="fa-solid fa-cart-shopping text-2xl"></i>
            </div>
            <div>
                <p class="text-green-500/70 text-xs font-bold uppercase tracking-widest">Articles</p>
                <h3 class="text-3xl font-black text-white">{{ itemCount }}</h3>
            </div>
        </div>
    </div>

    <div class="card bg-gradient-to-br from-dark-300 to-black border-gold-500/10 hover:border-gold-500/30 transition-all">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-gold-500/20 to-gold-700/10 flex items-center justify-center text-gold-500">
                <i class="fa-solid fa-coins text-2xl"></i>
            </div>
            <div>
                <p class="text-gold-500/70 text-xs font-bold uppercase tracking-widest">Total Estimé</p>
                <h3 class="text-3xl font-black text-white">{{ totalPrice|number_format(2) }} <span class="text-sm">TND</span></h3>
            </div>
        </div>
    </div>

    <div class="card bg-gradient-to-br from-dark-300 to-black border-blue-500/10 hover:border-blue-500/30 transition-all">
        <a href="{{ path('app_lieu_touristique_index') }}" class="flex items-center gap-4 group">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500/20 to-blue-700/10 flex items-center justify-center text-blue-500 group-hover:scale-110 transition-transform">
                <i class="fa-solid fa-plus text-2xl"></i>
            </div>
            <div>
                <p class="text-blue-500/70 text-xs font-bold uppercase tracking-widest">Continuer</p>
                <h3 class="text-lg font-bold text-white group-hover:text-blue-400 transition-colors">Ajouter des lieux</h3>
            </div>
        </a>
    </div>
</div>

{% if cartItems is empty %}
    <div class="card text-center py-16">
        <div class="w-24 h-24 rounded-full bg-dark-200 flex items-center justify-center mx-auto mb-6">
            <i class="fa-solid fa-cart-shopping text-4xl text-gray-600"></i>
        </div>
        <h2 class="text-2xl font-bold text-white mb-4">Votre panier est vide</h2>
        <p class="text-gray-400 mb-8">Explorez nos lieux touristiques et ajoutez-les à votre panier.</p>
        <a href="{{ path('app_lieu_touristique_index') }}" class="btn-gold inline-flex items-center gap-2">
            <i class="fa-solid fa-map-location-dot"></i>
            Découvrir les lieux
        </a>
    </div>
{% else %}
    <div class="space-y-6">
        {% for item in cartItems %}
            {% set lieu = item.lieuTouristique %}
            <div class="card group hover:border-green-500/30 transition-all duration-300">
                <div class="flex flex-col md:flex-row gap-6">
                    <!-- Image -->
                    <div class="w-full md:w-48 h-48 md:h-auto rounded-xl overflow-hidden bg-black/50 flex-shrink-0">
                        {% if lieu and lieu.image %}
                            <img src="{{ asset(lieu.image) }}" alt="{{ lieu.nom }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                        {% else %}
                            <div class="w-full h-full flex items-center justify-center text-gray-600">
                                <i class="fa-solid fa-image text-3xl"></i>
                            </div>
                        {% endif %}
                    </div>

                    <!-- Content -->
                    <div class="flex-1 flex flex-col">
                        <div class="flex items-start justify-between mb-4">
                            <div>
                                <span class="text-green-400/70 text-xs font-bold uppercase tracking-widest">{{ item.typeService }}</span>
                                <h3 class="text-xl font-bold text-white group-hover:text-green-400 transition-colors">
                                    {{ lieu ? lieu.nom : 'Lieu non disponible' }}
                                </h3>
                                {% if lieu %}
                                <p class="text-gray-400 text-sm">
                                    <i class="fa-solid fa-location-dot mr-1 text-gold-500/50"></i>
                                    {{ lieu.ville }}
                                </p>
                                {% endif %}
                            </div>
                            <span class="px-3 py-1 font-semibold rounded-full text-xs border {{ item.statutBadgeClass }}">
                                {{ item.statutLabel }}
                            </span>
                        </div>

                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                            <div>
                                <p class="text-gray-500 text-xs uppercase">Date début</p>
                                <p class="text-white font-semibold">{{ item.dateDebut|date('d/m/Y') }}</p>
                            </div>
                            <div>
                                <p class="text-gray-500 text-xs uppercase">Date fin</p>
                                <p class="text-white font-semibold">{{ item.dateFin|date('d/m/Y') }}</p>
                            </div>
                            <div>
                                <p class="text-gray-500 text-xs uppercase">Durée</p>
                                <p class="text-white font-semibold">{{ item.nbJours }} jour(s)</p>
                            </div>
                            <div>
                                <p class="text-gray-500 text-xs uppercase">Personnes</p>
                                <p class="text-white font-semibold">{{ item.nbPersonnes }} ({{ item.nbAdultes }}A + {{ item.nbEnfants }}E)</p>
                            </div>
                        </div>

                        <div class="flex items-center justify-between mt-auto pt-4 border-t border-white/5">
                            <p class="text-green-400 font-black text-2xl">{{ item.prixEstime|number_format(2) }} <span class="text-sm">TND</span></p>

                            <div class="flex gap-2">
                                <form method="post" action="{{ path('app_cart_remove', {'id': item.id}) }}" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('remove' ~ item.id) }}">
                                    <button type="submit" onclick="return confirm('Supprimer cet article du panier?')" class="px-4 py-2 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 hover:border-red-500/40 transition-all flex items-center gap-2">
                                        <i class="fa-solid fa-trash"></i>
                                        <span class="hidden sm:inline">Supprimer</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

        <!-- Total & Checkout -->
        <div class="card bg-gradient-to-r from-dark-300 to-dark-200 border-green-500/20">
            <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                <div>
                    <p class="text-gray-400 text-sm uppercase tracking-widest">Total de la commande</p>
                    <p class="text-4xl font-black text-white">{{ totalPrice|number_format(2) }} <span class="text-lg text-gold-500">TND</span></p>
                </div>
                <a href="{{ path('app_cart_checkout') }}" class="w-full md:w-auto bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-400 hover:to-emerald-500 text-white px-8 py-4 rounded-xl transition-all duration-300 shadow-lg hover:shadow-green-500/30 font-bold text-lg flex items-center justify-center gap-3">
                    <i class="fa-solid fa-credit-card"></i>
                    Finaliser la Commande
                </a>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}
