<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Tabaany{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🧭</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Archivo+Black&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            gold: { 400: "#f6d40b", 500: "#f5c518", 600: "#d4a50a" },
                            dark: { 100: "#283142", 200: "#171f2d", 300: "#101723", 400: "#0a111c" }
                        },
                        boxShadow: {
                            luxury: "0 20px 60px rgba(0,0,0,0.35)",
                        }
                    }
                }
            };
        </script>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app_front') }}{% endblock %}
        {% endblock %}
        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    {% set route = app.request.attributes.get('_route')|default('') %}
    <body class="app-body">
        <header class="site-header">
            <div class="container site-header-inner">
                <a class="site-brand" href="{{ app.user ? path('app_user_accueil') : path('app_home') }}">
                    <span class="site-brand-mark"><i class="fa-solid fa-compass-drafting"></i></span>
                    <span>
                        <span class="site-brand-title">Tabaany</span>
                        <span class="site-brand-tagline">Travel company experience, redesigned</span>
                    </span>
                </a>

                <nav class="site-nav">
                    <a class="site-link {{ route == 'app_home' ? 'is-active' : '' }}" href="{{ path('app_home') }}">Accueil</a>
                    {% if app.user %}
                        <a class="site-link {{ route == 'app_user_accueil' ? 'is-active' : '' }}" href="{{ path('app_user_accueil') }}">Explorer</a>
                        <a class="site-link {{ route starts with 'app_lieu_touristique' ? 'is-active' : '' }}" href="{{ path('app_lieu_touristique_index') }}">Lieux</a>
                        <a class="site-link {{ route starts with 'app_etablissement' ? 'is-active' : '' }}" href="{{ path('app_etablissement_index') }}">Etablissements</a>
                        <a class="site-link {{ route starts with 'app_activite' ? 'is-active' : '' }}" href="{{ path('app_activite_index') }}">Activites</a>
                    {% endif %}
                </nav>

                <div class="site-actions">
                    {% if app.user %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a class="btn ghost" href="{{ path('app_dashboard') }}">Backoffice</a>
                        {% endif %}
                        <a class="btn ghost" href="{{ path('app_profile') }}">Profil</a>
                        <a class="btn ghost" href="{{ path('app_cart_index') }}">Panier</a>
                        <span class="nav-user">{{ app.user.nom }} {{ app.user.prenom }}</span>
                        <a class="btn solid" href="{{ path('app_logout') }}">Deconnexion</a>
                    {% else %}
                        <a class="btn ghost" href="{{ path('app_login') }}">Connexion</a>
                        <a class="btn solid" href="{{ path('app_signup') }}">Inscription</a>
                    {% endif %}
                </div>
            </div>
        </header>

        <div class="flash-stack-front">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash-pill {{ label == 'error' ? 'danger' : label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
        </div>

        <main class="page">
            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <div class="container site-footer-inner">
                <div>
                    <strong>Tabaany</strong>
                    <p>Une plateforme voyage moderne pour explorer, reserver et gerer vos sorties en un seul endroit.</p>
                </div>
                <div class="site-footer-links">
                    <a href="{{ path('app_home') }}">Accueil</a>
                    {% if app.user %}
                        <a href="{{ path('app_user_accueil') }}">Explorer</a>
                        <a href="{{ path('app_user_reservation_index') }}">Reservations</a>
                    {% endif %}
                </div>
            </div>
        </footer>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                window.setTimeout(() => {
                    document.querySelectorAll('.flash-pill').forEach((item) => {
                        item.style.opacity = '0';
                        item.style.transform = 'translateY(-8px)';
                        window.setTimeout(() => item.remove(), 320);
                    });
                }, 3600);
            });
        </script>
    </body>
</html>
