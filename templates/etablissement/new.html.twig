{% extends 'base.html.twig' %}

{% block title %}Nouvel Etablissement{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --bg: #0d0d0d;
        --surface: #161616;
        --surface-2: #1d1d1d;
        --surface-3: #252525;
        --border: rgba(255, 255, 255, 0.08);
        --accent: #f5c518;
        --accent-2: #ffd54f;
        --text: #f3efe7;
        --muted: #8b8b8b;
        --danger: #e05b5b;
        --radius: 18px;
    }

    *, *::before, *::after { box-sizing: border-box; }

    body {
        margin: 0;
        background:
            radial-gradient(circle at top left, rgba(245, 197, 24, 0.08), transparent 28%),
            radial-gradient(circle at top right, rgba(245, 197, 24, 0.05), transparent 24%),
            var(--bg);
        color: var(--text);
        font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
        min-height: 100vh;
    }

    .etab-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 28px 24px 56px;
    }

    .page-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 10px;
    }

    .page-title {
        margin: 0;
        font-size: clamp(2rem, 2.5vw, 3rem);
        line-height: 1.05;
        letter-spacing: -0.04em;
    }

    .page-subtitle {
        margin: 10px 0 0;
        max-width: 680px;
        color: var(--muted);
        font-size: 0.96rem;
        line-height: 1.6;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 16px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.02);
        color: var(--muted);
        text-decoration: none;
        transition: transform 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        white-space: nowrap;
    }

    .back-link:hover {
        color: var(--text);
        border-color: rgba(245, 197, 24, 0.45);
        transform: translateY(-1px);
    }

    .layout {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(320px, 0.95fr);
        gap: 24px;
        align-items: start;
    }

    .panel,
    .sidebar-card {
        border: 1px solid var(--border);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0.01)), var(--surface);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.28);
    }

    .panel-section {
        padding: 26px 28px;
        border-bottom: 1px solid var(--border);
    }

    .panel-section:last-child { border-bottom: 0; }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 18px;
        font-size: 0.76rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .section-title::before {
        content: '';
        display: block;
        width: 24px;
        height: 2px;
        border-radius: 999px;
        background: var(--accent);
    }

    .grid-2,
    .grid-3 {
        display: grid;
        gap: 16px;
    }

    .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }

    .field {
        display: flex;
        flex-direction: column;
        gap: 7px;
        min-width: 0;
    }

    .field.full { grid-column: 1 / -1; }

    label {
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--muted);
    }

    input[type='text'],
    input[type='number'],
    input[type='email'],
    textarea,
    select {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--surface-2);
        color: var(--text);
        padding: 12px 14px;
        font-size: 0.92rem;
        outline: none;
        transition: border-color 0.2s ease, background-color 0.2s ease;
    }

    input:focus,
    textarea:focus,
    select:focus {
        border-color: rgba(245, 197, 24, 0.8);
        background: var(--surface-3);
    }

    textarea {
        min-height: 120px;
        resize: vertical;
    }

    .select-wrap { position: relative; }
    .select-wrap::after {
        content: '▾';
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--muted);
        pointer-events: none;
        font-size: 0.8rem;
    }
    .select-wrap select { padding-right: 36px; }

    .phone-input-group {
        display: grid;
        grid-template-columns: 110px 1fr;
        gap: 10px;
    }

    .map-shell {
        position: relative;
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
        background: #111;
    }

    .map-picker {
        height: 280px;
        position: relative;
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0)),
            radial-gradient(circle at 30% 30%, rgba(245, 197, 24, 0.18), transparent 36%),
            #0f0f0f;
        cursor: crosshair;
    }

    .map-pin {
        position: absolute;
        width: 16px;
        height: 16px;
        background: var(--accent);
        border-radius: 50% 50% 50% 0;
        transform: translate(-50%, -100%) rotate(-45deg);
        box-shadow: 0 0 0 3px rgba(245, 197, 24, 0.25);
    }

    .map-search-overlay {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 10px;
        padding: 12px;
        background: rgba(0, 0, 0, 0.45);
        border-bottom: 1px solid var(--border);
    }

    .map-help,
    .map-link-note,
    .helper-box {
        color: var(--muted);
        font-size: 0.86rem;
        line-height: 1.6;
    }

    .helper-box {
        border: 1px solid var(--border);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.02);
        padding: 14px 16px;
    }

    .file-input { display: none; }

    .btn,
    .btn-secondary,
    .btn-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 12px;
        padding: 11px 16px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .btn {
        background: linear-gradient(135deg, var(--accent), var(--accent-2));
        color: #111;
        font-weight: 700;
    }

    .btn:hover { transform: translateY(-1px); }

    .btn-secondary,
    .btn-ghost {
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.02);
        color: var(--muted);
    }

    .btn-secondary:hover,
    .btn-ghost:hover {
        color: var(--text);
        border-color: rgba(245, 197, 24, 0.35);
    }

    .actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        padding: 22px 28px 28px;
        flex-wrap: wrap;
    }

    .sidebar {
        display: flex;
        flex-direction: column;
        gap: 18px;
        position: sticky;
        top: 18px;
    }

    .sidebar-card { padding: 18px; }

    .sidebar-card h3 {
        margin: 0 0 14px;
        font-size: 0.92rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
    }

    .summary-list { display: grid; gap: 10px; }

    .summary-item {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 12px;
        background: var(--surface-2);
        border: 1px solid var(--border);
    }

    .summary-item span {
        color: var(--muted);
        font-size: 0.82rem;
    }

    .summary-item strong {
        text-align: right;
        font-size: 0.88rem;
        font-weight: 600;
        max-width: 62%;
        word-break: break-word;
    }

    .progress-head {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        color: var(--muted);
        font-size: 0.8rem;
    }

    .progress-track {
        width: 100%;
        height: 4px;
        border-radius: 999px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.06);
    }

    .progress-fill {
        width: 0;
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--accent), var(--accent-2));
        transition: width 0.35s ease;
    }

    .image-preview {
        margin-top: 10px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .image-chip {
        padding: 8px 12px;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: var(--surface-2);
        color: var(--muted);
        font-size: 0.82rem;
    }

    @media (max-width: 1080px) {
        .layout { grid-template-columns: 1fr; }
        .sidebar { position: static; }
    }

    @media (max-width: 760px) {
        .etab-page { padding: 20px 14px 40px; }
        .panel-section,
        .actions { padding-left: 18px; padding-right: 18px; }
        .grid-2,
        .grid-3,
        .phone-input-group { grid-template-columns: 1fr; }
        .map-search-overlay { grid-template-columns: 1fr; }
    }
</style>
{% endblock %}

{% block body %}
{% set fieldIds = {
    'nom': form.nom.vars.id,
    'type': form.type.vars.id,
    'gouvernorat': form.gouvernorat.vars.id,
    'ville': form.ville.vars.id,
    'adresse': form.adresse.vars.id,
    'telephone': form.telephone.vars.id,
    'email': form.email.vars.id,
    'gammePrix': form.gammePrix.vars.id,
    'horaires': form.horaires.vars.id,
    'description': form.description.vars.id,
    'latitude': form.latitude.vars.id,
    'longitude': form.longitude.vars.id,
    'images': form.images.vars.id
} %}

<div class="etab-page">
    <div class="page-head">
        <div>
            <div class="eyebrow">Etablissements</div>
            <h1 class="page-title">Ajouter un établissement</h1>
            <p class="page-subtitle">Créez un établissement avec ses informations, sa position sur la carte et sa galerie d'images.</p>
        </div>
        <a class="back-link" href="{{ path('app_etablissement_index') }}">← Retour à la liste</a>
    </div>

    {{ form_start(form, {'attr': {'id': 'etablissement-form', 'novalidate': 'novalidate'}}) }}
    <div class="layout">
        <div class="panel">
            <div class="panel-section">
                <div class="section-title">Informations générales</div>
                <div class="grid-2">
                    <div class="field">
                        {{ form_label(form.nom) }}
                        {{ form_widget(form.nom, {'attr': {'placeholder': 'Nom de l\'établissement'}}) }}
                        {{ form_errors(form.nom) }}
                    </div>
                    <div class="field">
                        {{ form_label(form.type) }}
                        <div class="select-wrap">{{ form_widget(form.type) }}</div>
                        {{ form_errors(form.type) }}
                    </div>

                    <div class="field">
                        {{ form_label(form.gouvernorat) }}
                        <div class="select-wrap">{{ form_widget(form.gouvernorat) }}</div>
                        {{ form_errors(form.gouvernorat) }}
                    </div>
                    <div class="field">
                        {{ form_label(form.ville) }}
                        <div class="select-wrap">{{ form_widget(form.ville) }}</div>
                        {{ form_errors(form.ville) }}
                    </div>

                    <div class="field full">
                        {{ form_label(form.adresse) }}
                        {{ form_widget(form.adresse, {'attr': {'placeholder': 'Adresse complète'}}) }}
                        {{ form_errors(form.adresse) }}
                    </div>

                    <div class="field">
                        <label for="{{ form.telephone.vars.id }}">Téléphone</label>
                        <div class="phone-input-group">
                            <div class="select-wrap">{{ form_widget(form.telephoneIndicatif) }}</div>
                            {{ form_widget(form.telephone, {'attr': {'placeholder': 'Ex: 22123456'}}) }}
                        </div>
                        {{ form_errors(form.telephone) }}
                    </div>

                    <div class="field">
                        {{ form_label(form.email) }}
                        {{ form_widget(form.email, {'attr': {'placeholder': 'Ex: nom@gmail.com'}}) }}
                        {{ form_errors(form.email) }}
                    </div>

                    <div class="field">
                        {{ form_label(form.gammePrix) }}
                        <div class="select-wrap">{{ form_widget(form.gammePrix) }}</div>
                        {{ form_errors(form.gammePrix) }}
                    </div>

                    <div class="field">
                        <label for="{{ form.horairesMode.vars.id }}">Horaires</label>
                        <div class="select-wrap">{{ form_widget(form.horairesMode) }}</div>
                        {{ form_widget(form.horaires, {'attr': {'placeholder': 'Ex: Lun-Ven 08:00-18:00', 'style': 'margin-top:10px;'}}) }}
                        {{ form_errors(form.horaires) }}
                    </div>
                </div>
            </div>

            <div class="panel-section">
                <div class="section-title">Localisation carte</div>
                <p class="map-help">Cliquez sur la carte pour sélectionner l'emplacement.</p>
                <div class="map-shell">
                    <div class="map-search-overlay">
                        <input id="map-search-input" type="text" placeholder="Rechercher un lieu..." autocomplete="off">
                        <button type="button" class="btn" id="map-search-btn">Chercher</button>
                    </div>
                    <div id="map-picker" class="map-picker" aria-label="Carte de localisation"></div>
                </div>
                <p class="map-help" id="map-status">Aucune position sélectionnée.</p>

                <div class="grid-2" style="margin-top: 12px;">
                    <div class="field">
                        {{ form_label(form.latitude) }}
                        {{ form_widget(form.latitude) }}
                        {{ form_errors(form.latitude) }}
                    </div>
                    <div class="field">
                        {{ form_label(form.longitude) }}
                        {{ form_widget(form.longitude) }}
                        {{ form_errors(form.longitude) }}
                    </div>
                </div>
            </div>

            <div class="panel-section">
                <div class="section-title">Description et médias</div>
                <div class="grid-2">
                    <div class="field full">
                        <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;">
                            {{ form_label(form.description) }}
                            <button type="button" class="btn-ghost" id="ai-description-btn">Generate with AI</button>
                        </div>
                        {{ form_widget(form.description, {'attr': {'placeholder': 'Décris l\'établissement...', 'maxlength': 200}}) }}
                        {{ form_errors(form.description) }}
                    </div>
                    <div class="field full">
                        <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;">
                            {{ form_label(form.images) }}
                            <label class="btn-ghost" for="{{ form.images.vars.id }}">Choisir image(s)</label>
                        </div>
                        {{ form_widget(form.images, {'attr': {'class': 'file-input'}}) }}
                        <div id="image-preview" class="image-preview"></div>
                        {{ form_errors(form.images) }}
                    </div>
                </div>
            </div>

            <div class="actions">
                <a class="btn-secondary" href="{{ path('app_etablissement_index') }}">Annuler</a>
                <button type="submit" class="btn">Enregistrer</button>
            </div>
        </div>

        <aside class="sidebar">
            <div class="sidebar-card">
                <h3>Aperçu</h3>
                <div class="summary-list">
                    <div class="summary-item"><span>Nom</span><strong id="summary-name">Nouveau</strong></div>
                    <div class="summary-item"><span>Type</span><strong id="summary-type">Non défini</strong></div>
                    <div class="summary-item"><span>Adresse</span><strong id="summary-address">Non définie</strong></div>
                    <div class="summary-item"><span>Ville</span><strong id="summary-city">Non définie</strong></div>
                    <div class="summary-item"><span>Contact</span><strong id="summary-contact">Non défini</strong></div>
                </div>
            </div>

            <div class="sidebar-card">
                <h3>Progression</h3>
                <div class="progress-head">
                    <span>Champs complétés</span>
                    <strong id="progress-label">0%</strong>
                </div>
                <div class="progress-track">
                    <div class="progress-fill" id="progress-fill"></div>
                </div>
                <div style="margin-top:14px;" class="helper-box">
                    Astuce: commencez par nom + gouvernorat + ville pour faciliter la localisation automatique.
                </div>
            </div>
        </aside>
    </div>
    {{ form_end(form) }}
</div>

<script>
(function () {
    const form = document.getElementById('etablissement-form');
    if (!form) {
        return;
    }

    const fields = {
        nom: document.getElementById('{{ fieldIds.nom }}'),
        type: document.getElementById('{{ fieldIds.type }}'),
        ville: document.getElementById('{{ fieldIds.ville }}'),
        adresse: document.getElementById('{{ fieldIds.adresse }}'),
        telephone: document.getElementById('{{ fieldIds.telephone }}'),
        email: document.getElementById('{{ fieldIds.email }}')
    };

    const summaryName = document.getElementById('summary-name');
    const summaryType = document.getElementById('summary-type');
    const summaryAddress = document.getElementById('summary-address');
    const summaryCity = document.getElementById('summary-city');
    const summaryContact = document.getElementById('summary-contact');
    const progressFill = document.getElementById('progress-fill');
    const progressLabel = document.getElementById('progress-label');

    function selectedText(el) {
        if (!el || !el.options) return '';
        const option = el.options[el.selectedIndex];
        return option ? option.textContent.trim() : '';
    }

    function updateSummary() {
        const nameValue = fields.nom && fields.nom.value ? fields.nom.value.trim() : '';
        const typeValue = selectedText(fields.type);
        const addressValue = fields.adresse && fields.adresse.value ? fields.adresse.value.trim() : '';
        const cityValue = selectedText(fields.ville);
        const phoneValue = fields.telephone && fields.telephone.value ? fields.telephone.value.trim() : '';
        const mailValue = fields.email && fields.email.value ? fields.email.value.trim() : '';

        if (summaryName) summaryName.textContent = nameValue || 'Nouveau';
        if (summaryType) summaryType.textContent = typeValue || 'Non défini';
        if (summaryAddress) summaryAddress.textContent = addressValue || 'Non définie';
        if (summaryCity) summaryCity.textContent = cityValue || 'Non définie';
        if (summaryContact) summaryContact.textContent = phoneValue || mailValue || 'Non défini';

        const progressFields = form.querySelectorAll('input[type="text"], input[type="number"], input[type="email"], textarea, select');
        let filled = 0;
        let total = 0;

        progressFields.forEach(function (input) {
            total += 1;
            if (input.value && input.value.toString().trim() !== '') {
                filled += 1;
            }
        });

        const percent = total ? Math.round((filled / total) * 100) : 0;
        if (progressFill) progressFill.style.width = percent + '%';
        if (progressLabel) progressLabel.textContent = percent + '%';
    }

    form.addEventListener('input', updateSummary);
    form.addEventListener('change', updateSummary);
    updateSummary();
})();
</script>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ include('etablissement/_form_scripts.html.twig') }}
{% endblock %}
