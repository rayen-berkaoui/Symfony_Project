<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Fiche Etablissement</title>
    <style>
        body {
            font-family: Helvetica, Arial, sans-serif;
            color: #111111;
            margin: 24px;
            font-size: 13px;
            line-height: 1.5;
        }
        h1 {
            margin: 0 0 6px;
            font-size: 24px;
        }
        .subtitle {
            color: #555;
            margin-bottom: 16px;
            font-size: 12px;
        }
        .section {
            border: 1px solid #e4e4e4;
            border-radius: 8px;
            margin-bottom: 14px;
            padding: 12px;
        }
        .section h2 {
            margin: 0 0 10px;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #666;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        td {
            padding: 6px 0;
            vertical-align: top;
            border-bottom: 1px dashed #ececec;
        }
        td.label {
            width: 30%;
            color: #666;
            font-weight: bold;
        }
        .footer {
            margin-top: 14px;
            font-size: 11px;
            color: #666;
        }
    </style>
</head>
<body>
    <h1>{{ etablissement.nom ?: 'Etablissement' }}</h1>
    <p class="subtitle">Fiche exportee le {{ "now"|date("d/m/Y H:i") }}</p>

    <div class="section">
        <h2>Informations generales</h2>
        <table>
            <tr><td class="label">Type</td><td>{{ etablissement.type ?: 'Non renseigne' }}</td></tr>
            <tr><td class="label">Gamme de prix</td><td>{{ etablissement.gammePrix ?: 'Non renseigne' }}</td></tr>
            <tr><td class="label">Telephone</td><td>{{ etablissement.telephone ?: 'Non renseigne' }}</td></tr>
            <tr><td class="label">Email</td><td>{{ etablissement.email ?: 'Non renseigne' }}</td></tr>
            <tr><td class="label">Horaires</td><td>{{ etablissement.horaires ?: 'Non renseigne' }}</td></tr>
        </table>
    </div>

    <div class="section">
        <h2>Localisation</h2>
        <table>
            <tr><td class="label">Ville</td><td>{{ etablissement.ville ?: 'Non renseigne' }}</td></tr>
            <tr><td class="label">Adresse</td><td>{{ etablissement.adresse ?: 'Non renseigne' }}</td></tr>
            <tr><td class="label">Latitude</td><td>{{ etablissement.latitude ?: 'Non renseigne' }}</td></tr>
            <tr><td class="label">Longitude</td><td>{{ etablissement.longitude ?: 'Non renseigne' }}</td></tr>
        </table>
    </div>

    <div class="section">
        <h2>Description</h2>
        <p>{{ etablissement.description ?: 'Aucune description fournie.' }}</p>
    </div>

    <p class="footer">Document genere automatiquement.</p>
</body>
</html>
