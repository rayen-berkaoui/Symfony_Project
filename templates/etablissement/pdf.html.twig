<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Fiche Etablissement</title>
    <style>
        body {
            margin: 0;
            padding: 24px;
            font-family: DejaVu Sans, Helvetica, Arial, sans-serif;
            color: #111111;
            background: #fffdf4;
        }
        .page {
            border: 1px solid #d4b106;
            background: #ffffff;
        }
        .hero {
            background: #111111;
            color: #ffffff;
            padding: 28px 30px 24px;
        }
        .eyebrow {
            display: inline-block;
            padding: 5px 10px;
            background: #f4c400;
            color: #111111;
            font-size: 11px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .hero h1 {
            margin: 14px 0 8px;
            font-size: 30px;
            line-height: 1.15;
        }
        .hero p {
            margin: 0;
            color: #f3e7a7;
            font-size: 13px;
        }
        .content {
            padding: 24px;
        }
        table.layout {
            width: 100%;
            border-collapse: collapse;
        }
        td.primary {
            width: 63%;
            vertical-align: top;
            padding-right: 18px;
        }
        td.secondary {
            width: 37%;
            vertical-align: top;
        }
        .photo {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border: 1px solid #e6d26a;
            background: #fff8d6;
            margin-bottom: 20px;
        }
        .placeholder {
            height: 250px;
            line-height: 250px;
            text-align: center;
            margin-bottom: 20px;
            border: 1px dashed #d4b106;
            background: #fff8d6;
            color: #8c7410;
            font-size: 13px;
        }
        .section {
            margin-bottom: 18px;
            padding: 18px;
            border: 1px solid #f0dfa0;
            background: #fffef8;
        }
        .section-title {
            margin: 0 0 12px;
            font-size: 15px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: #111111;
            border-left: 6px solid #f4c400;
            padding-left: 10px;
        }
        .description {
            margin: 0;
            font-size: 13px;
            line-height: 1.75;
            color: #2b2b2b;
            text-align: justify;
        }
        .meta-row {
            margin-bottom: 10px;
            font-size: 13px;
            line-height: 1.55;
            color: #2b2b2b;
        }
        .meta-label {
            display: block;
            margin-bottom: 2px;
            font-size: 11px;
            font-weight: bold;
            text-transform: uppercase;
            color: #8c7410;
            letter-spacing: 0.5px;
        }
        .info-card {
            padding: 18px;
            border: 1px solid #111111;
            background: #fff7cc;
            margin-bottom: 18px;
        }
        .qr-card {
            padding: 18px;
            border: 1px solid #111111;
            background: #111111;
            color: #ffffff;
            text-align: center;
        }
        .qr-card img {
            width: 148px;
            height: 148px;
            padding: 8px;
            background: #ffffff;
            border: 4px solid #f4c400;
        }
        .qr-title {
            margin: 0 0 14px;
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #f4c400;
        }
        .qr-text {
            margin: 12px 0 0;
            font-size: 12px;
            line-height: 1.5;
            color: #f8f0ba;
        }
        .footer {
            padding: 16px 24px 24px;
            font-size: 11px;
            color: #6a6a6a;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="page">
        <div class="hero">
            <span class="eyebrow">Fiche Etablissement</span>
            <h1>{{ etablissement.nom }}</h1>
            <p>
                {{ etablissement.type|capitalize|default('Etablissement') }}
                {% if etablissement.ville %}
                    • {{ etablissement.ville }}
                {% endif %}
            </p>
        </div>

        <div class="content">
            <table class="layout">
                <tr>
                    <td class="primary">
                        {% if image_base64 %}
                            <img src="{{ image_base64 }}" class="photo" alt="Image de l'etablissement">
                        {% else %}
                            <div class="placeholder">Aucune image disponible</div>
                        {% endif %}

                        <div class="section">
                            <h2 class="section-title">Presentation</h2>
                            <p class="description">{{ etablissement.description|default('Aucune description fournie')|nl2br }}</p>
                        </div>

                        <div class="section">
                            <h2 class="section-title">Localisation</h2>
                            <div class="meta-row">
                                <span class="meta-label">Adresse</span>
                                {{ etablissement.adresse|default('Non renseignee') }}
                            </div>
                            <div class="meta-row">
                                <span class="meta-label">Ville</span>
                                {{ etablissement.ville|default('Non renseignee') }}
                            </div>
                        </div>
                    </td>

                    <td class="secondary">
                        <div class="info-card">
                            <h2 class="section-title">Informations pratiques</h2>
                            <div class="meta-row">
                                <span class="meta-label">Telephone</span>
                                {{ etablissement.telephone|default('Non renseigne') }}
                            </div>
                            <div class="meta-row">
                                <span class="meta-label">Email</span>
                                {{ etablissement.email|default('Non renseigne') }}
                            </div>
                            <div class="meta-row">
                                <span class="meta-label">Horaires</span>
                                {{ etablissement.horaires|default('Non renseigne') }}
                            </div>
                            <div class="meta-row">
                                <span class="meta-label">Gamme de prix</span>
                                {{ etablissement.gammePrix|default('Non renseignee') }}
                            </div>
                        </div>

                        <div class="qr-card">
                            <p class="qr-title">QR Code localisation</p>
                            {% if qrCode_base64 %}
                                <img src="{{ qrCode_base64 }}" alt="QR Code Localisation">
                                <p class="qr-text">Scannez pour ouvrir directement la localisation sur la carte.</p>
                            {% else %}
                                <p class="qr-text">Le QR code n'est pas disponible car la localisation est incomplete.</p>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            </table>
        </div>

        <div class="footer">
            Fiche generee automatiquement le {{ 'now'|date('d/m/Y a H:i') }}
        </div>
    </div>
</body>
</html>
