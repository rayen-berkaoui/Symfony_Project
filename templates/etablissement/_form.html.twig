{{ form_start(form, {'attr': {'class': 'form-grid etab-create-form', 'novalidate': 'novalidate'}}) }}
    <section class="form-section">
        <h2 class="section-title">Informations generales</h2>

        <div class="form-row">
            {{ form_row(form.nom, {'label': 'Nom *', 'attr': {'placeholder': 'Nom'}}) }}
            {{ form_row(form.type, {'label': 'Type', 'attr': {'placeholder': 'hotel / restaurant / cafe / museum ...'}}) }}
        </div>

        <div class="form-row">
            {{ form_row(form.gouvernorat, {'label': 'Gouvernorat *'}) }}
            {{ form_row(form.ville, {'label': 'Ville *'}) }}
        </div>

        <div class="form-row">
            {{ form_row(form.adresse, {'label': 'Adresse', 'attr': {'placeholder': 'Adresse'}}) }}
            <div class="map-link-note">
                Astuce: saisis une adresse, puis utilise la zone "Rechercher un lieu" dans la carte pour positionner rapidement.
            </div>
            <div>
                <label class="form-label">Téléphone</label>
                <div class="phone-input-group">
                    {{ form_widget(form.telephoneIndicatif, {'attr': {'class': 'phone-prefix'}}) }}
                    {{ form_widget(form.telephone, {'attr': {'placeholder': 'Ex: 22123456'}}) }}
                </div>
                {{ form_errors(form.telephone) }}
            </div>
        </div>

        <div class="form-row">
            {{ form_row(form.email, {'label': 'Email', 'attr': {'placeholder': 'Ex: nom@gmail.com'}}) }}
            {{ form_row(form.gammePrix, {'label': 'Gamme de prix'}) }}
        </div>

        <div class="form-row">
            <div>
                <label class="form-label">Horaires</label>
                {{ form_widget(form.horairesMode, {'attr': {'class': 'schedule-select'}}) }}
                {{ form_widget(form.horaires, {'attr': {'placeholder': 'Ex: Lun-Ven 08:00-18:00', 'class': 'schedule-input'}}) }}
            </div>
            <div class="map-link-box">
                <span class="map-link-label">Position choisie</span>
                <p class="map-link-note" id="map-status">Aucune position selectionnee.</p>
            </div>
        </div>
    </section>

    <section class="form-section">
        <h2 class="section-title">Localisation sur la carte</h2>
        <p class="map-help">La carte se mettra à jour automatiquement en fonction de l'adresse renseignée.</p>
        <div class="map-shell">
            <div id="map-picker" class="map-picker" aria-label="Carte de localisation"></div>
        </div>
        <p class="map-help">Clique sur la carte pour remplir latitude et longitude.</p>

        <div class="form-row">
            {{ form_row(form.latitude, {'label': 'Latitude'}) }}
            {{ form_row(form.longitude, {'label': 'Longitude'}) }}
        </div>
    </section>

    <section class="form-section">
        <div class="section-headline">
            <h2 class="section-title">Description avec IA</h2>
            <button type="button" class="btn btn-ai" id="ai-description-btn">Generate with AI</button>
        </div>
        {{ form_row(form.description, {'label': 'Description (max 200)', 'attr': {'placeholder': "Decris l'etablissement...", 'maxlength': 200}}) }}
    </section>

    <section class="form-section">
        <div class="section-headline">
            <h2 class="section-title">Galerie d'images</h2>
            <label class="btn btn-ghost file-trigger" for="{{ form.images.vars.id }}">Choisir image(s)</label>
        </div>
        <p class="map-help">La première image sera utilisée comme image principale.</p>
        {{ form_widget(form.images, {'attr': {'class': 'file-input'}}) }}
        <div id="image-preview" class="image-preview"></div>
    </section>

    <div class="form-actions">
        <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
    </div>

    {{ form_rest(form) }}
{{ form_end(form, {'render_rest': false}) }}
