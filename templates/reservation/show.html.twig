{% extends 'base.html.twig' %}

{% block title %}Réservation {{ reservation.codeConfirmation }}{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_reservation_index') }}" class="hover:text-gold-400 transition-colors">Réservations</a>
    <i class="fa-solid fa-chevron-right mx-2 text-xs"></i>
    <span>{{ reservation.codeConfirmation }}</span>
{% endblock %}

{% block body %}
{% set panier = reservation.panier %}
{% set lieu = panier ? panier.lieuTouristique : null %}

<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-yellow-600 mb-2">Détails de la Réservation</h1>
        <p class="text-gray-400">Code: <span class="text-gold-500 font-semibold font-mono">{{ reservation.codeConfirmation }}</span></p>
    </div>
    <div class="flex gap-3">
        <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}" class="btn-dark flex items-center gap-2">
            <i class="fa-solid fa-pen"></i> Modifier
        </a>
        <a href="{{ path('app_reservation_index') }}" class="btn-gold flex items-center gap-2">
            <i class="fa-solid fa-arrow-left"></i> Retour
        </a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Info Card -->
    <div class="lg:col-span-2 space-y-6">
        <div class="card">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-gold-500/10">
                <h2 class="text-xl font-bold text-gold-400">
                    <i class="fa-solid fa-ticket mr-2"></i>
                    Informations de la Réservation
                </h2>
                <span class="px-4 py-2 font-semibold rounded-full text-sm border {{ reservation.statutBadgeClass }}">
                    {{ reservation.statutPaiement }}
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <div>
                        <label class="text-gold-500/70 text-xs uppercase tracking-widest">Lieu Touristique</label>
                        <p class="text-white text-lg font-semibold mt-1">
                            {% if lieu %}
                                <a href="{{ path('app_lieu_touristique_show', {'id': lieu.id}) }}" class="hover:text-gold-400 transition-colors">
                                    {{ lieu.nom }}
                                </a>
                            {% else %}
                                <span class="text-gray-500">Non spécifié</span>
                            {% endif %}
                        </p>
                    </div>
                    <div>
                        <label class="text-gold-500/70 text-xs uppercase tracking-widest">Mode de Paiement</label>
                        <p class="text-white text-lg font-semibold mt-1">
                            <i class="fa-solid fa-{{ reservation.modePaiementIcon }} mr-2 text-gold-500/50"></i>
                            {{ reservation.modePaiement }}
                        </p>
                    </div>
                    <div>
                        <label class="text-gold-500/70 text-xs uppercase tracking-widest">Date de Paiement</label>
                        <p class="text-white text-lg font-semibold mt-1">
                            {{ reservation.datePaiement|date('d/m/Y H:i') }}
                        </p>
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="text-gold-500/70 text-xs uppercase tracking-widest">Code de Confirmation</label>
                        <p class="text-white text-lg font-semibold mt-1 font-mono bg-dark-300/50 px-3 py-2 rounded-lg inline-block">
                            {{ reservation.codeConfirmation }}
                        </p>
                    </div>
                    <div>
                        <label class="text-gold-500/70 text-xs uppercase tracking-widest">Montant Total</label>
                        <p class="text-green-400 text-2xl font-black mt-1">
                            {{ reservation.montantTotal|number_format(2) }} <span class="text-sm">TND</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Panier Details -->
        {% if panier %}
        <div class="card">
            <h2 class="text-xl font-bold text-gold-400 mb-6 pb-4 border-b border-gold-500/10">
                <i class="fa-solid fa-shopping-cart mr-2"></i>
                Détails du Panier
            </h2>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-dark-300/50 rounded-xl p-4 text-center">
                    <p class="text-gold-500/70 text-xs uppercase tracking-widest mb-2">Date Début</p>
                    <p class="text-white font-semibold">{{ panier.dateDebut|date('d/m/Y') }}</p>
                </div>
                <div class="bg-dark-300/50 rounded-xl p-4 text-center">
                    <p class="text-gold-500/70 text-xs uppercase tracking-widest mb-2">Date Fin</p>
                    <p class="text-white font-semibold">{{ panier.dateFin|date('d/m/Y') }}</p>
                </div>
                <div class="bg-dark-300/50 rounded-xl p-4 text-center">
                    <p class="text-gold-500/70 text-xs uppercase tracking-widest mb-2">Personnes</p>
                    <p class="text-white font-semibold">{{ panier.nbPersonnes }}</p>
                </div>
                <div class="bg-dark-300/50 rounded-xl p-4 text-center">
                    <p class="text-gold-500/70 text-xs uppercase tracking-widest mb-2">Durée</p>
                    <p class="text-white font-semibold">{{ panier.nbJours }} jour(s)</p>
                </div>
            </div>
        </div>
        {% endif %}

        <!-- Rating & Review -->
        <div class="card">
            <h2 class="text-xl font-bold text-gold-400 mb-6 pb-4 border-b border-gold-500/10">
                <i class="fa-solid fa-star mr-2"></i>
                Évaluation
            </h2>

            {% if reservation.rating %}
                <div class="space-y-4">
                    <div class="flex items-center gap-4">
                        <span class="text-3xl text-yellow-400">{{ reservation.starRating }}</span>
                        <span class="text-xl text-white font-bold">{{ reservation.rating }}/5</span>
                    </div>
                    {% if reservation.reviewComment %}
                        <div class="bg-dark-300/50 rounded-xl p-4 mt-4">
                            <p class="text-gray-300 italic">"{{ reservation.reviewComment }}"</p>
                        </div>
                    {% endif %}
                </div>
            {% else %}
                <p class="text-gray-500">Aucune évaluation pour le moment.</p>
            {% endif %}
        </div>
    </div>

    <!-- Side Panel -->
    <div class="space-y-6">
        <!-- Lieu Image -->
        {% if lieu and lieu.image %}
        <div class="card p-0 overflow-hidden">
            <img src="{{ asset(lieu.image) }}" alt="{{ lieu.nom }}" class="w-full h-48 object-cover">
            <div class="p-4">
                <h3 class="font-bold text-white">{{ lieu.nom }}</h3>
                <p class="text-gray-400 text-sm">{{ lieu.ville }}</p>
            </div>
        </div>
        {% endif %}

        <!-- Actions -->
        <div class="card">
            <h3 class="text-lg font-bold text-gold-400 mb-4">Actions</h3>
            <div class="space-y-3">
                <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}" class="w-full btn-dark flex items-center justify-center gap-2">
                    <i class="fa-solid fa-pen"></i> Modifier
                </a>
                {% if panier %}
                <a href="{{ path('app_panier_show', {'id': panier.id}) }}" class="w-full btn-dark flex items-center justify-center gap-2">
                    <i class="fa-solid fa-shopping-cart"></i> Voir Panier
                </a>
                {% endif %}
                <form method="post" action="{{ path('app_reservation_delete', {'id': reservation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette réservation?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation.id) }}">
                    <button type="submit" class="w-full bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 hover:border-red-500/40 px-4 py-2.5 rounded-xl transition-all flex items-center justify-center gap-2">
                        <i class="fa-solid fa-trash"></i> Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
