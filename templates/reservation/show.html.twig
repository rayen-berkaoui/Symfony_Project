{% extends 'base.html.twig' %}

{% block title %}Réservation {{ reservation.codeConfirmation }}{% endblock %}

{% block body %}
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <p class="text-sm uppercase tracking-[0.3em] text-gold-500/70">Réservation</p>
            <h1 class="text-4xl font-black text-white">{{ reservation.codeConfirmation }}</h1>
        </div>
        <div class="flex gap-3"><a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}" class="btn-dark">Modifier</a><a href="{{ path('app_reservation_index') }}" class="btn-gold">Retour</a></div>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
        <div class="card lg:col-span-2 grid gap-4 md:grid-cols-2">
            <div><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Client</p><p class="mt-2 text-xl font-bold text-white">{{ reservation.panier and reservation.panier.utilisateur ? (reservation.panier.utilisateur.prenom ~ ' ' ~ reservation.panier.utilisateur.nom) : 'Client indisponible' }}</p><p class="text-gray-500">{{ reservation.panier and reservation.panier.utilisateur ? reservation.panier.utilisateur.email : '—' }}</p></div>
            <div><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Service</p><p class="mt-2 text-xl font-bold text-white">{{ reservation.panier.displayName }}</p><p class="text-gray-500">{{ reservation.panier.displayCity ?: reservation.panier.serviceTypeLabel }}</p></div>
            <div><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Date paiement</p><p class="mt-2 text-white">{{ reservation.datePaiement|date('d/m/Y H:i') }}</p></div>
            <div><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Mode</p><p class="mt-2 text-white">{{ reservation.modePaiementLabel }}</p></div>
            <div><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Statut</p><p class="mt-2"><span class="rounded-full border px-3 py-1 text-xs font-semibold {{ reservation.statutBadgeClass }}">{{ reservation.normalizedStatutPaiement }}</span></p></div>
            <div><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Montant</p><p class="mt-2 text-gold-400 font-bold">{{ reservation.montantTotal|number_format(2, '.', ' ') }} TND</p></div>
            <div><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Période</p><p class="mt-2 text-white">{{ reservation.panier.dateDebut|date('d/m/Y H:i') }} → {{ reservation.panier.dateFin|date('d/m/Y H:i') }}</p></div>
            <div><p class="text-xs uppercase tracking-[0.2em] text-gray-500">Voyageurs</p><p class="mt-2 text-white">{{ reservation.panier.nbPersonnes }} pers. / {{ reservation.panier.nbChambres }} chambre(s)</p></div>
        </div>
        <div class="card">
            <p class="text-xs uppercase tracking-[0.2em] text-gray-500">Timeline paiement</p>
            <div class="mt-4 space-y-3 text-sm">
                <div class="flex items-center gap-3"><span class="inline-flex h-3 w-3 rounded-full bg-gold-500"></span><span class="text-white">Réservation créée</span></div>
                <div class="flex items-center gap-3"><span class="inline-flex h-3 w-3 rounded-full {{ reservation.isPaid ? 'bg-emerald-400' : 'bg-amber-400' }}"></span><span class="text-white">{{ reservation.isPaid ? 'Paiement confirmé' : 'Paiement en attente de confirmation' }}</span></div>
                <div class="flex items-center gap-3"><span class="inline-flex h-3 w-3 rounded-full bg-sky-400"></span><span class="text-white">Service prêt dans l'espace réservations</span></div>
            </div>
        </div>
        <div class="card">
            <p class="text-xs uppercase tracking-[0.2em] text-gray-500">Avis</p>
            <p class="mt-3 text-3xl text-gold-400">{{ reservation.starRating }}</p>
            <p class="mt-3 text-sm text-gray-400">{{ reservation.reviewComment ?: 'Aucun commentaire.' }}</p>
        </div>
    </div>
</div>
{% endblock %}
