{% extends 'base.html.twig' %}

{% block title %}Réservations - Administration{% endblock %}

{% block breadcrumb %}
    <span>Gestion des Réservations</span>
{% endblock %}

{% block body %}
<div class="mb-10 flex flex-col md:flex-row md:items-start justify-between gap-4 animate-[fade-in_0.5s_ease-out]">
    <div>
        <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-yellow-600 mb-2 drop-shadow-[0_4px_15px_rgba(255,215,0,0.4)]">Gestion des Réservations</h1>
        <p class="text-gray-400 text-lg">Consultez et gérez toutes les réservations.</p>
    </div>

    <div class="flex flex-col sm:flex-row gap-3">
        <form method="get" action="{{ path('app_reservation_index') }}" class="flex relative group">
            <input type="text" name="search" value="{{ searchQuery }}" placeholder="Rechercher..." class="bg-dark-300 text-white border border-gold-500/20 rounded-l-xl px-4 py-2.5 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 w-full sm:w-64 transition-all">
            <button type="submit" class="bg-gradient-to-r from-dark-200 to-dark-300 hover:from-gold-500/20 hover:to-dark-200 text-gold-400 px-4 py-2.5 rounded-r-xl border border-l-0 border-gold-500/20 transition-all">
                <i class="fa-solid fa-search"></i>
            </button>
        </form>

        <a href="{{ path('app_reservation_pdf') }}" target="_blank" class="group flex items-center justify-center gap-2 bg-gradient-to-r from-red-600/20 to-red-600/10 hover:from-red-500 hover:to-red-600 border border-red-500/30 hover:border-transparent px-4 py-2.5 rounded-xl text-red-400 hover:text-white transition-all duration-300 shadow-[0_0_15px_rgba(239,68,68,0.1)] hover:shadow-[0_4px_20px_rgba(239,68,68,0.4)]" title="Exporter en PDF">
            <i class="fa-solid fa-file-pdf text-lg transition-transform group-hover:-translate-y-0.5"></i>
            <span class="font-semibold hidden sm:inline">PDF</span>
        </a>
    </div>
</div>

<!-- Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
    <!-- Total Reservations -->
    <div class="group bg-gradient-to-br from-dark-300 to-black hover:from-dark-200 hover:to-dark-300 border border-gold-500/10 rounded-2xl p-6 flex flex-col hover:border-gold-500/30 transition-all duration-500 shadow-[0_8px_30px_rgba(0,0,0,0.5)] relative overflow-hidden transform hover:-translate-y-2">
        <div class="absolute -right-6 -top-6 w-32 h-32 bg-gold-500/5 rounded-full blur-2xl group-hover:bg-gold-500/10 transition-all duration-500"></div>
        <div class="flex justify-between items-start mb-4 relative z-10">
            <div>
                <p class="text-gold-500/70 text-xs font-bold uppercase tracking-widest mb-2">Total Réservations</p>
                <h3 class="text-4xl font-black text-white group-hover:text-gold-400 transition-colors">{{ stats.total }}</h3>
            </div>
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-gold-500/20 to-gold-700/10 flex items-center justify-center text-gold-500 shadow-[0_0_15px_rgba(255,215,0,0.1)] group-hover:scale-110 transition-transform duration-500">
                <i class="fa-solid fa-ticket text-2xl"></i>
            </div>
        </div>
    </div>

    <!-- Payées -->
    <div class="group bg-gradient-to-br from-dark-300 to-black hover:from-dark-200 hover:to-dark-300 border border-green-500/10 rounded-2xl p-6 flex flex-col hover:border-green-500/30 transition-all duration-500 shadow-[0_8px_30px_rgba(0,0,0,0.5)] relative overflow-hidden transform hover:-translate-y-2">
        <div class="absolute -right-6 -top-6 w-32 h-32 bg-green-500/5 rounded-full blur-2xl group-hover:bg-green-500/10 transition-all duration-500"></div>
        <div class="flex justify-between items-start mb-4 relative z-10">
            <div>
                <p class="text-green-500/70 text-xs font-bold uppercase tracking-widest mb-2">Payées</p>
                <h3 class="text-4xl font-black text-white group-hover:text-green-400 transition-colors">{{ stats.paye }}</h3>
            </div>
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-500/20 to-green-700/10 flex items-center justify-center text-green-400 shadow-[0_0_15px_rgba(34,197,94,0.1)] group-hover:scale-110 transition-transform duration-500">
                <i class="fa-solid fa-check-circle text-2xl"></i>
            </div>
        </div>
    </div>

    <!-- En Cours -->
    <div class="group bg-gradient-to-br from-dark-300 to-black hover:from-dark-200 hover:to-dark-300 border border-yellow-500/10 rounded-2xl p-6 flex flex-col hover:border-yellow-500/30 transition-all duration-500 shadow-[0_8px_30px_rgba(0,0,0,0.5)] relative overflow-hidden transform hover:-translate-y-2">
        <div class="absolute -right-6 -top-6 w-32 h-32 bg-yellow-500/5 rounded-full blur-2xl group-hover:bg-yellow-500/10 transition-all duration-500"></div>
        <div class="flex justify-between items-start mb-4 relative z-10">
            <div>
                <p class="text-yellow-500/70 text-xs font-bold uppercase tracking-widest mb-2">En Cours</p>
                <h3 class="text-4xl font-black text-white group-hover:text-yellow-400 transition-colors">{{ stats.en_cours }}</h3>
            </div>
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-yellow-500/20 to-yellow-700/10 flex items-center justify-center text-yellow-400 shadow-[0_0_15px_rgba(234,179,8,0.1)] group-hover:scale-110 transition-transform duration-500">
                <i class="fa-solid fa-hourglass-half text-2xl"></i>
            </div>
        </div>
    </div>

    <!-- Revenue -->
    <div class="group bg-gradient-to-br from-dark-300 to-black hover:from-dark-200 hover:to-dark-300 border border-blue-500/10 rounded-2xl p-6 flex flex-col hover:border-blue-500/30 transition-all duration-500 shadow-[0_8px_30px_rgba(0,0,0,0.5)] relative overflow-hidden transform hover:-translate-y-2">
        <div class="absolute -right-6 -top-6 w-32 h-32 bg-blue-500/5 rounded-full blur-2xl group-hover:bg-blue-500/10 transition-all duration-500"></div>
        <div class="flex justify-between items-start mb-4 relative z-10">
            <div>
                <p class="text-blue-500/70 text-xs font-bold uppercase tracking-widest mb-2">Revenus</p>
                <h3 class="text-3xl font-black text-white group-hover:text-blue-400 transition-colors"><span class="text-xl">DT</span> {{ stats.revenue|number_format(2, '.', ' ') }}</h3>
            </div>
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500/20 to-blue-700/10 flex items-center justify-center text-blue-400 shadow-[0_0_15px_rgba(59,130,246,0.1)] group-hover:scale-110 transition-transform duration-500">
                <i class="fa-solid fa-money-bill-trend-up text-2xl"></i>
            </div>
        </div>
    </div>
</div>

<div class="card bg-gradient-to-br from-dark-300 to-black shadow-[0_8px_30px_rgba(0,0,0,0.5)] border-gold-500/10 relative overflow-hidden animate-[fade-in_0.5s_ease-out]">
    <div class="absolute -right-20 -top-20 w-64 h-64 bg-gold-500/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="flex flex-col sm:flex-row justify-between items-center sm:items-start mb-4 gap-4">
        <div class="text-gray-400 text-sm flex gap-3 items-center">
            <span class="text-gold-500 font-semibold"><i class="fa-solid fa-sort mr-1"></i> Trier par :</span>
            <div class="flex gap-2">
                <span class="hover:text-white transition">{{ knp_pagination_sortable(reservations, 'Date', 'r.datePaiement') }}</span> |
                <span class="hover:text-white transition">{{ knp_pagination_sortable(reservations, 'Montant', 'r.montantTotal') }}</span> |
                <span class="hover:text-white transition">{{ knp_pagination_sortable(reservations, 'Statut', 'r.statutPaiement') }}</span>
            </div>
        </div>
        <div class="flex items-center gap-2 mt-2 sm:mt-0">
            <button type="button" class="btn-dark px-3 py-2" data-carousel-prev="reservation-carousel" aria-label="Précédent">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button type="button" class="btn-dark px-3 py-2" data-carousel-next="reservation-carousel" aria-label="Suivant">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>
    </div>

    {% if reservations is empty %}
        <p class="text-center py-8 text-gray-500">Aucune réservation trouvée.</p>
    {% else %}
        <div id="reservation-carousel" class="flex gap-5 overflow-x-auto pb-3 snap-x snap-mandatory scroll-smooth">
            {% for reservation in reservations %}
                {% set panier = reservation.panier %}
                {% set lieu = panier ? panier.lieuTouristique : null %}
                <article class="min-w-[88vw] sm:min-w-[500px] lg:min-w-[560px] max-w-[88vw] sm:max-w-[500px] lg:max-w-[560px] snap-start bg-gradient-to-b from-dark-200 to-dark-300 border border-white/5 hover:border-gold-500/30 rounded-2xl overflow-hidden flex flex-col group transition-all duration-500 hover:-translate-y-2 shadow-[0_4px_15px_rgba(0,0,0,0.5)]">
                    <div class="h-48 bg-black/60 p-2 flex items-center justify-center relative overflow-hidden">
                        <div class="absolute inset-0 bg-gold-500/10 group-hover:bg-transparent transition-colors z-10 pointer-events-none"></div>
                        {% if lieu and lieu.image %}
                            <img src="{{ asset(lieu.image) }}" alt="Image de {{ lieu.nom }}" class="w-full h-full object-contain rounded-xl z-0 transition-transform duration-700 group-hover:scale-105" loading="lazy">
                        {% else %}
                            <div class="w-full h-full flex flex-col items-center justify-center text-gray-600">
                                <i class="fa-solid fa-ticket text-4xl mb-2 opacity-50"></i>
                                <span class="text-sm font-medium">{{ reservation.codeConfirmation }}</span>
                            </div>
                        {% endif %}
                    </div>

                    <div class="p-6 flex-1 flex flex-col relative">
                        <div class="flex items-center justify-between mb-4">
                            <span class="text-gold-500/70 font-bold text-xs uppercase tracking-widest bg-gold-500/10 px-3 py-1 rounded-full border border-gold-500/20 font-mono">{{ reservation.codeConfirmation }}</span>
                            <span class="px-3 py-1 font-semibold rounded-full text-xs border flex items-center gap-1.5 {{ reservation.statutBadgeClass }}">
                                <div class="w-1.5 h-1.5 rounded-full {% if reservation.statutPaiement == 'Payé' %}bg-green-500{% elseif reservation.statutPaiement == 'En cours de paiement' %}bg-yellow-500 animate-pulse{% else %}bg-red-500{% endif %}"></div>
                                {{ reservation.statutPaiement }}
                            </span>
                        </div>

                        <h2 class="text-2xl font-black text-white mb-2 group-hover:text-gold-400 transition-colors drop-shadow">
                            {{ lieu ? lieu.nom : 'Lieu non spécifié' }}
                        </h2>
                        <p class="text-sm text-gray-400 mb-2 font-medium">
                            <i class="fa-solid fa-{{ reservation.modePaiementIcon }} mr-2 text-gold-500/50"></i>
                            {{ reservation.modePaiement }}
                        </p>
                        <p class="text-sm text-gray-400 mb-4 font-medium">
                            <i class="fa-solid fa-calendar-check mr-2 text-gold-500/50"></i>
                            {{ reservation.datePaiement|date('d/m/Y H:i') }}
                        </p>

                        {% if reservation.rating %}
                        <p class="text-sm text-yellow-400 mb-4">
                            {{ reservation.starRating }}
                        </p>
                        {% endif %}

                        <div class="flex items-center justify-between mt-auto pt-4 border-t border-white/5">
                            <p class="text-white font-black text-xl"><span class="text-gold-500 text-sm font-medium mr-1">DT</span>{{ reservation.montantTotal|number_format(2, '.', ' ') }}</p>

                            <div class="flex gap-2">
                                <a href="{{ path('app_reservation_show', {'id': reservation.id}) }}" class="w-10 h-10 rounded-xl bg-dark-200 hover:bg-gold-500/20 text-gray-400 hover:text-gold-400 flex items-center justify-center border border-white/5 transition-all duration-300 hover:border-gold-500/30" title="Voir plus">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}" class="w-10 h-10 rounded-xl bg-dark-200 hover:bg-blue-500/20 text-gray-400 hover:text-blue-400 flex items-center justify-center border border-white/5 transition-all duration-300 hover:border-blue-500/30" title="Modifier">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>

        <div class="mt-6 flex justify-center">
            {{ knp_pagination_render(reservations) }}
        </div>
    {% endif %}
</div>

<script>
    document.querySelectorAll('[data-carousel-prev], [data-carousel-next]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-carousel-prev') || btn.getAttribute('data-carousel-next');
            const target = document.getElementById(id);
            if (!target) return;
            const step = target.clientWidth * 0.8;
            const direction = btn.hasAttribute('data-carousel-next') ? 1 : -1;
            target.scrollBy({ left: direction * step, behavior: 'smooth' });
        });
    });
</script>

<style>
    .snap-x::-webkit-scrollbar { height: 12px; }
    .snap-x::-webkit-scrollbar-track { background: rgba(30, 41, 59, 0.5); border-radius: 9999px; }
    .snap-x::-webkit-scrollbar-thumb { background: linear-gradient(to right, #fbbf24, #b45309); border-radius: 9999px; border: 3px solid rgba(15, 23, 42, 1); }
    .snap-x::-webkit-scrollbar-thumb:hover { background: linear-gradient(to right, #f59e0b, #92400e); }
</style>
{% endblock %}
