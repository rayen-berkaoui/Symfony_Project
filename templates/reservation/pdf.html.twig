<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <style>
        @page { margin: 28px; }
        body { font-family: DejaVu Sans, sans-serif; color:#0f172a; font-size:12px; }
        .hero { background: linear-gradient(135deg,#0f172a,#1e293b); color:white; padding:24px; border-radius:18px; }
        .sub { color:#cbd5e1; font-size:11px; }
        .grid { width:100%; margin-top:18px; }
        .card { display:inline-block; width:23%; margin-right:1%; background:#f8fafc; border:1px solid #e2e8f0; border-radius:16px; padding:14px; vertical-align:top; box-sizing:border-box; }
        .kpi { font-size:24px; font-weight:700; margin-top:8px; color:#0f172a; }
        .label { font-size:10px; text-transform:uppercase; letter-spacing:.12em; color:#64748b; }
        table { width:100%; border-collapse:collapse; margin-top:22px; }
        th { text-align:left; font-size:10px; text-transform:uppercase; letter-spacing:.12em; color:#64748b; border-bottom:1px solid #cbd5e1; padding:10px 8px; }
        td { padding:12px 8px; border-bottom:1px solid #e2e8f0; vertical-align:top; }
        .pill { display:inline-block; padding:4px 10px; border-radius:999px; font-size:10px; font-weight:700; }
        .ok { background:#dcfce7; color:#166534; }
        .pending { background:#fef3c7; color:#92400e; }
        .wait { background:#e2e8f0; color:#334155; }
        .alert { background:#fff7ed; color:#9a3412; border:1px solid #fdba74; padding:2px 8px; border-radius:999px; font-size:10px; font-weight:700; }
    </style>
</head>
<body>
    <section class="hero">
        <div style="font-size:11px; letter-spacing:.18em; text-transform:uppercase;">Tabaany • Dashboard Réservations</div>
        <h1 style="margin:10px 0 6px; font-size:30px;">Rapport des réservations</h1>
        <div class="sub">Généré le {{ generatedAt|date('d/m/Y H:i') }} • PDF aligné avec l’interface du site</div>
    </section>

    <div class="grid">
        <div class="card"><div class="label">Réservations</div><div class="kpi">{{ stats.total }}</div></div>
        <div class="card"><div class="label">Payées</div><div class="kpi">{{ stats.paye }}</div></div>
        <div class="card"><div class="label">En cours</div><div class="kpi">{{ stats.en_cours }}</div></div>
        <div class="card"><div class="label">Revenu</div><div class="kpi">{{ stats.revenue|number_format(2, '.', ' ') }} TND</div></div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Code</th>
                <th>Client</th>
                <th>Service</th>
                <th>Date paiement</th>
                <th>Mode</th>
                <th>Montant</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
        {% for row in rows %}
            <tr>
                <td>
                    <strong>{{ row.codeConfirmation }}</strong>
                    {% if row.orphaned %}<div style="margin-top:6px;"><span class="alert">Panier supprimé</span></div>{% endif %}
                </td>
                <td>
                    <strong>{{ row.clientName }}</strong>
                    <div style="color:#64748b; font-size:11px;">{{ row.clientEmail ?: '—' }}</div>
                </td>
                <td>
                    <strong>{{ row.displayName }}</strong>
                    <div style="color:#64748b; font-size:11px;">{{ row.displayCity }}{% if row.nbPersonnes %} • {{ row.nbPersonnes }} pers.{% endif %}</div>
                </td>
                <td>{{ row.datePaiement ? row.datePaiement|date('d/m/Y H:i') : '—' }}</td>
                <td>{{ row.modePaiementLabel }}</td>
                <td><strong>{{ row.montantTotal|number_format(2, '.', ' ') }} TND</strong></td>
                <td>
                    <span class="pill {{ row.normalizedStatutPaiement == 'Paye' ? 'ok' : (row.normalizedStatutPaiement == 'En cours de paiement' ? 'pending' : 'wait') }}">{{ row.normalizedStatutPaiement }}</span>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</body>
</html>
