{% extends 'base.html.twig' %}

{% block title %}Nouvelle Reservation{% endblock %}

{% block breadcrumb %}
    <a href="{{ path('app_reservation_index') }}" class="hover:text-gold-400 transition-colors">Reservations</a>
    <i class="fa-solid fa-chevron-right mx-2 text-xs"></i>
    <span>Nouvelle Reservation</span>
{% endblock %}

{% block body %}
<div class="mb-8">
    <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-yellow-600 mb-2">Créer une Réservation</h1>
    <p class="text-gray-400">Remplissez ce formulaire pour créer une nouvelle réservation.</p>
</div>

<div class="card max-w-3xl">
    {{ include('reservation/_form.html.twig', {'button_label': 'Enregistrer'}) }}
</div>
{% endblock %}
