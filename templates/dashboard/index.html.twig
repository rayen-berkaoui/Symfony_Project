{% extends 'base.html.twig' %}

{% block title %}Dashboard - Tabaany{% endblock %}

{% block body %}
<div class="dashboard-header">
    <div class="container">
        <div class="welcome-section">
            <div>
                <h1 class="dashboard-title">Bonjour, {{ app.user.prenom }} ! 👋</h1>
                <p class="muted">Bienvenue sur votre tableau de bord. Gérez vos voyages et découvertes.</p>
            </div>
            <a href="{{ path('app_profile') }}" class="btn ghost">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                Mon profil
            </a>
        </div>
    </div>
</div>

<div class="container dashboard-content">
    <div class="dashboard-grid">
        <!-- Quick Actions -->
        <div class="dashboard-section">
            <h2 class="section-title">Actions rapides</h2>
            <div class="quick-actions-grid">
                <a href="#" class="action-card">
                    <div class="action-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                    </div>
                    <div>
                        <h3>Découvrir</h3>
                        <p class="muted">Explorer les lieux</p>
                    </div>
                </a>
                
                <a href="#" class="action-card">
                    <div class="action-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                    </div>
                    <div>
                        <h3>Mes favoris</h3>
                        <p class="muted">Lieux sauvegardés</p>
                    </div>
                </a>
                
                <a href="#" class="action-card">
                    <div class="action-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <path d="M16 2v4M8 2v4M3 10h18"/>
                        </svg>
                    </div>
                    <div>
                        <h3>Réservations</h3>
                        <p class="muted">Gérer mes réservations</p>
                    </div>
                </a>
                
                <a href="#" class="action-card">
                    <div class="action-icon">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>
                        </svg>
                    </div>
                    <div>
                        <h3>Mes voyages</h3>
                        <p class="muted">Historique</p>
                    </div>
                </a>
            </div>
        </div>

        <!-- Management Section -->
        <div class="dashboard-section full-width">
            <h2 class="section-title">Gestion</h2>
            <div class="management-grid">
                {% if is_granted('ROLE_ADMIN') %}
                <div class="management-card admin-card">
                    <div class="management-header">
                        <span class="badge badge-admin">Admin</span>
                        <h3>Gestion des utilisateurs</h3>
                    </div>
                    <p class="muted">Gérer tous les utilisateurs de la plateforme</p>
                    <a href="{{ path('utilisateur_index') }}" class="btn solid">
                        Voir les utilisateurs
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </a>
                </div>
                {% endif %}
                
                <div class="management-card">
                    <div class="management-header">
                        <span class="badge badge-location">Lieux</span>
                        <h3>Gestion des lieux</h3>
                    </div>
                    <p class="muted">Restaurants, attractions, activités</p>
                    <a href="#" class="btn ghost">
                        Gérer les lieux
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </a>
                </div>
                
                <div class="management-card">
                    <div class="management-header">
                        <span class="badge badge-booking">Réservations</span>
                        <h3>Gestion des réservations</h3>
                    </div>
                    <p class="muted">Consulter et gérer les réservations</p>
                    <a href="#" class="btn ghost">
                        Voir les réservations
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </a>
                </div>
                
                <div class="management-card">
                    <div class="management-header">
                        <span class="badge badge-preferences">Préférences</span>
                        <h3>Mes préférences</h3>
                    </div>
                    <p class="muted">Personnaliser mon expérience</p>
                    <a href="{{ path('app_profile') }}" class="btn ghost">
                        Configurer
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="dashboard-section full-width">
            <h2 class="section-title">Activité récente</h2>
            <div class="activity-list">
                <div class="activity-item">
                    <div class="activity-icon">🎭</div>
                    <div class="activity-content">
                        <h4>Nouvelle activité disponible</h4>
                        <p class="muted">Visite guidée du centre historique</p>
                    </div>
                    <span class="activity-time">Il y a 2h</span>
                </div>
                
                <div class="activity-item">
                    <div class="activity-icon">🍽️</div>
                    <div class="activity-content">
                        <h4>Restaurant recommandé</h4>
                        <p class="muted">La Table du Chef - Cuisine française</p>
                    </div>
                    <span class="activity-time">Hier</span>
                </div>
                
                <div class="activity-item">
                    <div class="activity-icon">⭐</div>
                    <div class="activity-content">
                        <h4>Nouveau favori ajouté</h4>
                        <p class="muted">Musée d'Art Moderne</p>
                    </div>
                    <span class="activity-time">Il y a 3 jours</span>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
