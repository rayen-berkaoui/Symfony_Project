<!DOCTYPE html>
<html lang="fr" class="bg-black text-white h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Tabaany Administration{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>T</text></svg>">
        
        <!-- Tailwind CSS -->
        <script src="https://cdn.tailwindcss.com"></script>
        
        <!-- Font Awesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        
        <!-- Custom Configuration for Black & Gold -->
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            gold: { 400: '#FBBF24', 500: '#FFD700', 600: '#D4AF37' },
                            dark: { 100: '#2A2A2A', 200: '#1A1A1A', 300: '#121212', 400: '#0A0A0A' }
                        },
                        fontFamily: { sans: ['"Segoe UI"', 'Inter', '"Helvetica Neue"', 'sans-serif'] }
                    }
                }
            }
        </script>
        
        <style>
            body { background-color: #000000; color: #ffffff; }
            .card { background-color: rgba(10, 10, 10, 0.95); border: 1px solid rgba(255, 215, 0, 0.06); box-shadow: 0 8px 30px rgba(255, 215, 0, 0.06); border-radius: 16px; padding: 1.5rem; }
            .btn-gold { background-color: #FFD700; color: #000; transition: all 0.3s ease; font-weight: 600; border-radius: 8px; padding: 0.5rem 1.25rem; display: inline-block; }
            .btn-gold:hover { background-color: #D4AF37; box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3); }
            .btn-dark { background-color: #1A1A1A; color: #FFD700; border: 1px solid rgba(255, 215, 0, 0.2); transition: all 0.3s ease; border-radius: 8px; padding: 0.5rem 1.25rem; display: inline-block; }
            .btn-dark:hover { background-color: #2A2A2A; border-color: #FFD700; }
            .input-modern { background-color: rgba(18, 18, 18, 0.9); border: 1px solid rgba(255, 215, 0, 0.08); border-radius: 10px; color: white; padding: 0.75rem 1rem; width: 100%; transition: border-color 0.3s; margin-bottom: 1rem; }
            .input-modern:focus { outline: none; border-color: rgba(255, 215, 0, 0.5); }
            label { display: block; color: rgba(255, 215, 0, 0.85); font-size: 0.75rem; font-weight: bold; letter-spacing: 0.05em; margin-bottom: 0.5rem; text-transform: uppercase; }
            table { width: 100%; border-collapse: separate; border-spacing: 0; }
            th { text-align: left; padding: 1rem; color: #FFD700; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid rgba(255, 215, 0, 0.1); }
            td { padding: 1rem; border-bottom: 1px solid rgba(255, 215, 0, 0.05); color: #E5E5E5; }
            tr:hover td { background-color: rgba(255, 215, 0, 0.02); }
            
            /* form overrides */
            input[type="text"], input[type="number"], input[type="file"], select, textarea {
                background-color: rgba(18, 18, 18, 0.9) !important;
                border: 1px solid rgba(255, 215, 0, 0.08) !important;
                border-radius: 10px !important;
                color: white !important;
                transition: all 0.3s ease;
            }
            input:focus, select:focus, textarea:focus {
                border-color: rgba(255, 215, 0, 0.5) !important;
                outline: none !important;
                box-shadow: 0 0 0 1px rgba(255, 215, 0, 0.5), 0 0 10px rgba(255, 215, 0, 0.2) !important;
            }

            /* Custom scrollbar */
            ::-webkit-scrollbar { width: 8px; height: 8px; }
            ::-webkit-scrollbar-track { background: rgba(10, 10, 10, 0.8); }
            ::-webkit-scrollbar-thumb { background: rgba(255, 215, 0, 0.2); border-radius: 4px; }
            ::-webkit-scrollbar-thumb:hover { background: rgba(255, 215, 0, 0.5); }
            
            /* Theme Toggle Magic Style */
            html.light-mode {
                filter: invert(1) hue-rotate(180deg);
                background-color: #000000; /* Setting black so the inverse is white */
            }
            /* Elements that should stay in original color or not be double inverted */
            html.light-mode img,
            html.light-mode video,
            html.light-mode iframe,
            html.light-mode .leaflet-container,
            html.light-mode .custom-popup,
            html.light-mode .no-invert {
                filter: invert(1) hue-rotate(180deg);
            }
            /* Dark mode transitions for smooth toggle */
            html { transition: filter 0.5s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
        </style>

        <!-- Prevent FOUC for Theme -->
        <script>
            if (localStorage.getItem('theme') === 'light') {
                document.documentElement.classList.add('light-mode');
            }
        </script>

        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="flex h-screen overflow-hidden">
        
        <!-- Sidebar Navigation -->
        <aside class="w-64 bg-dark-400 border-r border-gold-500/10 flex-shrink-0 flex flex-col relative overflow-hidden backdrop-blur-xl bg-opacity-90 bg-gradient-to-b from-dark-400 to-black z-10 shadow-[4px_0_24px_rgba(255,215,0,0.05)]">
            <!-- decorative blur behind sidebar -->
