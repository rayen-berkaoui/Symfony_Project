                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_activite_index') }}" class="group flex items-center space-x-3 px-4 py-3.5 rounded-xl text-gray-400 hover:bg-gradient-to-r hover:from-gold-500/10 hover:to-transparent hover:text-gold-400 transition-all duration-300 relative overflow-hidden {% if app.request.attributes.get('_route') starts with 'app_activite' %}bg-gradient-to-r from-gold-500/20 to-dark-200/50 text-gold-400 shadow-[0_0_15px_rgba(255,215,0,0.1)] border-l-2 border-gold-400{% endif %}">
