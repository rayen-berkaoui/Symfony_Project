                            {{ app.user ? app.user.nom|first|upper : 'A' }}
                        </div>
                        <div class="hidden md:block text-sm">
                            <p class="text-white font-semibold group-hover:text-gold-400 transition-colors">{{ app.user ? app.user.nom : 'Admin Tabaany' }}</p>
