            <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-500/5 rounded-full blur-[100px] pointer-events-none"></div>
            <!-- Top Header -->
            <header class="bg-dark-300/80 backdrop-blur-md border-b border-gold-500/10 px-8 py-4 flex justify-between items-center sticky top-0 z-50">
