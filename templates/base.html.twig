                        </div>
                        <i class="fa-solid fa-chevron-down text-gray-500 text-xs group-hover:text-gold-400"></i>

                        <!-- Dropdown Menu -->
                          <div class="absolute right-0 top-full mt-2 w-48 bg-[#0a0a0a] border border-gold-500/20 rounded-xl shadow-2xl py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50 pointer-events-none group-hover:pointer-events-auto before:content-[''] before:absolute before:-top-4 before:left-0 before:w-full before:h-4">
                            <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-4 py-3 text-sm text-red-400 hover:bg-red-500/10 hover:text-red-300 transition-colors">
                                <i class="fa-solid fa-sign-out-alt"></i>
                                Se déconnecter
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <div class="p-8 max-w-7xl mx-auto w-full flex-1 z-10">
                <!-- Flash Messages Overlay -->
                <!-- Add fixed container for toasters top right -->
                <div class="fixed top-24 right-8 z-[100] flex flex-col gap-3 min-w-[320px] max-w-sm pointer-events-none">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="pointer-events-auto p-4 rounded-xl flex items-start gap-4 bg-dark-200/90 backdrop-blur-md border-l-4 shadow-[0_8px_30px_rgba(0,0,0,0.5)] transform transition-all duration-500 hover:scale-[1.02] border-{% if label == 'success' %}green-500{% elseif label == 'danger' %}red-500{% elseif label == 'warning' %}yellow-500{% else %}blue-500{% endif %} animate-[slide-in-right_0.4s_ease-out]">
                            <i class="fa-solid mt-1 {% if label == 'success' %}fa-check-circle text-green-500{% elseif label == 'danger' %}fa-exclamation-circle text-red-500{% else %}fa-info-circle text-blue-500{% endif %} text-xl drop-shadow"></i>
                            <div class="text-gray-200 font-medium text-sm flex-1">{{ message }}</div>
                            <button onclick="this.parentElement.style.opacity='0'; setTimeout(() => this.parentElement.remove(), 300)" class="ml-auto text-gray-500 hover:text-white transition-colors">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                    {% endfor %}
                {% endfor %}
                </div>

                <style>
                    @keyframes slide-in-right {
                        0% { transform: translateX(100%); opacity: 0; }
                        100% { transform: translateX(0); opacity: 1; }
                    }
                </style>

                {% block body %}{% endblock %}
            </div>
            
            <!-- Footer -->
            <footer class="mt-auto border-t border-gold-500/10 py-6 px-8 text-center text-gray-500 text-sm">
                <p>&copy; {{ 'now'|date('Y') }} Tabaany Administration. Tous droits réservés.</p>
            </footer>
        </main>
        
        <script>
            function initThemeManager() {
                const themeToggle = document.getElementById('theme-toggle');
                const htmlElement = document.documentElement;

                if (!themeToggle) return;
                
                // Clone node to prevent multiple event listeners with Turbo
                const newToggle = themeToggle.cloneNode(true);
                themeToggle.parentNode.replaceChild(newToggle, themeToggle);
                const newThemeIcon = document.getElementById('theme-icon');

                // Determine starting icon based on HTML class (set in head script)
                if (htmlElement.classList.contains('light-mode')) {
                    if (newThemeIcon) newThemeIcon.className = 'fa-solid fa-sun text-xl';
                } else {
                    if (newThemeIcon) newThemeIcon.className = 'fa-solid fa-moon text-xl';
                }

                newToggle.addEventListener('click', () => {
                    htmlElement.classList.toggle('light-mode');
                    const isLight = htmlElement.classList.contains('light-mode');
                    
                    if (isLight) {
                        localStorage.setItem('theme', 'light');
                        if (newThemeIcon) newThemeIcon.className = 'fa-solid fa-sun text-xl text-yellow-500';
                    } else {
                        localStorage.setItem('theme', 'dark');
                        if (newThemeIcon) newThemeIcon.className = 'fa-solid fa-moon text-xl';
                    }
                });
            }

            document.addEventListener('turbo:load', initThemeManager);
            document.addEventListener('DOMContentLoaded', initThemeManager);
            if (document.readyState !== 'loading') initThemeManager();
        </script>




