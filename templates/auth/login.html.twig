{% extends 'base.html.twig' %}
{% set hide_topbar = true %}

{% block title %}Connexion - Tabaani{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/auth-premium.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script defer src="{{ asset('auth-premium.js') }}"></script>
{% endblock %}

{% block body %}
<div class="auth-page auth-page-login"
     data-auth-page
     data-requires-totp="{{ requires_totp ? '1' : '0' }}"
     data-totp-check-url="{{ path('app_login_totp_check') }}"
     style="--auth-bg: url('{{ asset('images/tabaani-auth-bg.jpg') }}');">
    <aside class="auth-visual auth-split-left" data-auth-visual>
        <div class="auth-ornaments" aria-hidden="true">
            <span class="auth-orb one"></span>
            <span class="auth-orb two"></span>
            <span class="auth-orb three"></span>
        </div>

            <div class="auth-visual-content">
                <div class="auth-brand-wrap">
                    <strong class="auth-brand-wordmark">Tabaani</strong>
                </div>

            <div class="auth-hero-badge">Travel • Adventure • Exploration</div>

            <h1 class="auth-hero-title">
                <span>Explore the places everyone dreams about.</span>
            </h1>

            <p class="auth-hero-copy">
                Tabaani is your premium travel companion for discovering iconic places, planning seamless escapes,
                and turning inspiration into real journeys with a clean, modern experience.
            </p>

            <div class="auth-hero-stat-row">
                <div class="auth-hero-stat">Curated destinations</div>
                <div class="auth-hero-stat">Smooth booking journey</div>
                <div class="auth-hero-stat">Adventure-first design</div>
            </div>
        </div>
    </aside>

    <section class="auth-panel auth-split-right">
        <div class="auth-card">
            <div class="auth-card-header">
                <h2 class="auth-page-title">Connexion</h2>
                <p class="auth-page-subtitle">Sign in to continue exploring places, saving favorites, and planning your next trip.</p>
            </div>

            {% if error %}
                <div class="auth-flash error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% for socialError in app.flashes('error') %}
                <div class="auth-flash error">{{ socialError }}</div>
            {% endfor %}

            <form method="post" class="auth-form js-validate" novalidate data-auth-form data-auth-login-form>
                <div class="auth-field form-row">
                    <span class="field-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                            <circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="1.8"/>
                        </svg>
                    </span>
                    <input type="text" name="identifier" id="identifier" value="{{ last_username }}" autocomplete="username" data-validate="required|minlength:2" data-label="Identifiant" placeholder=" " required>
                    <label class="auth-label" for="identifier">Nom, email ou numero</label>
                </div>

                <div class="auth-field form-row auth-password">
                    <span class="field-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                            <rect x="3" y="11" width="18" height="10" rx="3" stroke="currentColor" stroke-width="1.8"/>
                            <path d="M7 11V8a5 5 0 0 1 10 0v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                    </span>
                    <div class="password-field auth-input-wrap">
                        <input type="password" name="password" id="password" autocomplete="current-password" data-validate="required|minlength:6" data-label="Mot de passe" placeholder=" " required>
                        <label class="auth-label" for="password">Mot de passe</label>
                    </div>
                </div>

                <input type="hidden" name="totp_code" id="totp_code" value="">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="auth-actions">
                    <button type="submit" class="auth-submit" data-auth-submit>Se connecter</button>
                </div>
            </form>

            <div class="auth-divider" aria-hidden="true"><span>OR</span></div>

            <div class="social-login-grid" aria-label="Social login buttons">
                <a class="social-login-btn google" href="{{ path('app_connect_google') }}">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="M12 10.2v3.9h5.5c-.2 1.2-1.4 3.4-5.5 3.4-3.3 0-6-2.8-6-6.2s2.7-6.2 6-6.2c1.9 0 3.2.8 3.9 1.5l2.6-2.5C17 2.4 14.8 1.5 12 1.5 6.8 1.5 2.6 6 2.6 11.3S6.8 21 12 21c6.9 0 9-4.9 9-7.4 0-.5 0-.9-.1-1.3H12z"/>
                    </svg>
                    Login with Google
                </a>

                <a class="social-login-btn github" href="{{ path('app_connect_github') }}">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.5-4-1.5-.6-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.2 1.9 1.2 1 1.8 2.8 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.4-5.5-6A4.7 4.7 0 0 1 6.4 8a4.4 4.4 0 0 1 .1-3.1s1-.3 3.3 1.2a11.3 11.3 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2a4.4 4.4 0 0 1 .1 3.1 4.7 4.7 0 0 1 1.2 3.2c0 4.6-2.8 5.6-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5z"/>
                    </svg>
                    Login with GitHub
                </a>
            </div>

            <div class="auth-footer">
                <span>Pas de compte ?</span>
                <a href="{{ path('app_signup') }}" class="auth-switch-link" data-auth-switch>
                    Creer un compte <span class="arrow">→</span>
                </a>
            </div>
        </div>
    </section>
</div>

<div class="auth-modal-overlay" data-auth-modal aria-hidden="true">
    <div class="auth-modal" role="dialog" aria-modal="true" aria-labelledby="totp-login-title">
        <div class="auth-modal-header">
            <div>
                <h3 class="auth-modal-title" id="totp-login-title">Verification TOTP</h3>
                <p class="auth-modal-text">Entrez le code genere par votre application d'authentification.</p>
            </div>
            <button type="button" class="auth-modal-close" data-auth-modal-close aria-label="Fermer">×</button>
        </div>
        <input type="text" class="auth-modal-input" data-auth-modal-input inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456">
        <div class="auth-modal-actions">
            <button type="button" class="btn ghost" data-auth-modal-cancel>Annuler</button>
            <button type="button" class="btn solid" data-auth-modal-confirm>Verifier</button>
        </div>
    </div>
</div>
{% endblock %}
