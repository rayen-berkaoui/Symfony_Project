{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="container auth">
    <div class="auth-card">
        <h1 class="gradient-text">Inscription</h1>
        <p class="muted">Renseignez vos informations</p>

        {{ form_start(registrationForm, { attr: { class: 'form js-validate', novalidate: 'novalidate' } }) }}
            <div class="form-grid">
                {{ form_row(registrationForm.nom) }}
                {{ form_row(registrationForm.prenom) }}
            </div>
            {{ form_row(registrationForm.email) }}
            {{ form_row(registrationForm.numTel) }}
            {% set passwordId = registrationForm.plainPassword.vars.id %}
            <div class="form-row">
                {{ form_label(registrationForm.plainPassword) }}
                <div class="password-field">
                    {{ form_widget(registrationForm.plainPassword, {attr: {'data-password-strength': 'true'}}) }}
                </div>
                <div class="password-strength-bar" id="password-strength-{{ passwordId }}" style="display: none;">
                    <div class="strength-indicator"></div>
                    <div class="strength-text"></div>
                </div>
                {{ form_errors(registrationForm.plainPassword) }}
            </div>
            <button type="submit" class="btn solid">Creer le compte</button>
        {{ form_end(registrationForm) }}

        <p class="muted small">Deja un compte? <a href="{{ path('app_login') }}">Se connecter</a></p>
    </div>
</div>
{% endblock %}
