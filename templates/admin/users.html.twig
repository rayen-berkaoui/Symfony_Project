{% extends 'base.html.twig' %}

{% block title %}Manage Users - Tabaany Admin{% endblock %}

{% block stylesheets %}
<style>
    .topbar { display: none; }

    body {
        background:
            radial-gradient(circle at top left, rgba(96, 165, 250, 0.16), transparent 28%),
            radial-gradient(circle at top right, rgba(16, 185, 129, 0.16), transparent 22%),
            linear-gradient(180deg, #0f172a 0%, #111827 18%, #f6f8fc 18%, #eef2ff 100%);
    }

    .admin-shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 280px 1fr;
        color: #0f172a;
    }

    .admin-sidebar {
        position: sticky;
        top: 0;
        min-height: 100vh;
        padding: 2rem 1.5rem;
        background: rgba(15, 23, 42, 0.95);
        color: #e2e8f0;
        border-right: 1px solid rgba(148, 163, 184, 0.18);
        backdrop-filter: blur(16px);
    }

    .brand-mark {
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 0.9rem;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #38bdf8 0%, #22c55e 100%);
        color: white;
        font-weight: 800;
        box-shadow: 0 16px 30px rgba(14, 165, 233, 0.3);
    }

    .admin-brand {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-bottom: 1.75rem;
    }

    .admin-brand h1,
    .panel-header h2,
    .panel-header h3 {
        margin: 0;
    }

    .admin-brand p,
    .muted-copy,
    .sidebar-label,
    .sidebar-link span,
    .sidebar-metric small {
        color: #94a3b8;
    }

    .sidebar-label {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.72rem;
        display: block;
        margin-bottom: 0.9rem;
    }

    .sidebar-links {
        display: grid;
        gap: 0.65rem;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.9rem 1rem;
        border-radius: 1rem;
        text-decoration: none;
        color: #f8fafc;
        background: rgba(148, 163, 184, 0.08);
        border: 1px solid rgba(148, 163, 184, 0.14);
    }

    .sidebar-link strong { display: block; margin-bottom: 0.2rem; }

    .sidebar-metric {
        margin-top: 1rem;
        padding: 1rem;
        border-radius: 1rem;
        background: rgba(15, 23, 42, 0.86);
        border: 1px solid rgba(148, 163, 184, 0.14);
    }

    .sidebar-metric strong {
        display: block;
        color: white;
        font-size: 1.25rem;
    }

    .admin-main {
        padding: 2rem;
    }

    .hero,
    .panel {
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(148, 163, 184, 0.22);
        box-shadow: 0 24px 55px rgba(15, 23, 42, 0.08);
        backdrop-filter: blur(18px);
        border-radius: 1.5rem;
    }

    .hero {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 1.25rem;
        padding: 1.5rem;
        margin-bottom: 1.25rem;
    }

    .hero-copy h2 {
        margin: 0.5rem 0;
        font-size: clamp(2rem, 4vw, 3.25rem);
        line-height: 1.02;
        letter-spacing: -0.05em;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
        background: rgba(37, 99, 235, 0.1);
        color: #1d4ed8;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .hero-actions {
        display: grid;
        gap: 0.9rem;
    }

    .hero-card {
        padding: 1.1rem 1.2rem;
        border-radius: 1rem;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.96), rgba(15, 23, 42, 0.88));
        color: white;
        text-decoration: none;
    }

    .hero-card span { color: #cbd5e1; }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .summary-card {
        padding: 1rem 1.1rem;
        border-radius: 1.1rem;
        background: rgba(255, 255, 255, 0.82);
        border: 1px solid rgba(148, 163, 184, 0.2);
    }

    .summary-card strong {
        display: block;
        font-size: 1.7rem;
        line-height: 1;
        margin-bottom: 0.4rem;
    }

    .summary-card span { color: #64748b; font-size: 0.9rem; }

    .panel {
        padding: 1.35rem;
        margin-bottom: 1.25rem;
    }

    .panel-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .panel-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .btn-admin {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.85rem 1rem;
        border-radius: 0.95rem;
        text-decoration: none;
        font-weight: 700;
    }

    .btn-primary { background: linear-gradient(135deg, #2563eb, #0ea5e9); color: white; }
    .btn-neutral { background: rgba(15, 23, 42, 0.06); color: #0f172a; }

    .filter-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr auto;
        gap: 0.9rem;
        align-items: center;
    }

    .filter-grid input,
    .filter-grid select {
        width: 100%;
        padding: 0.85rem 0.95rem;
        border-radius: 0.9rem;
        border: 1px solid rgba(148, 163, 184, 0.26);
        background: rgba(255, 255, 255, 0.92);
        color: #0f172a;
    }

    .table-shell {
        overflow: hidden;
        border-radius: 1.25rem;
        border: 1px solid rgba(148, 163, 184, 0.18);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: rgba(255, 255, 255, 0.9);
    }

    thead {
        background: rgba(15, 23, 42, 0.04);
    }

    th, td {
        padding: 1rem 0.9rem;
        text-align: left;
        vertical-align: top;
        border-bottom: 1px solid rgba(148, 163, 184, 0.14);
    }

    th {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #64748b;
    }

    tbody tr:hover { background: rgba(59, 130, 246, 0.04); }

    .user-row {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .avatar {
        width: 2.9rem;
        height: 2.9rem;
        border-radius: 1rem;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #1d4ed8, #38bdf8);
        color: white;
        font-weight: 800;
        overflow: hidden;
        flex: 0 0 auto;
    }

    .avatar img { width: 100%; height: 100%; object-fit: cover; }

    .user-name { display: block; font-weight: 700; color: #0f172a; }
    .user-email { display: block; color: #64748b; font-size: 0.88rem; }

    .status-badge,
    .role-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.35rem 0.72rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .status-actif { background: #dcfce7; color: #166534; }
    .status-bloque { background: #fee2e2; color: #991b1b; }
    .status-en_attente { background: #fef3c7; color: #92400e; }

    .role-pill { background: rgba(59, 130, 246, 0.12); color: #1d4ed8; }

    .actions-cell {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        min-width: 220px;
    }

    .actions-row {
        display: flex;
        gap: 0.55rem;
        flex-wrap: wrap;
    }

    .mini-btn,
    .mini-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.68rem 0.9rem;
        border-radius: 0.8rem;
        border: 0;
        text-decoration: none;
        cursor: pointer;
        font-weight: 700;
    }

    .mini-primary { background: linear-gradient(135deg, #2563eb, #0ea5e9); color: white; }
    .mini-danger { background: linear-gradient(135deg, #ef4444, #f97316); color: white; }
    .mini-muted { background: rgba(15, 23, 42, 0.06); color: #0f172a; }

    .mini-select {
        min-width: 140px;
        padding: 0.68rem 0.8rem;
        border-radius: 0.8rem;
        border: 1px solid rgba(148, 163, 184, 0.28);
        background: rgba(255, 255, 255, 0.94);
    }

    .empty-state {
        padding: 3rem 1rem;
        text-align: center;
        color: #64748b;
    }

    @media (max-width: 1280px) {
        .admin-shell,
        .hero,
        .summary-grid,
        .filter-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 900px) {
        .admin-shell {
            grid-template-columns: 1fr;
        }

        .admin-sidebar { min-height: auto; position: relative; }
    }
</style>
{% endblock %}

{% block body %}
<div class="admin-shell">
    <aside class="admin-sidebar">
        <div class="admin-brand">
            <div class="brand-mark">TA</div>
            <div>
                <h1>Tabaany Admin</h1>
                <p>User management</p>
            </div>
        </div>

        <div class="sidebar-section">
            <span class="sidebar-label">Navigation</span>
            <div class="sidebar-links">
                <a class="sidebar-link" href="{{ path('app_admin_dashboard') }}">
                    <div><strong>Overview</strong><small>Live platform snapshot</small></div>
                    <span>01</span>
                </a>
                <a class="sidebar-link" href="{{ path('app_admin_users') }}">
                    <div><strong>Users</strong><small>Search and control accounts</small></div>
                    <span>{{ users|length }}</span>
                </a>
                <a class="sidebar-link" href="{{ path('app_admin_users_export') }}">
                    <div><strong>Export</strong><small>Printable roster</small></div>
                    <span>PDF</span>
                </a>
            </div>
        </div>

        <div class="sidebar-section">
            <span class="sidebar-label">Status snapshot</span>
            <div class="sidebar-metric">
                <strong>{{ users|length }}</strong>
                <small>Filtered users visible in this view</small>
            </div>
        </div>
    </aside>

    <main class="admin-main">
        <section class="hero">
            <div class="hero-copy">
                <span class="eyebrow">Admin user directory</span>
                <h2>Search, block, and promote users from a single workspace.</h2>
                <p class="muted-copy">This view gives you direct account control with the same visual language as the dashboard.</p>
            </div>

            <div class="hero-actions">
                <a href="{{ path('app_admin_dashboard') }}" class="hero-card">
                    <strong>Back to dashboard</strong>
                    <span>Review the full control center.</span>
                </a>
                <a href="{{ path('app_admin_users_export') }}" class="hero-card">
                    <strong>Export user report</strong>
                    <span>Generate the current roster.</span>
                </a>
            </div>
        </section>

        <section class="summary-grid">
            <div class="summary-card"><strong>{{ users|length }}</strong><span>Matching users</span></div>
            <div class="summary-card"><strong>{{ status ?: 'All' }}</strong><span>Status filter</span></div>
            <div class="summary-card"><strong>{{ role ?: 'All' }}</strong><span>Role filter</span></div>
            <div class="summary-card"><strong>{{ sort == 'alpha' ? 'Alphabetical' : 'Newest first' }}</strong><span>Sort mode</span></div>
        </section>

        <section class="panel">
            <div class="panel-header">
                <div>
                    <h3>Filters and search</h3>
                    <p class="muted-copy">Narrow the list by name, status, role, or sort order.</p>
                </div>
                <div class="panel-actions">
                    <a class="btn-admin btn-neutral" href="{{ path('app_admin_users', {sort: sort == 'alpha' ? 'date' : 'alpha', search: search, status: status, role: role}) }}">Toggle sort</a>
                    <a class="btn-admin btn-primary" href="{{ path('app_admin_users_export') }}">Export report</a>
                </div>
            </div>

            <form method="get" class="filter-grid">
                <input type="hidden" name="sort" value="{{ sort }}">
                <input type="text" name="search" value="{{ search }}" placeholder="Search by name, email, or phone">

                <select name="status">
                    <option value="">All statuses</option>
                    <option value="ACTIF" {{ status == 'ACTIF' ? 'selected' : '' }}>Active</option>
                    <option value="BLOQUE" {{ status == 'BLOQUE' ? 'selected' : '' }}>Blocked</option>
                    <option value="EN_ATTENTE" {{ status == 'EN_ATTENTE' ? 'selected' : '' }}>Pending</option>
                </select>

                <select name="role">
                    <option value="">All roles</option>
                    <option value="ADMIN" {{ role == 'ADMIN' ? 'selected' : '' }}>Admin</option>
                    <option value="TOURISTE" {{ role == 'TOURISTE' ? 'selected' : '' }}>Touriste</option>
                </select>

                <button type="submit" class="btn-admin btn-primary">Search</button>
            </form>
        </section>

        <section class="table-shell">
            <table>
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Joined</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>
                                <div class="user-row">
                                    <div class="avatar">
                                        {% if user.profilePicture %}
                                            <img src="{{ user.profilePicture }}" alt="{{ user.nom }} {{ user.prenom }}">
                                        {% else %}
                                            {{ (user.prenom|default('U')|first) ~ (user.nom|default('')|first) }}
                                        {% endif %}
                                    </div>
                                    <div>
                                        <span class="user-name">{{ user.nom }} {{ user.prenom }}</span>
                                        <span class="user-email">{{ user.numTel ?? 'No phone number' }}</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="user-email">{{ user.email }}</span>
                            </td>
                            <td>
                                <span class="role-badge role-pill">{{ user.role ? user.role.nom : 'No role' }}</span>
                            </td>
                            <td>
                                <span class="status-badge status-{{ user.statut|lower }}">{{ user.statut }}</span>
                            </td>
                            <td>{{ user.dateCreation|date('d M Y') }}</td>
                            <td>
                                <div class="actions-cell">
                                    <div class="actions-row">
                                        <a href="{{ path('app_admin_user_view', {id: user.id}) }}" class="mini-link mini-muted">View</a>

                                        <form method="post" action="{{ path('app_admin_user_status', {id: user.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('user_status_' ~ user.id) }}">
                                            <input type="hidden" name="status" value="{{ user.statut == 'BLOQUE' ? 'ACTIF' : 'BLOQUE' }}">
                                            <button type="submit" class="mini-btn {{ user.statut == 'BLOQUE' ? 'mini-primary' : 'mini-danger' }}" {% if user.id == app.user.id %}disabled{% endif %}>
                                                {{ user.statut == 'BLOQUE' ? 'Reactivate' : 'Block' }}
                                            </button>
                                        </form>
                                    </div>

                                    {% if user.id == app.user.id %}
                                        <span class="muted-copy">Current account</span>
                                    {% else %}
                                        <form method="post" action="{{ path('app_admin_user_role', {id: user.id}) }}" class="actions-row">
                                            <input type="hidden" name="_token" value="{{ csrf_token('user_role_' ~ user.id) }}">
                                            <select name="role_id" class="mini-select">
                                                {% for roleOption in availableRoles|default([]) %}
                                                    <option value="{{ roleOption.id }}" {{ user.role and user.role.id == roleOption.id ? 'selected' : '' }}>{{ roleOption.nom }}</option>
                                                {% endfor %}
                                            </select>
                                            <button type="submit" class="mini-btn mini-muted">Update role</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">No users match the current filters.</div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </section>
    </main>
</div>
{% endblock %}