{% extends 'admin/_layout.html.twig' %}
{% block admin_title %}Hashtags{% endblock %}

{% block admin_body %}
    {% for message in app.flashes('success') %}
        <div class="flash flash-success">{{ message }}</div>
    {% endfor %}

    <div class="admin-page-head admin-page-head--row">
        <div>
            <h1 class="admin-page-title">Hashtags</h1>
            <p class="admin-lead admin-lead--tight">{{ total }} hashtag(s) — page {{ page }} / {{ total_pages }}</p>
        </div>
        <p class="admin-lead">Les occurrences sont calculées à partir de l’index des publications.</p>
    </div>

    <form method="post" action="{{ path('app_admin_hashtags') }}" class="admin-hashtag-bar" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token('admin_hashtag_preview') }}">
        <label class="sr-only" for="admin-new-tag">Nouveau hashtag</label>
        <input id="admin-new-tag" type="text" name="hashtag" class="admin-input admin-hashtag-bar__input" placeholder="Nouveau hashtag…" autocomplete="off">
        <button type="submit" class="btn btn-primary">Ajouter</button>
    </form>

    <div class="admin-table-panel">
        <table class="admin-data-table">
            <thead>
                <tr>
                    <th scope="col">Hashtag</th>
                    <th scope="col">Occurrences</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
            {% if rows is empty %}
                <tr><td colspan="3" class="admin-data-table__empty">Aucun contenu dans la table</td></tr>
            {% else %}
                {% for row in rows %}
                    <tr>
                        <td data-label="Hashtag"><strong>#{{ row.tag }}</strong></td>
                        <td data-label="Occurrences">{{ row.count }}</td>
                        <td data-label="Action">
                            <a href="{{ path('app_post_index', { hashtag: row.tag }) }}" class="btn btn-ghost btn--sm" target="_blank" rel="noopener">Voir filtre</a>
                        </td>
                    </tr>
                {% endfor %}
            {% endif %}
            </tbody>
        </table>
    </div>

    <footer class="tbn-pagination" aria-label="Pagination hashtags admin">
        <div class="tbn-pagination__cell tbn-pagination__cell--info">
            <p class="tbn-pagination__info">
                <span class="tbn-pagination__info-label">Affichage</span>
                <span class="tbn-pagination__info-range">{{ display_from }} – {{ display_to }}</span>
                <span class="tbn-pagination__info-sep">sur</span>
                <span class="tbn-pagination__info-total">{{ total }}</span>
            </p>
        </div>
        <div class="tbn-pagination__cell tbn-pagination__cell--per">
            <form method="get" action="{{ path('app_admin_hashtags') }}" class="tbn-pagination__per-form" novalidate>
                <input type="hidden" name="page" value="1">
                <label class="tbn-pagination__per-label" for="admin-hashtags-per-page">Par page</label>
                <div class="tbn-pagination__select-wrap">
                    <select id="admin-hashtags-per-page" name="per_page" class="tbn-pagination__select" onchange="this.form.submit()">
                        {% for n in [10, 20, 50] %}
                            <option value="{{ n }}"{% if per_page == n %} selected{% endif %}>{{ n }}</option>
                        {% endfor %}
                    </select>
                </div>
            </form>
        </div>
        <nav class="tbn-pagination__cell tbn-pagination__cell--nav" aria-label="Pages">
            {% if page > 1 %}
                <a class="tbn-pagination__btn tbn-pagination__btn--prev" href="{{ path('app_admin_hashtags', { page: page - 1, per_page: per_page }) }}">Précédent</a>
            {% else %}
                <span class="tbn-pagination__btn tbn-pagination__btn--prev is-disabled">Précédent</span>
            {% endif %}
            <span class="tbn-pagination__page-indicator"><span class="tbn-pagination__page-label">Page</span> <strong>{{ page }}</strong><span class="tbn-pagination__page-slash">/</span>{{ total_pages }}</span>
            {% if page < total_pages %}
                <a class="tbn-pagination__btn tbn-pagination__btn--next" href="{{ path('app_admin_hashtags', { page: page + 1, per_page: per_page }) }}">Suivant</a>
            {% else %}
                <span class="tbn-pagination__btn tbn-pagination__btn--next is-disabled">Suivant</span>
            {% endif %}
        </nav>
    </footer>
{% endblock %}
