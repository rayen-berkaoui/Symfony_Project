{% extends 'admin/_layout.html.twig' %}
{% block admin_title %}Publications{% endblock %}

{% block admin_body %}
    {% for message in app.flashes('success') %}
        <div class="flash flash-success">{{ message }}</div>
    {% endfor %}

    <div class="admin-page-head admin-page-head--row admin-page-head--split">
        <div>
            <h1 class="admin-page-title">Publications</h1>
            <p class="admin-lead admin-lead--tight">{{ total }} publication(s) — page {{ page }} / {{ total_pages }}</p>
        </div>
        <a href="{{ path('app_admin_export_pdf_posts', { page: page }) }}" class="btn btn-primary btn--sm">PDF (cette page)</a>
    </div>

    <div class="admin-table-panel">
        <table class="admin-data-table">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Contenu</th>
                    <th scope="col">Date</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
            {% if posts is empty %}
                <tr><td colspan="4" class="admin-data-table__empty">Aucun contenu dans la table</td></tr>
            {% else %}
                {% for post in posts %}
                    <tr>
                        <td data-label="ID">{{ post.id }}</td>
                        <td data-label="Contenu" class="admin-data-table__cell-text">{% set c = post.content %}{{ c|length > 120 ? c|slice(0, 117) ~ '…' : c }}</td>
                        <td data-label="Date">{{ post.createdAt|date('d/m/Y H:i') }}</td>
                        <td data-label="Action" class="admin-data-table__actions">
                            <a href="{{ path('app_admin_export_pdf_post', { id: post.id }) }}" class="btn btn-ghost btn--sm">PDF</a>
                            <a href="{{ path('app_post_show', { id: post.id }) }}" class="btn btn-ghost btn--sm" target="_blank" rel="noopener">Voir</a>
                            <form method="post" action="{{ path('app_admin_post_delete', { id: post.id }) }}" class="tbn-inline-form" novalidate data-tbn-confirm="Supprimer cette publication ?">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_post' ~ post.id) }}">
                                <button type="submit" class="btn btn-ghost btn--sm admin-btn-danger">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            {% endif %}
            </tbody>
        </table>
    </div>

    <footer class="tbn-pagination" aria-label="Pagination publications admin">
        <div class="tbn-pagination__cell tbn-pagination__cell--info">
            <p class="tbn-pagination__info">
                <span class="tbn-pagination__info-label">Affichage</span>
                <span class="tbn-pagination__info-range">{{ display_from }} – {{ display_to }}</span>
                <span class="tbn-pagination__info-sep">sur</span>
                <span class="tbn-pagination__info-total">{{ total }}</span>
            </p>
        </div>
        <div class="tbn-pagination__cell tbn-pagination__cell--per">
            <form method="get" action="{{ path('app_admin_posts') }}" class="tbn-pagination__per-form" novalidate>
                <input type="hidden" name="page" value="1">
                <label class="tbn-pagination__per-label" for="admin-posts-per-page">Par page</label>
                <div class="tbn-pagination__select-wrap">
                    <select id="admin-posts-per-page" name="per_page" class="tbn-pagination__select" onchange="this.form.submit()">
                        {% for n in [10, 20, 50] %}
                            <option value="{{ n }}"{% if per_page == n %} selected{% endif %}>{{ n }}</option>
                        {% endfor %}
                    </select>
                </div>
            </form>
        </div>
        <nav class="tbn-pagination__cell tbn-pagination__cell--nav" aria-label="Pages">
            {% if page > 1 %}
                <a class="tbn-pagination__btn tbn-pagination__btn--prev" href="{{ path('app_admin_posts', { page: page - 1, per_page: per_page }) }}">Précédent</a>
            {% else %}
                <span class="tbn-pagination__btn tbn-pagination__btn--prev is-disabled">Précédent</span>
            {% endif %}
            <span class="tbn-pagination__page-indicator"><span class="tbn-pagination__page-label">Page</span> <strong>{{ page }}</strong><span class="tbn-pagination__page-slash">/</span>{{ total_pages }}</span>
            {% if page < total_pages %}
                <a class="tbn-pagination__btn tbn-pagination__btn--next" href="{{ path('app_admin_posts', { page: page + 1, per_page: per_page }) }}">Suivant</a>
            {% else %}
                <span class="tbn-pagination__btn tbn-pagination__btn--next is-disabled">Suivant</span>
            {% endif %}
        </nav>
    </footer>
{% endblock %}
