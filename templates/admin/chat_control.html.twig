{% extends 'admin/_layout.html.twig' %}
{% block admin_title %}Contrôle Chat{% endblock %}

{% block admin_body %}
    {% for message in app.flashes('success') %}
        <div class="flash flash-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="flash flash-warning">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('danger') %}
        <div class="flash flash-danger">{{ message }}</div>
    {% endfor %}

    <div class="admin-page-head admin-page-head--split admin-section">
        <div>
            <h1 class="admin-page-title admin-page-title--xl">Salon &amp; modération</h1>
            <p class="admin-lead admin-lead--tight">Surveillez le flux, diffusez une annonce, supprimez un message ou bloquez un pseudo — mêmes styles que le reste de l’admin.</p>
        </div>
        <div class="admin-page-head__btns">
            <a href="{{ path('app_admin_chat', list_query_params|merge({ page: page, per_page: per_page })) }}" class="btn btn-primary btn--sm" data-turbo="false">Actualiser</a>
            <button type="button" id="tbn-chat-auto-refresh" class="btn btn-ghost btn--sm">Auto 30 s</button>
            <form method="post" action="{{ path('app_admin_chat', list_query_params|merge({ page: page, per_page: per_page })) }}" class="tbn-inline-form" novalidate data-turbo="false" data-tbn-confirm="Supprimer toute la conversation du chat ?">
                <input type="hidden" name="_action" value="purge_all_messages">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_chat_purge_all') }}">
                <button type="submit" class="btn btn-danger btn--sm">Vider la conversation</button>
            </form>
            <a href="{{ path('app_chat_index') }}" class="btn btn-ghost btn--sm" target="_blank" rel="noopener">Salon public</a>
            <a href="{{ path('app_admin_blocked') }}" class="btn btn-ghost btn--sm">Bloqués</a>
        </div>
    </div>

    <ul class="admin-kpi-row admin-section" aria-label="Indicateurs chat">
        <li class="admin-kpi"><span class="admin-kpi__val">{{ total_messages_db }}</span><span class="admin-kpi__lbl">Messages (total)</span></li>
        <li class="admin-kpi"><span class="admin-kpi__val">{{ messages_24h }}</span><span class="admin-kpi__lbl">24 h</span></li>
        <li class="admin-kpi"><span class="admin-kpi__val">{{ messages_7d }}</span><span class="admin-kpi__lbl">7 jours</span></li>
        <li class="admin-kpi"><span class="admin-kpi__val">{{ online_count }}</span><span class="admin-kpi__lbl">En ligne (30 min)</span></li>
        <li class="admin-kpi"><span class="admin-kpi__val">{{ chat_total }}</span><span class="admin-kpi__lbl">Résultat filtre</span></li>
    </ul>

    <div class="admin-chat-layout admin-section">
        <section class="admin-panel admin-chat-layout__main" aria-labelledby="chat-filter-title">
            <h2 id="chat-filter-title" class="admin-subtitle">Filtrer les messages</h2>
            <form method="get" action="{{ path('app_admin_chat') }}" class="admin-chat-filter-form" novalidate data-turbo="false">
                <div class="admin-chat-filter-form__row">
                    <label class="admin-field__label" for="chat-filter-user">Pseudo contient</label>
                    <input type="text" id="chat-filter-user" name="user" value="{{ filter_user }}" class="admin-input" placeholder="ex. alice" autocomplete="off">
                </div>
                <div class="admin-chat-filter-form__row">
                    <label class="admin-field__label" for="chat-filter-q">Texte / pseudo</label>
                    <input type="search" id="chat-filter-q" name="q" value="{{ search_q }}" class="admin-input" placeholder="Recherche dans le contenu ou le pseudo" autocomplete="off">
                </div>
                <div class="admin-chat-filter-form__row admin-chat-filter-form__row--actions">
                    <button type="submit" class="btn btn-primary btn--sm">Appliquer</button>
                    <a href="{{ path('app_admin_chat') }}" class="btn btn-ghost btn--sm" data-turbo="false">Réinitialiser</a>
                </div>
            </form>
        </section>

        <section class="admin-panel admin-chat-layout__side" aria-labelledby="chat-announce-title">
            <h2 id="chat-announce-title" class="admin-subtitle">Annonce officielle</h2>
            <p class="admin-hint">Publiée comme pseudo « Admin », préfixe annonce. Visible après rechargement côté salon.</p>
            <form method="post" action="{{ path('app_admin_chat') }}" class="admin-ban-form" data-turbo="false" novalidate>
                <input type="hidden" name="_token" value="{{ csrf_token('admin_chat_broadcast') }}">
                <label class="admin-field__label" for="bc-msg">Message</label>
                <textarea id="bc-msg" name="message" rows="4" class="admin-input admin-textarea" placeholder="Information importante pour tous les visiteurs du salon…"></textarea>
                <button type="submit" class="btn btn-primary">Diffuser l’annonce</button>
            </form>
        </section>
    </div>

    {% set chat_query = list_query_params|merge({ page: page, per_page: per_page }) %}

    <section class="admin-section" aria-labelledby="chat-table-title">
        <div class="admin-page-head admin-page-head--row">
            <h2 id="chat-table-title" class="admin-page-title">Journal des messages</h2>
            <p class="admin-lead admin-lead--tight">Page {{ page }} / {{ total_pages }} — tri par date décroissante.</p>
        </div>

        <div class="admin-table-panel">
            <table class="admin-data-table admin-data-table--chat">
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col">Pseudo</th>
                        <th scope="col">Contenu</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% if chat_messages is empty %}
                    <tr><td colspan="4" class="admin-data-table__empty">Aucun message pour ces critères.</td></tr>
                {% else %}
                    {% for m in chat_messages %}
                        <tr class="{% if m.userKey == 'Admin' %}admin-data-table__row--highlight{% endif %}">
                            <td data-label="Date">{{ m.createdAt|date('d/m/Y H:i') }}</td>
                            <td data-label="Pseudo"><span class="admin-chat-pill">{{ m.userKey }}</span></td>
                            <td data-label="Contenu" class="admin-data-table__cell-text">{{ m.content|length > 200 ? m.content|slice(0, 197) ~ '…' : m.content }}</td>
                            <td data-label="Actions" class="admin-data-table__actions admin-data-table__actions--stack">
                                <form method="post" action="{{ path('app_admin_chat', chat_query) }}" class="tbn-inline-form" data-turbo="false" novalidate data-tbn-confirm="Supprimer ce message du salon ?">
                                    <input type="hidden" name="_action" value="delete_message">
                                    <input type="hidden" name="message_id" value="{{ m.id }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_chat_message_delete' ~ m.id) }}">
                                    <button type="submit" class="btn btn-ghost btn--sm admin-btn-danger">Supprimer</button>
                                </form>
                                {% if m.userKey != 'Admin' %}
                                <form method="post" action="{{ path('app_admin_chat', chat_query) }}" class="tbn-inline-form" data-turbo="false" novalidate data-tbn-confirm="{{ ('Expulser '~ m.userKey~' du chat ? (blocage chat 30 min)')|e('html_attr') }}">
                                    <input type="hidden" name="_action" value="kick_user">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_chat_kick') }}">
                                    <input type="hidden" name="user_key" value="{{ m.userKey }}">
                                    <button type="submit" class="btn btn-ghost btn--sm">Expulser (Kick)</button>
                                </form>
                                <form method="post" action="{{ path('app_admin_chat', chat_query) }}" class="tbn-inline-form" data-turbo="false" novalidate data-tbn-confirm="{{ ('Bloquer '~ m.userKey~' sur toute la plateforme ?')|e('html_attr') }}">
                                    <input type="hidden" name="_action" value="quick_ban">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_chat_quick_ban') }}">
                                    <input type="hidden" name="user_key" value="{{ m.userKey }}">
                                    <button type="submit" class="btn btn-ghost btn--sm">Blocage rapide</button>
                                </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                {% endif %}
                </tbody>
            </table>
        </div>

        <footer class="tbn-pagination" aria-label="Pagination messages chat">
            <div class="tbn-pagination__cell tbn-pagination__cell--info">
                <p class="tbn-pagination__info">
                    <span class="tbn-pagination__info-label">Affichage</span>
                    <span class="tbn-pagination__info-range">{{ display_from }} – {{ display_to }}</span>
                    <span class="tbn-pagination__info-sep">sur</span>
                    <span class="tbn-pagination__info-total">{{ chat_total }}</span>
                </p>
            </div>
            <div class="tbn-pagination__cell tbn-pagination__cell--per">
                <form method="get" action="{{ path('app_admin_chat') }}" class="tbn-pagination__per-form" novalidate data-turbo="false">
                    {% if filter_user %}<input type="hidden" name="user" value="{{ filter_user }}">{% endif %}
                    {% if search_q %}<input type="hidden" name="q" value="{{ search_q }}">{% endif %}
                    <input type="hidden" name="page" value="1">
                    <label class="tbn-pagination__per-label" for="admin-chat-per-page">Par page</label>
                    <div class="tbn-pagination__select-wrap">
                        <select id="admin-chat-per-page" name="per_page" class="tbn-pagination__select" onchange="this.form.submit()">
                            {% for n in [10, 15, 25, 50] %}
                                <option value="{{ n }}"{% if per_page == n %} selected{% endif %}>{{ n }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </form>
            </div>
            <nav class="tbn-pagination__cell tbn-pagination__cell--nav" aria-label="Pages">
                {% set prev_q = list_query_params|merge({ page: page - 1, per_page: per_page }) %}
                {% set next_q = list_query_params|merge({ page: page + 1, per_page: per_page }) %}
                {% if page > 1 %}
                    <a class="tbn-pagination__btn tbn-pagination__btn--prev" href="{{ path('app_admin_chat', prev_q) }}" data-turbo="false">Précédent</a>
                {% else %}
                    <span class="tbn-pagination__btn tbn-pagination__btn--prev is-disabled">Précédent</span>
                {% endif %}
                <span class="tbn-pagination__page-indicator"><span class="tbn-pagination__page-label">Page</span> <strong>{{ page }}</strong><span class="tbn-pagination__page-slash">/</span>{{ total_pages }}</span>
                {% if page < total_pages %}
                    <a class="tbn-pagination__btn tbn-pagination__btn--next" href="{{ path('app_admin_chat', next_q) }}" data-turbo="false">Suivant</a>
                {% else %}
                    <span class="tbn-pagination__btn tbn-pagination__btn--next is-disabled">Suivant</span>
                {% endif %}
            </nav>
        </footer>
    </section>

    <div class="admin-chat-grid admin-section">
        <section class="admin-panel admin-panel--chat" aria-labelledby="top-sp-title">
            <h2 id="top-sp-title" class="admin-subtitle">Plus actifs (7 j.)</h2>
            {% if top_speakers is empty %}
                <p class="admin-empty">Pas assez d’activité.</p>
            {% else %}
                <ul class="admin-chat-top-list">
                    {% for row in top_speakers %}
                        <li class="admin-chat-top-list__item">
                            <span class="admin-chat-top-list__who">{{ row.user_key }}</span>
                            <span class="admin-chat-top-list__n">{{ row.msg_count }} msg</span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="admin-panel admin-panel--chat admin-panel--wide" aria-labelledby="viol-title">
            <h2 id="viol-title" class="admin-subtitle">Bannissements récents</h2>
            <p class="admin-hint">Pour ajouter ou éditer les portées, utilisez la page <a href="{{ path('app_admin_blocked') }}">Bloqués</a>.</p>
            <div class="admin-table-panel admin-table-panel--nested">
                <table class="admin-data-table admin-data-table--compact">
                    <thead>
                        <tr>
                            <th>Utilisateur</th>
                            <th>Motif</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% if bans is empty %}
                        <tr><td colspan="4" class="admin-data-table__empty">Aucune entrée</td></tr>
                    {% else %}
                        {% for ban in bans %}
                            {% set active = ban.expiresAt is null or ban.expiresAt > date('now') %}
                            <tr>
                                <td>{{ ban.userKey }}</td>
                                <td>{{ ban.reason|default('—') }}</td>
                                <td>
                                    {% if active %}
                                        <span class="admin-badge admin-badge--ban">ACTIF</span>
                                    {% else %}
                                        <span class="admin-badge admin-badge--ok">EXPIRÉ</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <form method="post" action="{{ path('app_admin_blocked') }}" class="tbn-inline-form" data-turbo="false" novalidate data-tbn-confirm="Lever ce bannissement ?">
                                        <input type="hidden" name="_action" value="delete">
                                        <input type="hidden" name="id" value="{{ ban.id }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_chat_ban_delete' ~ ban.id) }}">
                                        <button type="submit" class="btn btn-ghost btn--sm admin-btn-danger">Lever</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
{% endblock %}

{% block body_scripts %}
<script>
(function () {
    var sec = 0;
    var id = null;
    var btn = document.getElementById('tbn-chat-auto-refresh');
    if (!btn) return;
    btn.addEventListener('click', function () {
        if (id) {
            clearInterval(id);
            id = null;
            btn.textContent = 'Auto 30 s';
            btn.classList.remove('is-active');
            return;
        }
        sec = 30;
        btn.classList.add('is-active');
        btn.textContent = 'Auto 30 s (actif)';
        id = window.setInterval(function () {
            window.location.reload();
        }, 30000);
    });
})();
</script>
{% endblock %}
