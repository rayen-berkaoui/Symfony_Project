{% extends 'base.html.twig' %}

{% block title %}Connexion — Administration{% endblock %}

{% block body %}
<div class="admin-login">
    <div class="admin-login__card">
        <h1 class="admin-login__title">Administration</h1>
        <p class="admin-login__hint">Connectez-vous avec le compte administrateur.</p>

        {% if error %}
            <div class="flash flash-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post" action="{{ path('app_admin_login') }}" class="admin-login__form" novalidate>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <label class="admin-field">
                <span class="admin-field__label">E-mail</span>
                <input type="email" name="_username" value="{{ last_username }}" autocomplete="username" autofocus class="admin-input">
            </label>

            <label class="admin-field">
                <span class="admin-field__label">Mot de passe</span>
                <input type="password" name="_password" autocomplete="current-password" class="admin-input">
            </label>

            <button type="submit" class="btn btn-primary admin-login__submit">Se connecter</button>
        </form>

        <p class="admin-login__footer"><a href="{{ path('app_home') }}">← Retour au site</a></p>
    </div>
</div>
{% endblock %}
