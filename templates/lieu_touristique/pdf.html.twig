{% extends 'pdf_layout.html.twig' %}

{% block title %}Détails PDF - {{ lieu_touristique.nom }}{% endblock %}

{% block body %}
    <div style="text-align: center; margin-bottom: 30px;">
        <h1 class="title" style="color: #d4af37; margin-bottom: 5px;">{{ lieu_touristique.nom }}</h1>
        <p style="color: #666; font-size: 14px;"><strong>{{ lieu_touristique.ville }}</strong> - Catégorie: {{ lieu_touristique.categorie ? lieu_touristique.categorie.nomCategorie : 'N/A' }}</p>
    </div>

    <table style="width: 100%; margin-bottom: 30px; border-collapse: collapse;">
        <tr>
            <td style="padding: 15px; border: 1px solid #eee; width: 60%;">
                <h3 style="color: #d4af37; margin-top: 0;">Description</h3>
                <p style="line-height: 1.6; color: #444; text-align: justify;">
                    {{ lieu_touristique.description ?: 'Aucune description fournie.' }}
                </p>
                <div style="margin-top: 20px;">
                    <strong>Prix :</strong> <span style="color: #22c55e; font-weight: bold;">{{ lieu_touristique.prix }} TND</span>
                </div>
            </td>
            <td style="padding: 15px; border: 1px solid #eee; text-align: center; vertical-align: middle; background-color: #f9f9f9;">
                <h3 style="color: #333; margin-top: 0; font-size: 14px;">Scanner pour s'y rendre (GPS)</h3>
                
                {% if pdf_qr_url %}
                    <img src="{{ qr_code_data_uri(pdf_qr_url) }}" alt="QR Code Google Maps" style="width: 130px; height: 130px; border: 2px solid white; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                {% else %}
                    <p style="color: #999; font-style: italic; font-size: 12px;">Pas d'adresse enregistrée</p>
                {% endif %}
                
                <p style="font-size: 10px; color: #666; margin-top: 10px;">
                    Ouvre l'itinéraire dans <strong>Google Maps</strong><br>directement sur votre smartphone.
                </p>
            </td>
        </tr>
    </table>
    
    {% if pdf_image_src %}
        <div style="text-align: center; margin-top: 20px;">
            <h3 style="color: #d4af37; border-bottom: 1px solid #eee; padding-bottom: 5px; text-align: left;">Aperçu Visuel</h3>
            <img src="{{ pdf_image_src }}" style="max-width: 100%; max-height: 400px; border-radius: 8px; border: 1px solid #ddd;">
        </div>
    {% endif %}
{% endblock %}
