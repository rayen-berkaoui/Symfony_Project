{% extends 'base.html.twig' %}

{% block title %}Détails: {{ lieu_touristique.nom }}{% endblock %}

{% block body %}
<div class="mb-6 flex justify-between items-center">
    <h1 class="text-3xl font-bold text-gold-500 drop-shadow-[0_2px_10px_rgba(255,215,0,0.3)]">
        <i class="fa-solid fa-map-location-dot mr-2"></i> {{ lieu_touristique.nom }}
    </h1>
    <div class="space-x-3 flex items-center">
        <a href="{{ path('app_lieu_touristique_pdf', {'id': lieu_touristique.id}) }}" class="btn-dark border border-red-500/50 hover:bg-red-500/20 text-red-400" title="Imprimer le PDF">
            <i class="fa-solid fa-file-pdf mr-2"></i>PDF
        </a>
        <a href="{{ path('app_cart_add', {'id': lieu_touristique.id}) }}" class="btn-gold">
            <i class="fa-solid fa-cart-plus mr-2"></i>Réserver
        </a>
        <a href="{{ path('app_lieu_touristique_index') }}" class="btn-dark">
            <i class="fa-solid fa-arrow-left mr-2"></i>Retour
        </a>
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_lieu_touristique_edit', {'id': lieu_touristique.id}) }}" class="btn-gold"><i class="fa-solid fa-pen mr-2"></i>Modifier</a>
        {% endif %}
    </div>
</div>

<div class="card grid grid-cols-1 md:grid-cols-2 gap-8">
    <div>
        <table class="w-full text-left">
            <tbody>
                <tr class="border-b border-white/5">
                    <th class="py-3 text-gray-400 w-1/3">ID</th>
                    <td class="font-medium text-gold-400">#{{ lieu_touristique.id }}</td>
                </tr>
                <tr class="border-b border-white/5">
                    <th class="py-3 text-gray-400">Nom</th>
                    <td class="font-bold text-lg cursor-default">{{ lieu_touristique.nom }}</td>
                </tr>
                <tr class="border-b border-white/5">
                    <th class="py-3 text-gray-400">Ville</th>
                    <td><i class="fa-solid fa-city mr-2 text-gray-500"></i>{{ lieu_touristique.ville }}</td>
                </tr>
                <tr class="border-b border-white/5">
                    <th class="py-3 text-gray-400">Prix</th>
                    <td class="text-green-400 font-bold">{{ lieu_touristique.prix }} DT</td>
                </tr>
                <tr class="border-b border-white/5">
                    <th class="py-3 text-gray-400">Statut</th>
                    <td>
                        {% if lieu_touristique.statut %}
                            <span class="px-3 py-1 bg-green-500/20 text-green-400 rounded-full text-sm font-semibold border border-green-500/30">Actif</span>
                        {% else %}
                            <span class="px-3 py-1 bg-red-500/20 text-red-400 rounded-full text-sm font-semibold border border-red-500/30">Inactif</span>
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    
    <div>
        {% if aiWeatherAdvice %}
        <div class="mb-6 p-4 bg-gradient-to-br from-indigo-900/40 to-blue-900/40 border border-blue-500/30 rounded-xl shadow-[0_0_15px_rgba(59,130,246,0.15)] relative overflow-hidden">
            <div class="absolute -right-6 -top-6 text-7xl text-blue-500/10"><i class="fa-solid fa-cloud-sun"></i></div>
            <h3 class="text-blue-400 font-bold uppercase tracking-wider text-sm mb-2 flex items-center gap-2">
                <i class="fa-solid fa-robot animate-pulse"></i> Conseil MÃ©tÃ©o IA
            </h3>
            <p class="text-white text-sm leading-relaxed relative z-10">{{ aiWeatherAdvice.conseil }}</p>
            <div class="mt-3 inline-block px-3 py-1 bg-black/30 rounded-full text-xs text-blue-200 border border-white/5 font-semibold">
                <i class="fa-solid fa-temperature-half mr-1"></i> MÃ©tÃ©o actuelle : {{ aiWeatherAdvice.meteo }}
            </div>
        </div>
        {% endif %}

        <h3 class="text-gold-500 font-bold uppercase tracking-wider text-sm mb-3 border-b border-white/10 pb-2">Description</h3>
        <p class="text-gray-300 leading-relaxed mb-6">{{ lieu_touristique.description ?: 'Aucune description fournie.' }}</p>
        
        <h3 class="text-gold-500 font-bold uppercase tracking-wider text-sm mb-3 border-b border-white/10 pb-2">Image</h3>
        {% if lieu_touristique.image %}
            {% set imagePath = lieu_touristique.image %}
            {% set normalizedPath = imagePath|replace({'\\': '/'}) %}
            {% if normalizedPath starts with 'public/' %}
                {% set normalizedPath = normalizedPath|slice(7) %}
            {% endif %}
            {% if normalizedPath starts with 'http://' or normalizedPath starts with 'https://' %}
                {% set imageSrc = normalizedPath %}
            {% elseif normalizedPath starts with '/' %}
                {% set imageSrc = normalizedPath %}
            {% elseif normalizedPath starts with 'uploads/' %}
                {% set imageSrc = asset(normalizedPath) %}
            {% else %}
                {% set imageSrc = asset('uploads/lieux/' ~ normalizedPath) %}
            {% endif %}
            <div class="bg-dark-200 border border-white/10 rounded-lg p-2 overflow-hidden">
                <img
                    src="{{ imageSrc }}"
                    alt="Image de {{ lieu_touristique.nom }}"
                    class="w-full h-64 object-cover rounded-md"
                    loading="lazy"
                >
            </div>
                {% else %}
            <p class="text-gray-500 italic">Pas d'image.</p>
        {% endif %}

                {% if lieu_touristique.adresse %}
        <h3 class="text-gold-500 font-bold uppercase tracking-wider text-sm mt-8 mb-3 border-b border-white/10 pb-2">VUE SATELLITE & CARTE (GRATUIT)</h3>
        
        <div class="bg-dark-200 border border-white/10 rounded-lg p-2 shadow-[0_0_15px_rgba(255,215,0,0.1)] relative" style="height: 350px; z-index: 0;">
            <div id="map-explore" data-lat="{{ lieu_touristique.adresse.latitude|number_format(8, '.', '')|default('0') }}" data-lng="{{ lieu_touristique.adresse.longitude|number_format(8, '.', '')|default('0') }}" style="width: 100%; height: 100%; border-radius: 6px; z-index: 10;"></div>
        </div>
        
        <div class="mt-4 flex justify-end space-x-3">
            <a href="https://www.google.com/maps/search/?api=1&query={{ lieu_touristique.adresse.latitude }},{{ lieu_touristique.adresse.longitude }}" target="_blank" class="px-4 py-2 bg-blue-600/20 text-blue-400 border border-blue-500/50 rounded hover:bg-blue-600/40 hover:text-blue-300 text-sm font-semibold transition-colors">
                <i class="fa-solid fa-map-location-dot mr-1"></i> Voir sur Google Maps
            </a>
            
            <a href="https://www.google.com/maps/@?api=1&map_action=pano&viewpoint={{ lieu_touristique.adresse.latitude }},{{ lieu_touristique.adresse.longitude }}" target="_blank" class="px-4 py-2 bg-green-600/20 text-green-400 border border-green-500/50 rounded hover:bg-green-600/40 hover:text-green-300 text-sm font-semibold transition-colors">
                <i class="fa-solid fa-street-view mr-1"></i> Ouvrir Street View 360°
            </a>
        </div>
        
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
        
        <script>
            (function() {
                function initMapExplore() {
                    const mapContainer = document.getElementById('map-explore');
                    if (!mapContainer || mapContainer.innerHTML !== "") return;
                    
                    const lat = parseFloat(mapContainer.getAttribute('data-lat'));
                    const lng = parseFloat(mapContainer.getAttribute('data-lng'));
                    
                    const map = L.map('map-explore').setView([lat, lng], 17);
                    
                    const osm = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19,
                        attribution: ' OpenStreetMap'
                    });
                    
                    const satellite = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                        maxZoom: 19,
                        attribution: ' Esri'
                    });

                    // Par défaut, afficher le Satellite pour le côté impressionnant
                    satellite.addTo(map);
                    
                    L.control.layers({
                        "Plan (OpenStreetMap)": osm,
                        "Satellite (Esri HD)": satellite
                    }).addTo(map);

                    const icon = L.divIcon({
                        html: '<i class="fa-solid fa-location-dot text-red-500 text-4xl drop-shadow-md"></i>',
                        iconSize: [24, 36],
                        iconAnchor: [12, 36],
                        popupAnchor: [0, -36],
                        className: 'custom-div-icon bg-transparent border-0'
                    });

                    L.marker([lat, lng], {icon: icon}).addTo(map)
                        .bindPopup("<div class='text-center p-2'><b class='text-gold-500'>{{ lieu_touristique.nom|e('js') }}</b><br><span class='text-xs text-gray-500'>{{ lieu_touristique.ville|e('js') }}</span></div>")
                        .openPopup();
                }
                
                if (!window.leafletListenerAdded) {
                    document.addEventListener('turbo:load', initMapExplore);
                    window.leafletListenerAdded = true;
                }
                
                if (document.readyState === 'complete' || document.readyState === 'interactive') {
                    initMapExplore();
                } else {
                    document.addEventListener('DOMContentLoaded', initMapExplore);
                }
            })();
        </script>
        {% endif %}

        
        {% if is_granted('ROLE_ADMIN') %}
        <div class="mt-8 pt-6 border-t border-red-500/20 text-right">
            {{ include('lieu_touristique/_delete_form.html.twig') }}
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}





