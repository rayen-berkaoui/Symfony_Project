{% extends 'base.html.twig' %}

{% block title %}Détails: {{ lieu_touristique.nom }}{% endblock %}

{% block body %}
<div class="mb-6 flex justify-between items-center">
    <h1 class="text-3xl font-bold text-gold-500 drop-shadow-[0_2px_10px_rgba(255,215,0,0.3)]">
        <i class="fa-solid fa-map-location-dot mr-2"></i> {{ lieu_touristique.nom }}
    </h1>
    <div class="space-x-3 flex">        <a href="{{ path('app_cart_add', {'id': lieu_touristique.id}) }}" class="btn-gold"><i class="fa-solid fa-cart-plus mr-2"></i>Réserver</a>        <a href="{{ path('app_lieu_touristique_index') }}" class="btn-dark"><i class="fa-solid fa-arrow-left mr-2"></i>Retour</a>
        <a href="{{ path('app_lieu_touristique_edit', {'id': lieu_touristique.id}) }}" class="btn-gold"><i class="fa-solid fa-pen mr-2"></i>Modifier</a>
    </div>
</div>

<div class="card grid grid-cols-1 md:grid-cols-2 gap-8">
    <div>
        <table class="w-full text-left">
            <tbody>
                <tr class="border-b border-white/5">
                    <th class="py-3 text-gray-400 w-1/3">ID</th>
                    <td class="font-medium text-gold-400">#{{ lieu_touristique.id }}</td>
                </tr>
                <tr class="border-b border-white/5">
                    <th class="py-3 text-gray-400">Nom</th>
                    <td class="font-bold text-lg cursor-default">{{ lieu_touristique.nom }}</td>
                </tr>
                <tr class="border-b border-white/5">
                    <th class="py-3 text-gray-400">Ville</th>
                    <td><i class="fa-solid fa-city mr-2 text-gray-500"></i>{{ lieu_touristique.ville }}</td>
                </tr>
                <tr class="border-b border-white/5">
                    <th class="py-3 text-gray-400">Prix</th>
                    <td class="text-green-400 font-bold">{{ lieu_touristique.prix }} DT</td>
                </tr>
                <tr class="border-b border-white/5">
                    <th class="py-3 text-gray-400">Statut</th>
                    <td>
                        {% if lieu_touristique.statut %}
                            <span class="px-3 py-1 bg-green-500/20 text-green-400 rounded-full text-sm font-semibold border border-green-500/30">Actif</span>
                        {% else %}
                            <span class="px-3 py-1 bg-red-500/20 text-red-400 rounded-full text-sm font-semibold border border-red-500/30">Inactif</span>
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    
    <div>
        <h3 class="text-gold-500 font-bold uppercase tracking-wider text-sm mb-3 border-b border-white/10 pb-2">Description</h3>
        <p class="text-gray-300 leading-relaxed mb-6">{{ lieu_touristique.description ?: 'Aucune description fournie.' }}</p>
        
        <h3 class="text-gold-500 font-bold uppercase tracking-wider text-sm mb-3 border-b border-white/10 pb-2">Image</h3>
        {% if lieu_touristique.image %}
            {% set imagePath = lieu_touristique.image %}
            {% set normalizedPath = imagePath|replace({'\\': '/'}) %}
            {% if normalizedPath starts with 'public/' %}
                {% set normalizedPath = normalizedPath|slice(7) %}
            {% endif %}
            {% if normalizedPath starts with 'http://' or normalizedPath starts with 'https://' %}
                {% set imageSrc = normalizedPath %}
            {% elseif normalizedPath starts with '/' %}
                {% set imageSrc = normalizedPath %}
            {% elseif normalizedPath starts with 'uploads/' %}
                {% set imageSrc = asset(normalizedPath) %}
            {% else %}
                {% set imageSrc = asset('uploads/lieux/' ~ normalizedPath) %}
            {% endif %}
            <div class="bg-dark-200 border border-white/10 rounded-lg p-2 overflow-hidden">
                <img
                    src="{{ imageSrc }}"
                    alt="Image de {{ lieu_touristique.nom }}"
                    class="w-full h-64 object-cover rounded-md"
                    loading="lazy"
                >
            </div>
        {% else %}
            <p class="text-gray-500 italic">Pas d'image.</p>
        {% endif %}
        
        <div class="mt-8 pt-6 border-t border-red-500/20 text-right">
            {{ include('lieu_touristique/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
