{% extends 'base.html.twig' %}

{% block title %}Modifier Lieu Touristique{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto space-y-8 animate-fade-in-up">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl sm:text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-gold-600 drop-shadow-[0_2px_10px_rgba(255,215,0,0.3)] flex items-center">
                Modifier le Lieu
            </h1>
            <p class="text-gray-400 mt-2 font-medium">Mise à jour des informations pour <span class="text-gold-500 font-bold">"{{ lieu_touristique.nom }}"</span></p>
        </div>
        <div class="flex items-center gap-3">
            <a href="{{ path('app_lieu_touristique_index') }}" class="btn-dark px-5 py-2.5 rounded-xl border border-white/5 hover:border-gold-500/30 hover:bg-dark-300 transition-all shadow-md group">
                <i class="fa-solid fa-arrow-left mr-2 group-hover:-translate-x-1 transition-transform"></i>Retour
            </a>
            {{ include('lieu_touristique/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="bg-dark-200/50 backdrop-blur-xl border border-white/10 rounded-3xl p-6 sm:p-10 shadow-[0_8px_30px_rgb(0,0,0,0.4)] relative overflow-hidden">
        <!-- Floating decorative orbs -->
        <div class="absolute -top-32 -right-32 w-64 h-64 bg-gold-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-32 -left-32 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10">
            {{ include('lieu_touristique/_form.html.twig', {'button_label': 'Mettre à jour le lieu'}) }}
        </div>
    </div>
</div>
{% endblock %}
