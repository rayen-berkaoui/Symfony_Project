{% extends 'base.html.twig' %}

{% block title %}Assistant IA - Recommandations Touristiques{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto flex flex-col h-[calc(100vh-140px)] animate-[fade-in_0.5s_ease-out]">
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-indigo-600 drop-shadow-[0_2px_10px_rgba(139,92,246,0.3)]">
                <i class="fa-solid fa-sparkles text-purple-500 mr-2"></i>Assistant IA
            </h1>
            <p class="text-gray-400 mt-1">Trouvez la destination parfaite selon vos envies.</p>
        </div>
        <a href="{{ path('app_lieu_touristique_index') }}" class="btn-dark p-2 text-sm rounded-xl">
            <i class="fa-solid fa-arrow-left mr-2"></i>Retour
        </a>
    </div>

    <!-- Interface Chat -->
    <div class="flex-1 bg-dark-200/50 backdrop-blur-md border border-white/5 rounded-2xl flex flex-col shadow-[0_8px_30px_rgba(0,0,0,0.5)] overflow-hidden">
        
        <!-- Zone des messages -->
        <div id="chat-messages" class="flex-1 p-6 overflow-y-auto flex flex-col gap-6 custom-scrollbar">
            <!-- Message de bienvenue -->
            <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-indigo-700 shadow-[0_0_15px_rgba(139,92,246,0.4)] flex items-center justify-center flex-shrink-0">
                    <i class="fa-solid fa-robot text-white"></i>
                </div>
                <div class="bg-dark-300 border border-purple-500/20 p-4 rounded-2xl rounded-tl-none max-w-[80%] shadow-lg">
                    <p class="text-gray-200">Bonjour ! Je suis votre guide touristique virtuel. Que recherchez-vous aujourd'hui ? Plage, désert, culture, aventure, ou peut-être un petit budget ? Je connais tous nos lieux !</p>
                </div>
            </div>
        </div>

        <!-- Input Area -->
        <div class="p-4 bg-dark-300/80 border-t border-white/5 backdrop-blur-xl">
            <form id="chat-form" class="relative flex items-center gap-3">
                <input type="text" id="chat-input" placeholder="Ex: Je cherche une aventure dans le sud avec un petit budget..." required
                    class="flex-1 bg-dark-400 text-white border border-purple-500/30 rounded-xl px-5 py-3 pr-12 focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all placeholder-gray-500">
                <button type="submit" id="chat-submit"
                    class="absolute right-4 text-purple-400 hover:text-purple-300 transition-colors">
                    <i class="fa-solid fa-paper-plane text-xl hover:scale-110 transition-transform"></i>
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .message-user .content-bubble {
        background: linear-gradient(135deg, rgba(251, 191, 36, 0.1), rgba(255, 215, 0, 0.05));
        border: 1px solid rgba(255, 215, 0, 0.2);
        color: #fff;
        border-radius: 1rem 1rem 0 1rem;
    }
    .message-ai .content-bubble {
        background: #121212;
        border: 1px solid rgba(139, 92, 246, 0.2);
        color: #e5e5e5;
        border-radius: 1rem 1rem 1rem 0;
    }
</style>

<script>
document.addEventListener('turbo:load', function() {
    const form = document.getElementById('chat-form');
    const input = document.getElementById('chat-input');
    const messagesWrap = document.getElementById('chat-messages');
    
    if (!form) return;

    function addMessage(text, isUser) {
        const div = document.createElement('div');
        div.className = `flex items-end gap-4 ${isUser ? 'flex-row-reverse message-user' : 'message-ai animate-[fade-in_0.3s_ease-out]'}`;
        
        let avatar = '';
        if (isUser) {
            avatar = `<div class="w-8 h-8 rounded-full bg-gradient-to-tr from-gold-400 to-amber-600 flex items-center justify-center text-black font-bold shadow-inner flex-shrink-0 text-xs">U</div>`;
        } else {
            avatar = `<div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-indigo-700 shadow-[0_0_15px_rgba(139,92,246,0.4)] flex items-center justify-center flex-shrink-0"><i class="fa-solid fa-robot text-white"></i></div>`;
        }

        // Format strong tags for AI
        let formattedText = text.replace(/\*\*(.*?)\*\*/g, '<strong class="text-gold-400">$1</strong>');
        formattedText = formattedText.replace(/\n/g, '<br>');

        div.innerHTML = `
            ${avatar}
            <div class="content-bubble p-4 max-w-[80%] shadow-lg">
                <p class="text-sm md:text-base leading-relaxed">${formattedText}</p>
            </div>
        `;
        messagesWrap.appendChild(div);
        messagesWrap.scrollTop = messagesWrap.scrollHeight;
    }

    function addLoader() {
        const id = 'loader-' + Date.now();
        const div = document.createElement('div');
        div.id = id;
        div.className = `flex items-end gap-4 message-ai animate-[fade-in_0.3s_ease-out]`;
        div.innerHTML = `
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-indigo-700 border border-purple-500/50 flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-robot text-white"></i>
            </div>
            <div class="content-bubble p-4 max-w-[80%] shadow-lg flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-purple-500 animate-bounce" style="animation-delay: 0s"></div>
                <div class="w-2 h-2 rounded-full bg-purple-500 animate-bounce" style="animation-delay: 0.2s"></div>
                <div class="w-2 h-2 rounded-full bg-purple-500 animate-bounce" style="animation-delay: 0.4s"></div>
            </div>
        `;
        messagesWrap.appendChild(div);
        messagesWrap.scrollTop = messagesWrap.scrollHeight;
        return id;
    }

    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        const msg = input.value.trim();
        if (!msg) return;

        addMessage(msg, true);
        input.value = '';
        const loaderId = addLoader();

        try {
            const formData = new FormData();
            formData.append('prompt', msg);
            
            const req = await fetch('{{ path("app_lieu_touristique_ai_api") }}', {
                method: 'POST',
                body: formData
            });
            const res = await req.json();
            
            document.getElementById(loaderId).remove();
            
            if (res.success) {
                addMessage(res.answer, false);
            } else {
                addMessage("Désolé, il y a eu un problème : " + res.error, false);
            }
        } catch (err) {
            document.getElementById(loaderId).remove();
            addMessage("Erreur de connexion à l'intelligence artificielle.", false);
        }
    });
});
</script>
{% endblock %}