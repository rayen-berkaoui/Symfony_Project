{% extends 'base.html.twig' %}

{% block title %}Lieux Touristiques{% endblock %}

{% block body %}
<div class="mb-10 flex flex-col md:flex-row md:items-start justify-between gap-4 animate-[fade-in_0.5s_ease-out]">
    <div>
        <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-yellow-600 mb-2 drop-shadow-[0_4px_15px_rgba(255,215,0,0.4)]">Lieux Touristiques</h1>
        <p class="text-gray-400 text-lg">Gérez les destinations et sites touristiques de votre catalogue.</p>
    </div>
    
    <div class="flex flex-col sm:flex-row gap-3">
        <form method="get" action="{{ path('app_lieu_touristique_index') }}" class="flex relative group">
            <input type="text" name="search" value="{{ searchQuery }}" placeholder="Rechercher un lieu..." class="bg-dark-300 text-white border border-gold-500/20 rounded-l-xl px-4 py-2.5 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 w-full sm:w-64 transition-all">
            <button type="submit" class="bg-gradient-to-r from-dark-200 to-dark-300 hover:from-gold-500/20 hover:to-dark-200 text-gold-400 px-4 py-2.5 rounded-r-xl border border-l-0 border-gold-500/20 transition-all">
                <i class="fa-solid fa-search"></i>
            </button>
        </form>
        
        <div class="flex gap-3">
            <a href="{{ path('app_lieu_touristique_pdf') }}" target="_blank" class="group flex items-center justify-center gap-2 bg-gradient-to-r from-red-600/20 to-red-600/10 hover:from-red-500 hover:to-red-600 border border-red-500/30 hover:border-transparent px-4 py-2.5 rounded-xl text-red-400 hover:text-white transition-all duration-300 shadow-[0_0_15px_rgba(239,68,68,0.1)] hover:shadow-[0_4px_20px_rgba(239,68,68,0.4)]" title="Exporter en PDF">
                <i class="fa-solid fa-file-pdf text-lg transition-transform group-hover:-translate-y-0.5"></i>
                <span class="font-semibold hidden sm:inline">PDF</span>
            </a>
            <a href="{{ path('app_lieu_touristique_new') }}" class="group flex items-center justify-center gap-2 bg-gradient-to-r from-gold-500 to-yellow-600 hover:from-gold-400 hover:to-yellow-500 text-black px-5 py-2.5 rounded-xl transition-all duration-300 shadow-[0_0_15px_rgba(255,215,0,0.3)] hover:shadow-[0_4px_20px_rgba(255,215,0,0.5)] whitespace-nowrap font-bold">
                <i class="fa-solid fa-plus text-lg transition-transform group-hover:rotate-90"></i>
                <span>Nouveau</span>
            </a>
        </div>
    </div>
</div>

<div class="card bg-gradient-to-br from-dark-300 to-black shadow-[0_8px_30px_rgba(0,0,0,0.5)] border-gold-500/10 relative overflow-hidden animate-[fade-in_0.5s_ease-out]">
    <div class="absolute -right-20 -top-20 w-64 h-64 bg-gold-500/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="flex flex-col sm:flex-row justify-between items-center sm:items-start mb-4 gap-4">
        <div class="text-gray-400 text-sm flex gap-3 items-center">
            <span class="text-gold-500 font-semibold"><i class="fa-solid fa-sort mr-1"></i> Trier par :</span>
            <div class="flex gap-2">
                <span class="hover:text-white transition">{{ knp_pagination_sortable(lieu_touristiques, 'Nom', 'l.nom') }}</span> |
                <span class="hover:text-white transition">{{ knp_pagination_sortable(lieu_touristiques, 'Prix', 'l.prix') }}</span> |
                <span class="hover:text-white transition">{{ knp_pagination_sortable(lieu_touristiques, 'Ville', 'l.ville') }}</span>
            </div>
        </div>
        <div class="flex items-center gap-2 mt-2 sm:mt-0">
            <button type="button" class="btn-dark px-3 py-2" data-carousel-prev="lieu-carousel" aria-label="Précédent">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button type="button" class="btn-dark px-3 py-2" data-carousel-next="lieu-carousel" aria-label="Suivant">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>
    </div>

    {% if lieu_touristiques is empty %}
        <p class="text-center py-8 text-gray-500">Aucun lieu touristique trouvé.</p>
    {% else %}
        <div id="lieu-carousel" class="flex gap-5 overflow-x-auto pb-3 snap-x snap-mandatory scroll-smooth">
            {% for lieu_touristique in lieu_touristiques %}
                {% set imagePath = lieu_touristique.image %}
                {% set normalizedPath = imagePath ? imagePath|replace({'\\': '/'}) : null %}
                {% if normalizedPath and normalizedPath starts with 'public/' %}
                    {% set normalizedPath = normalizedPath|slice(7) %}
                {% endif %}
                {% if normalizedPath and (normalizedPath starts with 'http://' or normalizedPath starts with 'https://') %}
                    {% set imageSrc = normalizedPath %}
                {% elseif normalizedPath and normalizedPath starts with '/' %}
                    {% set imageSrc = normalizedPath %}
                {% elseif normalizedPath and normalizedPath starts with 'uploads/' %}
                    {% set imageSrc = asset(normalizedPath) %}
                {% elseif normalizedPath %}
                    {% set imageSrc = asset('uploads/lieux/' ~ normalizedPath) %}
                {% else %}
                    {% set imageSrc = null %}
                {% endif %}

                <article class="min-w-[88vw] sm:min-w-[500px] lg:min-w-[560px] max-w-[88vw] sm:max-w-[500px] lg:max-w-[560px] snap-start bg-gradient-to-b from-dark-200 to-dark-300 border border-white/5 hover:border-gold-500/30 rounded-2xl overflow-hidden flex flex-col group transition-all duration-500 hover:-translate-y-2 shadow-[0_4px_15px_rgba(0,0,0,0.5)]">
                    <div class="h-56 sm:h-64 bg-black/60 p-2 flex items-center justify-center relative overflow-hidden">
                        <div class="absolute inset-0 bg-gold-500/10 group-hover:bg-transparent transition-colors z-10 pointer-events-none"></div>
                        {% if imageSrc %}
                            <img src="{{ imageSrc }}" alt="Image de {{ lieu_touristique.nom }}" class="w-full h-full object-contain rounded-xl z-0 transition-transform duration-700 group-hover:scale-105" loading="lazy">
                        {% else %}
                            <div class="w-full h-full flex flex-col items-center justify-center text-gray-600">
                                <i class="fa-solid fa-image text-3xl mb-2 opacity-50"></i>
                                <span class="text-sm font-medium">Image non disponible</span>
                            </div>
                        {% endif %}
                    </div>

                    <div class="p-6 flex-1 flex flex-col relative">
                        <div class="flex items-center justify-between mb-4">
                            <span class="text-gold-500/70 font-bold text-xs uppercase tracking-widest bg-gold-500/10 px-3 py-1 rounded-full border border-gold-500/20">Ref #{{ lieu_touristique.id }}</span>
                            {% if lieu_touristique.statut %}
                                <span class="px-3 py-1 bg-green-500/10 text-green-400 font-semibold rounded-full text-xs border border-green-500/20 flex items-center gap-1.5 shadow-[0_0_10px_rgba(34,197,94,0.1)]"><div class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></div> Actif</span>
                            {% else %}
                                <span class="px-3 py-1 bg-red-500/10 text-red-400 font-semibold rounded-full text-xs border border-red-500/20 flex items-center gap-1.5 shadow-[0_0_10px_rgba(239,68,68,0.1)]"><div class="w-1.5 h-1.5 bg-red-500 rounded-full"></div> Inactif</span>
                            {% endif %}
                        </div>

                        <h2 class="text-2xl font-black text-white mb-2 group-hover:text-gold-400 transition-colors drop-shadow">{{ lieu_touristique.nom }}</h2>
                        <p class="text-sm text-gray-400 mb-4 font-medium"><i class="fa-solid fa-location-dot mr-2 text-gold-500/50"></i>{{ lieu_touristique.ville ?: 'Localisation inconnue' }}</p>
                        
                        <div class="flex items-center justify-between mt-auto pt-4 border-t border-white/5">
                            <p class="text-white font-black text-xl"><span class="text-gold-500 text-sm font-medium mr-1">DT</span>{{ lieu_touristique.prix ?: '0.00' }}</p>

                            <div class="flex gap-2">
                                <a href="{{ path('app_lieu_touristique_show', {'id': lieu_touristique.id}) }}" class="w-10 h-10 rounded-xl bg-dark-200 hover:bg-gold-500/20 text-gray-400 hover:text-gold-400 flex items-center justify-center border border-white/5 transition-all duration-300 hover:border-gold-500/30" title="Voir plus">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <a href="{{ path('app_lieu_touristique_edit', {'id': lieu_touristique.id}) }}" class="w-10 h-10 rounded-xl bg-dark-200 hover:bg-blue-500/20 text-gray-400 hover:text-blue-400 flex items-center justify-center border border-white/5 transition-all duration-300 hover:border-blue-500/30" title="Modifier">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
        
        <div class="mt-6 flex justify-center">
            {{ knp_pagination_render(lieu_touristiques) }}
        </div>
    {% endif %}
</div>

<script>
    document.querySelectorAll('[data-carousel-prev], [data-carousel-next]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-carousel-prev') || btn.getAttribute('data-carousel-next');
            const target = document.getElementById(id);
            if (!target) return;
            const step = target.clientWidth * 0.8;
            const direction = btn.hasAttribute('data-carousel-next') ? 1 : -1;
            target.scrollBy({ left: direction * step, behavior: 'smooth' });
        });
    });
</script>

<style>
    /* Custom Scrollbar for Carousel */
    .snap-x::-webkit-scrollbar {
        height: 12px;
    }
    .snap-x::-webkit-scrollbar-track {
        background: rgba(30, 41, 59, 0.5); /* dark-200 / slate-800 equivalent */
        border-radius: 9999px;
    }
    .snap-x::-webkit-scrollbar-thumb {
        background: linear-gradient(to right, #fbbf24, #b45309); /* gold gradient */
        border-radius: 9999px;
        border: 3px solid rgba(15, 23, 42, 1); /* dark-300 / slate-900 border to create padding effect */
    }
    .snap-x::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(to right, #f59e0b, #92400e);
    }
</style>
{% endblock %}
