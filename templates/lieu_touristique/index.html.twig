{% extends 'base.html.twig' %}

{% block title %}Lieux Touristiques{% endblock %}

{% block body %}
<div class="mb-8 flex flex-col 2xl:flex-row 2xl:items-start justify-between gap-4 animate-[fade-in_0.5s_ease-out]">
    <div class="flex-shrink-0">
        <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-yellow-600 mb-2 drop-shadow-[0_4px_15px_rgba(255,215,0,0.4)]">Lieux Touristiques</h1>
        <p class="text-gray-400 text-lg">GÃƒÂ©rez les destinations et sites touristiques de votre catalogue.</p>
    </div>

    <div class="flex flex-col items-end gap-3 w-full 2xl:w-auto">
        <!-- Action Buttons -->
        <div class="flex flex-row gap-3">
            <a href="{{ path('app_lieu_touristique_ai') }}" class="group flex items-center justify-center gap-2 bg-gradient-to-r from-purple-600/20 to-purple-600/10 hover:from-purple-500 hover:to-indigo-600 border border-purple-500/30 hover:border-transparent px-4 py-2 rounded-xl text-purple-400 hover:text-white transition-all duration-300 shadow-[0_0_15px_rgba(139,92,246,0.1)] hover:shadow-[0_4px_20px_rgba(139,92,246,0.4)] text-sm whitespace-nowrap" title="Assistant IA">    
                <i class="fa-solid fa-sparkles text-base transition-transform group-hover:scale-110"></i>
                <span class="font-semibold hidden sm:inline">IA Assistant</span>
            </a>
            
            {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_lieu_touristique_new') }}" class="group flex items-center justify-center gap-2 bg-gradient-to-r from-gold-500 to-yellow-600 hover:from-gold-400 hover:to-yellow-500 text-black px-4 py-2 rounded-xl transition-all duration-300 shadow-[0_0_15px_rgba(255,215,0,0.3)] hover:shadow-[0_4px_20px_rgba(255,215,0,0.5)] whitespace-nowrap font-bold text-sm">
                <i class="fa-solid fa-plus text-base transition-transform group-hover:rotate-90"></i>
                <span>Nouveau</span>
            </a>
            {% endif %}
        </div>

        <!-- Advanced Search Filters (Compact) -->
        <div class="bg-dark-300/40 p-2.5 rounded-xl border border-white/10 backdrop-blur-md w-full 2xl:w-max mt-2">
            <form method="get" action="{{ path('app_lieu_touristique_index') }}" class="flex flex-wrap items-center justify-end gap-2.5 text-sm">
                <div class="flex-grow min-w-[150px] relative group">
                    <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                    <input type="text" name="search" value="{{ searchQuery }}" placeholder="Rechercher..." class="text-sm bg-dark-300/80 text-white border border-gold-500/20 rounded-lg pl-8 pr-3 py-1.5 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 w-full transition-all">
                </div>

                <div class="flex-grow min-w-[220px] relative group">
                    <i class="fa-solid fa-location-dot absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
                    <input id="around-address-input" type="text" name="around_address" value="{{ aroundAddress|default('') }}" placeholder="Autour d'une adresse..." class="text-sm bg-dark-300/80 text-white border border-gold-500/20 rounded-lg pl-8 pr-3 py-1.5 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 w-full transition-all">
                    <input id="around-lat-input" type="hidden" name="around_lat" value="{{ aroundLat is not null ? aroundLat : '' }}">
                    <input id="around-lng-input" type="hidden" name="around_lng" value="{{ aroundLng is not null ? aroundLng : '' }}">
                </div>

                <div class="flex items-center gap-1 w-full sm:w-auto justify-end">
                    <input id="around-radius-input" type="number" name="around_radius" min="1" max="200" step="1" value="{{ aroundRadius|default(10) }}" class="text-sm bg-dark-300/80 text-white border border-gold-500/20 rounded-lg px-2 py-1.5 focus:border-gold-500 w-16 text-center">
                    <span class="text-gray-500 text-xs uppercase tracking-wide">km</span>
                </div>

                <button type="button" id="around-me-btn" class="bg-dark-200 hover:bg-blue-500/20 text-gray-300 hover:text-blue-300 border border-white/5 hover:border-blue-500/30 px-3 py-1.5 rounded-lg transition-all whitespace-nowrap text-sm">
                    <i class="fa-solid fa-location-crosshairs mr-1"></i>Autour de moi
                </button>

                <select name="categorie" class="text-sm bg-dark-300/80 text-gray-300 border border-gold-500/20 rounded-lg px-2 py-1.5 focus:border-gold-500 outline-none w-full sm:w-auto">
                    <option value="">Toutes catÃƒÂ©gories</option>
                    {% for cat in categories %}
                        <option value="{{ cat.id }}" {% if selectedCategorie == cat.id %}selected{% endif %}>{{ cat.nomCategorie }}</option>
                    {% endfor %}
                </select>

                <select name="statut" class="text-sm bg-dark-300/80 text-gray-300 border border-gold-500/20 rounded-lg px-2 py-1.5 focus:border-gold-500 outline-none w-full sm:w-auto">
                    <option value="">Statut (Tous)</option>
                    <option value="1" {% if selectedStatut == '1' %}selected{% endif %}>Actif</option>
                    <option value="0" {% if selectedStatut == '0' %}selected{% endif %}>Inactif</option>
                </select>

                <div class="flex items-center gap-1 w-full sm:w-auto justify-end">
                     <input type="number" name="prix_min" value="{{ prixMin }}" placeholder="Min" class="text-sm bg-dark-300/80 text-white border border-gold-500/20 rounded-lg px-2 py-1.5 focus:border-gold-500 w-16 text-center">
                     <span class="text-gray-500">-</span>
                     <input type="number" name="prix_max" value="{{ prixMax }}" placeholder="Max" class="text-sm bg-dark-300/80 text-white border border-gold-500/20 rounded-lg px-2 py-1.5 focus:border-gold-500 w-16 text-center">
                </div>

                <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                    <button type="submit" class="bg-gradient-to-r from-gold-500 to-yellow-600 hover:from-gold-400 hover:to-yellow-500 text-black px-4 py-1.5 rounded-lg font-bold transition-all shadow-[0_0_10px_rgba(255,215,0,0.2)] hover:shadow-[0_4px_15px_rgba(255,215,0,0.4)] whitespace-nowrap text-sm">
                        Filtrer
                    </button>

                    {% if searchQuery or selectedCategorie or selectedStatut is not empty or prixMin or prixMax or aroundAddress|default('') or aroundLat is not null or aroundLng is not null %}
                        <a href="{{ path('app_lieu_touristique_index') }}" class="bg-dark-200 hover:bg-red-500/20 text-gray-400 hover:text-red-400 border border-white/5 hover:border-red-500/30 px-2.5 py-1.5 rounded-lg transition-all transition-colors flex items-center justify-center h-8 w-8" title="RÃƒÂ©initialiser les filtres">
                            <i class="fa-solid fa-xmark"></i>
                        </a>
                    {% endif %}
                </div>
            </form>

            {% if aroundLat is not null and aroundLng is not null %}
                <div class="mt-2 text-xs text-blue-300/80 flex items-center gap-2">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Recherche de proximite active ({{ aroundRadius|default(10) }} km{% if aroundAddress|default('') %} - {{ aroundAddress }}{% endif %})</span>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<div class="card bg-gradient-to-br from-dark-300 to-black shadow-[0_8px_30px_rgba(0,0,0,0.5)] border-gold-500/10 relative overflow-hidden animate-[fade-in_0.5s_ease-out]">
    <div class="absolute -right-20 -top-20 w-64 h-64 bg-gold-500/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="flex flex-col sm:flex-row justify-between items-center sm:items-start mb-4 gap-4">
        <div class="text-gray-400 text-sm flex gap-3 items-center">
            <span class="text-gold-500 font-semibold"><i class="fa-solid fa-sort mr-1"></i> Trier par :</span>
            <div class="flex gap-2">
                <span class="hover:text-white transition">{{ knp_pagination_sortable(lieu_touristiques, 'Nom', 'l.nom') }}</span> |
                <span class="hover:text-white transition">{{ knp_pagination_sortable(lieu_touristiques, 'Prix', 'l.prix') }}</span> |
                <span class="hover:text-white transition">{{ knp_pagination_sortable(lieu_touristiques, 'Ville', 'l.ville') }}</span>
            </div>
        </div>
        <div class="flex items-center gap-2 mt-2 sm:mt-0">
            <button type="button" class="btn-dark px-3 py-2" data-carousel-prev="lieu-carousel" aria-label="PrÃƒÂ©cÃƒÂ©dent">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button type="button" class="btn-dark px-3 py-2" data-carousel-next="lieu-carousel" aria-label="Suivant">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>
    </div>

    {% if lieu_touristiques is empty %}
        <p class="text-center py-8 text-gray-500">Aucun lieu touristique trouvÃƒÂ©.</p>
    {% else %}
        <div id="lieu-carousel" class="flex gap-5 overflow-x-auto pb-3 snap-x snap-mandatory scroll-smooth">
            {% for lieu_touristique in lieu_touristiques %}
                {% set imagePath = lieu_touristique.image %}
                {% set normalizedPath = imagePath ? imagePath|replace({'\\': '/'}) : null %}
                {% if normalizedPath and normalizedPath starts with 'public/' %}
                    {% set normalizedPath = normalizedPath|slice(7) %}
                {% endif %}
                {% if normalizedPath and (normalizedPath starts with 'http://' or normalizedPath starts with 'https://') %}
                    {% set imageSrc = normalizedPath %}
                {% elseif normalizedPath and normalizedPath starts with '/' %}  
                    {% set imageSrc = normalizedPath %}
                {% elseif normalizedPath and normalizedPath starts with 'uploads/' %}
                    {% set imageSrc = asset(normalizedPath) %}
                {% elseif normalizedPath %}
                    {% set imageSrc = asset('uploads/lieux/' ~ normalizedPath) %}
                {% else %}
                    {% set imageSrc = null %}
                {% endif %}

                <article class="min-w-[88vw] sm:min-w-[500px] lg:min-w-[560px] max-w-[88vw] sm:max-w-[500px] lg:max-w-[560px] snap-start bg-gradient-to-b from-dark-200 to-dark-300 border border-white/5 hover:border-gold-500/30 rounded-2xl overflow-hidden flex flex-col group transition-all duration-500 hover:-translate-y-2 shadow-[0_4px_15px_rgba(0,0,0,0.5)]">
                    <div class="h-56 sm:h-64 bg-black/60 p-2 flex items-center justify-center relative overflow-hidden">
                        <div class="absolute inset-0 bg-gold-500/10 group-hover:bg-transparent transition-colors z-10 pointer-events-none"></div>
                        {% if imageSrc %}
                            <img src="{{ imageSrc }}" alt="Image de {{ lieu_touristique.nom }}" class="w-full h-full object-contain rounded-xl z-0 transition-transform duration-700 group-hover:scale-105" loading="lazy">
                        {% else %}
                            <div class="w-full h-full flex flex-col items-center justify-center text-gray-600">
                                <i class="fa-solid fa-image text-3xl mb-2 opacity-50"></i>
                                <span class="text-sm font-medium">Image non disponible</span>
                            </div>
                        {% endif %}
                    </div>

                    <div class="p-6 flex-1 flex flex-col relative">
                        <div class="flex items-center justify-between mb-4">    
                            <span class="text-gold-500/70 font-bold text-xs uppercase tracking-widest bg-gold-500/10 px-3 py-1 rounded-full border border-gold-500/20">Ref #{{ lieu_touristique.id }}</span>
                            <form action="{{ path('app_lieu_touristique_toggle_status', {'id': lieu_touristique.id}) }}" method="post" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ lieu_touristique.id) }}">
                                <button type="submit" class="transition-transform hover:scale-105" title="Changer le statut">
                                    {% if lieu_touristique.statut %}
                                        <span class="px-3 py-1 bg-green-500/10 text-green-400 hover:bg-green-500/20 font-semibold rounded-full text-xs border border-green-500/20 flex items-center gap-1.5 shadow-[0_0_10px_rgba(34,197,94,0.1)] transition-colors"><div class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></div> Actif</span>
                                    {% else %}
                                        <span class="px-3 py-1 bg-red-500/10 text-red-400 hover:bg-red-500/20 font-semibold rounded-full text-xs border border-red-500/20 flex items-center gap-1.5 shadow-[0_0_10px_rgba(239,68,68,0.1)] transition-colors"><div class="w-1.5 h-1.5 bg-red-500 rounded-full"></div> Inactif</span>
                                    {% endif %}
                                </button>
                            </form>
                        </div>

                        <h2 class="text-2xl font-black text-white mb-2 group-hover:text-gold-400 transition-colors drop-shadow">{{ lieu_touristique.nom }}</h2> 
                        <p class="text-sm text-gray-400 mb-4 font-medium"><i class="fa-solid fa-location-dot mr-2 text-gold-500/50"></i>{{ lieu_touristique.ville ?: 'Localisation inconnue' }}</p>

                        <div class="meteo-widget flex items-center justify-center gap-2 mb-4 p-2 bg-dark-200 border border-white/5 rounded-xl shadow-inner min-h-[46px]" data-ville="{{ lieu_touristique.ville }}">
                            <i class="fa-solid fa-circle-notch fa-spin text-gold-500/50"></i>
                            <span class="text-xs text-gray-500 italic">MÃƒÂ©tÃƒÂ©o en cours...</span>
                        </div>

                        <div class="flex items-center justify-between mt-auto pt-4 border-t border-white/5">
                            <p class="text-white font-black text-xl"><span class="text-gold-500 text-sm font-medium mr-1">DT</span>{{ lieu_touristique.prix ?: '0.00' }}</p>

                            <div class="flex gap-2">
                                <a href="{{ path('app_cart_add', {'id': lieu_touristique.id}) }}" class="w-10 h-10 rounded-xl bg-gradient-to-r from-gold-500 to-yellow-600 hover:from-gold-400 hover:to-yellow-500 text-black flex items-center justify-center border border-white/5 transition-all duration-300 shadow-[0_0_10px_rgba(255,215,0,0.2)] hover:shadow-[0_4px_15px_rgba(255,215,0,0.4)]" title="Ajouter au panier">
                                    <i class="fa-solid fa-cart-plus"></i>       
                                </a>
                                <a href="{{ path('app_lieu_touristique_show', {'id': lieu_touristique.id}) }}" class="w-10 h-10 rounded-xl bg-dark-200 hover:bg-gold-500/20 text-gray-400 hover:text-gold-400 flex items-center justify-center border border-white/5 transition-all duration-300 hover:border-gold-500/30" title="Voir plus">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                {% if is_granted('ROLE_ADMIN') %}
                                <form action="{{ path('app_lieu_touristique_duplicate', {'id': lieu_touristique.id}) }}" method="post" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('duplicate' ~ lieu_touristique.id) }}">
                                    <button type="submit" class="w-10 h-10 rounded-xl bg-dark-200 hover:bg-purple-500/20 text-gray-400 hover:text-purple-400 flex items-center justify-center border border-white/5 transition-all duration-300 hover:border-purple-500/30" title="Dupliquer">
                                        <i class="fa-solid fa-clone"></i>       
                                    </button>
                                </form>
                                <a href="{{ path('app_lieu_touristique_edit', {'id': lieu_touristique.id}) }}" class="w-10 h-10 rounded-xl bg-dark-200 hover:bg-blue-500/20 text-gray-400 hover:text-blue-400 flex items-center justify-center border border-white/5 transition-all duration-300 hover:border-blue-500/30" title="Modifier">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>

        <div class="mt-6 flex justify-center">
            {{ knp_pagination_render(lieu_touristiques) }}
        </div>
    {% endif %}
</div>

<script>
    const initCarouselControls = () => {
        document.querySelectorAll('[data-carousel-prev], [data-carousel-next]').forEach((btn) => {
            if (btn.dataset.boundCarousel === '1') {
                return;
            }
            btn.dataset.boundCarousel = '1';

            btn.addEventListener('click', () => {
                const id = btn.getAttribute('data-carousel-prev') || btn.getAttribute('data-carousel-next');
                const target = document.getElementById(id);
                if (!target) return;
                const step = target.clientWidth * 0.8;
                const direction = btn.hasAttribute('data-carousel-next') ? 1 : -1;
                target.scrollBy({ left: direction * step, behavior: 'smooth' });
            });
        });
    };

    const geocodeAddress = async (address) => {
        const query = encodeURIComponent(address);
        const response = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${query}`);
        if (!response.ok) {
            throw new Error('GEOCODE_FAILED');
        }

        const data = await response.json();
        if (!Array.isArray(data) || data.length === 0) {
            throw new Error('ADDRESS_NOT_FOUND');
        }

        return {
            lat: Number.parseFloat(data[0].lat),
            lng: Number.parseFloat(data[0].lon),
        };
    };

    const parseCoordinates = (value) => {
        const trimmed = (value || '').trim();
        if (!trimmed) {
            return null;
        }

        const patterns = [
            /^([+-]?\d+(?:[.,]\d+)?)\s*[,;]\s*([+-]?\d+(?:[.,]\d+)?)$/,
            /^([+-]?\d+(?:[.,]\d+)?)\s+([+-]?\d+(?:[.,]\d+)?)$/,
        ];

        for (const pattern of patterns) {
            const match = trimmed.match(pattern);
            if (!match) {
                continue;
            }

            const lat = Number.parseFloat(match[1].replace(',', '.'));
            const lng = Number.parseFloat(match[2].replace(',', '.'));

            if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
                continue;
            }

            if (lat < -90 || lat > 90 || lng < -180 || lng > 180) {
                continue;
            }

            return { lat, lng };
        }

        return null;
    };

    const initProximityFilters = () => {
        const form = document.querySelector('form[action="{{ path('app_lieu_touristique_index') }}"]');
        const aroundBtn = document.getElementById('around-me-btn');
        const addressInput = document.getElementById('around-address-input');
        const latInput = document.getElementById('around-lat-input');
        const lngInput = document.getElementById('around-lng-input');

        if (!form || !aroundBtn || !addressInput || !latInput || !lngInput) {
            return;
        }

        if (form.dataset.boundGeo === '1') {
            return;
        }
        form.dataset.boundGeo = '1';

        addressInput.addEventListener('input', () => {
            latInput.value = '';
            lngInput.value = '';
        });

        aroundBtn.addEventListener('click', () => {
            if (!('geolocation' in navigator)) {
                window.alert('La geolocalisation n\'est pas disponible sur ce navigateur.');
                return;
            }

            aroundBtn.disabled = true;
            const originalText = aroundBtn.innerHTML;
            aroundBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin mr-1"></i>Recherche...';

            navigator.geolocation.getCurrentPosition(
                (position) => {
                    latInput.value = position.coords.latitude.toFixed(6);
                    lngInput.value = position.coords.longitude.toFixed(6);
                    if (!addressInput.value.trim()) {
                        addressInput.value = 'Ma position actuelle';
                    }
                    if (typeof form.requestSubmit === 'function') {
                        form.requestSubmit();
                    } else {
                        form.submit();
                    }
                },
                () => {
                    window.alert('Impossible de recuperer votre position. Verifiez les permissions GPS.');
                    aroundBtn.disabled = false;
                    aroundBtn.innerHTML = originalText;
                },
                { enableHighAccuracy: true, timeout: 10000 }
            );
        });

        form.addEventListener('submit', async (event) => {
            if (form.dataset.geoSubmitted === '1') {
                form.dataset.geoSubmitted = '0';
                return;
            }

            const aroundAddress = addressInput.value.trim();
            const hasCoordinates = latInput.value.trim() !== '' && lngInput.value.trim() !== '';

            if (aroundAddress === '' || hasCoordinates) {
                return;
            }

            const directCoordinates = parseCoordinates(aroundAddress);
            if (directCoordinates) {
                event.preventDefault();
                latInput.value = directCoordinates.lat.toFixed(6);
                lngInput.value = directCoordinates.lng.toFixed(6);
                form.dataset.geoSubmitted = '1';
                form.submit();
                return;
            }

            event.preventDefault();

            try {
                const coords = await geocodeAddress(aroundAddress);
                latInput.value = coords.lat.toFixed(6);
                lngInput.value = coords.lng.toFixed(6);
                form.dataset.geoSubmitted = '1';
                form.submit();
            } catch {
                window.alert('Adresse introuvable. Merci de verifier la saisie.');
            }
        });
    };

    const initWeather = async () => {
        const widgets = document.querySelectorAll(".meteo-widget");
        for (const widget of widgets) {
            if (widget.dataset.loaded) continue;
            widget.dataset.loaded = "true";

            const ville = widget.dataset.ville;
            if (!ville || ville.trim() === "" || ville === "Localisation inconnue") {
                widget.innerHTML = `<i class="fa-solid fa-cloud-sun text-gray-600"></i> <span class="text-xs text-gray-500 italic">MÃ¯Â¿Â½tÃ¯Â¿Â½o indisponible</span>`;
                continue;
            }

            try {
                const searchQuery = encodeURIComponent(ville);
                const geoRes = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${searchQuery}&count=1&language=fr&format=json`);

                if (!geoRes.ok) throw new Error("GeoAPI fail");
                const geoData = await geoRes.json();

                if (!geoData.results || geoData.results.length === 0) {
                    widget.innerHTML = `<i class="fa-solid fa-location-question text-gray-500"></i> <span class="text-xs text-gray-500 italic">Non trouvÃ¯Â¿Â½e</span>`;
                    continue;
                }

                const lat = geoData.results[0].latitude;
                const lon = geoData.results[0].longitude;

                const weatherRes = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true`);
                if (!weatherRes.ok) throw new Error("WeatherAPI fail");
                const weatherData = await weatherRes.json();

                const temp = Math.round(weatherData.current_weather.temperature);
                const code = weatherData.current_weather.weathercode;

                let iconCode = "fa-cloud-sun text-gray-400 drop-shadow-[0_0_5px_rgba(156,163,175,0.5)]";
                if (code <= 3) iconCode = "fa-sun text-yellow-400 drop-shadow-[0_0_8px_rgba(250,204,21,0.5)]";
                else if (code >= 45 && code <= 48) iconCode = "fa-smog text-gray-400 drop-shadow-[0_0_5px_rgba(156,163,175,0.5)]";
                else if (code >= 51 && code <= 67) iconCode = "fa-cloud-rain text-blue-400 drop-shadow-[0_0_8px_rgba(96,165,250,0.5)]";
                else if (code >= 71 && code <= 77) iconCode = "fa-snowflake text-white drop-shadow-[0_0_8px_rgba(255,255,255,0.5)]";
                else if (code >= 80 && code <= 82) iconCode = "fa-cloud-showers-heavy text-blue-500";
                else if (code >= 95 && code <= 99) iconCode = "fa-bolt text-yellow-500";

                widget.innerHTML = `<div class="flex items-center justify-between w-full px-2"><div class="flex items-center gap-3"><i class="fa-solid ${iconCode} text-xl"></i><span class="text-white font-bold text-lg tracking-wide">${temp}Ã¯Â¿Â½C</span></div><span class="text-[10px] uppercase tracking-wider text-gray-400 font-semibold bg-dark-300 px-2 py-1 rounded-full border border-white/5">Actuellement</span></div>`;
            } catch (e) {
                console.error("MÃ¯Â¿Â½tÃ¯Â¿Â½o erreur:", e);
                widget.innerHTML = `<i class="fa-solid fa-circle-exclamation text-red-500/50"></i> <span class="text-xs text-red-400/50 italic">Erreur rÃ¯Â¿Â½seau</span>`;
            }
        }
    };

    document.addEventListener("turbo:load", initWeather);
    document.addEventListener("DOMContentLoaded", initWeather);
    document.addEventListener("turbo:load", initCarouselControls);
    document.addEventListener("DOMContentLoaded", initCarouselControls);
    document.addEventListener("turbo:load", initProximityFilters);
    document.addEventListener("DOMContentLoaded", initProximityFilters);

    initCarouselControls();
    initProximityFilters();
    initWeather();
</script>

