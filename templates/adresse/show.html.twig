{% extends 'base.html.twig' %}

{% block title %}Adresse: {{ adresse.rue }}, {{ adresse.ville }}{% endblock %}

{% block body %}
<div class="mb-6 flex justify-between items-center">
    <h1 class="text-3xl font-bold text-gold-500 drop-shadow-[0_2px_10px_rgba(255,215,0,0.3)]">
        <i class="fa-solid fa-location-dot mr-2"></i> Détails de l'Adresse
    </h1>
    <div class="space-x-3 flex">
        <a href="{{ path('app_adresse_index') }}" class="btn-dark"><i class="fa-solid fa-arrow-left mr-2"></i>Retour</a>
        {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_adresse_edit', {'id': adresse.id}) }}" class="btn-gold"><i class="fa-solid fa-pen mr-2"></i>Modifier</a>
        {% endif %}
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
    <div class="card lg:col-span-2">
        {% set lat = adresse.latitude is not null ? adresse.latitude|number_format(6, '.', ' ') : null %}
        {% set lng = adresse.longitude is not null ? adresse.longitude|number_format(6, '.', ' ') : null %}
        {% set alt = adresse.altitude is not null ? adresse.altitude|number_format(1, '.', ' ') : null %}
        <table class="w-full text-left">
            <tbody>
                <tr class="border-b border-white/5">
                    <th class="py-3 text-gray-400 w-1/3">ID</th>
                    <td class="font-medium text-gold-400">#{{ adresse.id }}</td>
                </tr>
                <tr class="border-b border-white/5">
                    <th class="py-3 text-gray-400">Rue</th>
                    <td class="font-bold text-lg">{{ adresse.rue }}</td>
                </tr>
                <tr class="border-b border-white/5">
                    <th class="py-3 text-gray-400">Ville</th>
                    <td><i class="fa-solid fa-city mr-2 text-gray-500"></i>{{ adresse.ville }}</td>
                </tr>
                <tr>
                    <th class="py-3 text-gray-400 align-top">Coordonnées</th>
                    <td class="py-3">
                        <div class="grid grid-cols-1 gap-2">
                            <div class="rounded-lg border border-cyan-400/20 bg-cyan-400/10 px-3 py-2">
                                <p class="text-[11px] uppercase tracking-wider text-cyan-300">Latitude</p>
                                <p class="text-sm font-semibold text-white">{{ lat ?: '-' }}</p>
                            </div>
                            <div class="rounded-lg border border-emerald-400/20 bg-emerald-400/10 px-3 py-2">
                                <p class="text-[11px] uppercase tracking-wider text-emerald-300">Longitude</p>
                                <p class="text-sm font-semibold text-white">{{ lng ?: '-' }}</p>
                            </div>
                            <div class="rounded-lg border border-amber-400/20 bg-amber-400/10 px-3 py-2">
                                <p class="text-[11px] uppercase tracking-wider text-amber-300">Altitude</p>
                                <p class="text-sm font-semibold text-white">{{ alt ? alt ~ ' m' : '-' }}</p>
                            </div>
                        </div>
                        {% if lat and lng %}
                            <a href="https://www.google.com/maps/search/?api=1&query={{ (adresse.latitude ~ ',' ~ adresse.longitude)|url_encode }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center mt-3 text-sm text-gold-400 hover:text-gold-500 transition-colors">
                                <i class="fa-solid fa-arrow-up-right-from-square mr-2"></i>Google Maps
                            </a>
                        {% endif %}
                    </td>
                </tr>
            </tbody>
        </table>
        
        {% if is_granted('ROLE_ADMIN') %}
        <div class="mt-8 pt-4 border-t border-red-500/20 flex justify-end">
            {{ include('adresse/_delete_form.html.twig') }}
        </div>
        {% endif %}
    </div>

    <!-- Map Card -->
    <div class="card lg:col-span-3 p-1 border-purple-500/20 shadow-[0_0_20px_rgba(168,85,247,0.1)] h-full min-h-[400px] flex flex-col bg-gradient-to-br from-dark-300 to-black">
        {% if lat and lng %}
            <div class="w-full h-full rounded-xl overflow-hidden relative group">
                <iframe 
                    width="100%" 
                    height="100%" 
                    frameborder="0" 
                    style="border:0" 
                    src="https://maps.google.com/maps?q={{ (adresse.latitude ~ ',' ~ adresse.longitude)|url_encode }}&hl=fr&z=14&output=embed" 
                    allowfullscreen
                    class="filter grayscale-[15%] contrast-125 saturate-150 brightness-90 hue-rotate-15 transition-all duration-700 group-hover:filter-none min-h-[400px]"
                >
                </iframe>
            </div>
        {% else %}
            <div class="flex-1 flex flex-col items-center justify-center text-gray-500 p-6 text-center">
                <div class="w-20 h-20 rounded-full bg-dark-200 border border-purple-500/20 flex items-center justify-center mb-4 text-3xl opacity-50">
                    <i class="fa-solid fa-map-pin"></i>
                </div>
                <p class="text-lg font-medium text-white mb-2">Carte indisponible</p>
                <p class="text-sm">Les coordonnées GPS (latitude et longitude) sont requises pour afficher la carte interactive.</p>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
