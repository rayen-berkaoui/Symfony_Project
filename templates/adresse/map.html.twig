{% extends 'base.html.twig' %}

{% block title %}Carte des Adresses - Tabaany{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<style>
    #map { height: 600px; width: 100%; border-radius: 1rem; z-index: 10; }
    .custom-popup .leaflet-popup-content-wrapper {
        background: #1A1A1A;
        color: #fff;
        border: 1px solid rgba(255, 215, 0, 0.2);
        box-shadow: 0 4px 15px rgba(0,0,0,0.5);
    }
    .custom-popup .leaflet-popup-tip {
        background: #1A1A1A;
        border: 1px solid rgba(255, 215, 0, 0.2);
    }
    .custom-popup .leaflet-popup-content {
        margin: 12px 16px;
        font-family: inherit;
        font-weight: 600;
    }
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
    function initMap() {
        const markersData = {{ markersJson|raw }};
        const mapContainerElement = document.getElementById('map');
        if (!mapContainerElement) return;

        // If the map is already initialized from a previous Turbo visit, un-initialize it.
        if (mapContainerElement._leaflet_id) {
            mapContainerElement._leaflet_id = null;
            mapContainerElement.innerHTML = "";
        }
        
        if (markersData.length === 0) {
            document.getElementById('map').innerHTML = '<div class="h-full w-full flex items-center justify-center text-gray-500 font-medium">Aucune donnée géographique disponible</div>';
            return;
        }

        // Center map on Tunisia by default, or the first marker
        const defaultCenter = markersData.length > 0 ? [markersData[0].lat, markersData[0].lng] : [33.8869, 9.5375];
        const map = L.map('map').setView(defaultCenter, 6);

        // Dark theme map tiles (CartoDB Dark Matter)
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
            subdomains: 'abcd',
            maxZoom: 20
        }).addTo(map);

        // Custom Gold Marker
        const goldIcon = new L.Icon({
            iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-gold.png',
            shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
            iconSize: [25, 41],
            iconAnchor: [12, 41],
            popupAnchor: [1, -34],
            shadowSize: [41, 41]
        });

        const bounds = [];
        
        markersData.forEach(function(marker) {
            if (marker.lat && marker.lng) {
                const latLng = [marker.lat, marker.lng];
                bounds.push(latLng);
                L.marker(latLng, {icon: goldIcon})
                    .addTo(map)
                    .bindPopup('<div class="text-gold-400"><i class="fa-solid fa-location-dot mr-2"></i>' + marker.title + '</div>', {
                        className: 'custom-popup'
                    });
            }
        });

        // Fit map to markers bounds if any exist
        if (bounds.length > 0) {
            map.fitBounds(bounds, { padding: [50, 50] });
        }
    }

    document.addEventListener('turbo:load', initMap);
    document.addEventListener('DOMContentLoaded', initMap);

    // Call it immediately just in case the DOM is already fully loaded
    if (document.readyState !== 'loading') {
        initMap();
    }
</script>
{% endblock %}

{% block body %}
<div class="mb-8 flex flex-col sm:flex-row items-center justify-between gap-4 animate-[fade-in_0.5s_ease-out]">
    <div>
        <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-yellow-600 mb-2">Carte Globale</h1>
        <p class="text-gray-400 text-lg">Visualisez toutes vos adresses répertoriées.</p>
    </div>
    
    <a href="{{ path('app_adresse_index') }}" class="group flex items-center justify-center gap-2 bg-dark-200 hover:bg-dark-300 border border-white/5 hover:border-gold-500/30 text-gray-400 hover:text-gold-400 px-5 py-2.5 rounded-xl transition-all duration-300">
        <i class="fa-solid fa-arrow-left transition-transform group-hover:-translate-x-1"></i>
        <span>Retour à la liste</span>
    </a>
</div>

<div class="card bg-gradient-to-br from-dark-300 to-black shadow-[0_8px_30px_rgba(0,0,0,0.5)] border-gold-500/10 p-2 relative overflow-hidden animate-[fade-in_0.5s_ease-out]">
    <div class="absolute -right-20 -top-20 w-64 h-64 bg-gold-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-blue-500/5 rounded-full blur-3xl pointer-events-none"></div>
    
    <div id="map" class="shadow-inner relative z-10 border border-white/5"></div>
</div>
{% endblock %}
