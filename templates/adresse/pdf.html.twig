{% extends 'pdf_layout.html.twig' %}

{% block title %}Export PDF - Adresses{% endblock %}

{% block body %}
    <h1 class="title">Liste des Adresses</h1>
    <table>
        <thead>
            <tr>
                <th>Rue</th>
                <th>Ville</th>
                <th>Latitude</th>
                <th>Longitude</th>
            </tr>
        </thead>
        <tbody>
        {% for adresse in adresses %}
            <tr>
                <td>{{ adresse.rue }}</td>
                <td>{{ adresse.ville }}</td>
                <td>{{ adresse.latitude }}</td>
                <td>{{ adresse.longitude }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Aucun enregistrement trouvÃ</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
