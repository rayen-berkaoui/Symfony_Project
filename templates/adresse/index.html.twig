{% extends 'base.html.twig' %}

{% block title %}Adresses{% endblock %}

{% block body %}
<div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-6 animate-fade-in-up"> 
    <div>
        <h1 class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-r from-gold-400 to-gold-600 drop-shadow-[0_2px_10px_rgba(255,215,0,0.3)] mb-2">Adresses</h1>
        <p class="text-gray-400 font-medium tracking-wide">Gestion des coordonnées géographiques et postales.</p>
    </div>
    <div class="flex flex-col sm:flex-row items-center gap-4 w-full md:w-auto"> 
        <form method="get" action="{{ path('app_adresse_index') }}" class="relative w-full sm:w-72 group">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i class="fa-solid fa-search text-gray-500 group-focus-within:text-gold-500 transition-colors"></i>
            </div>
            <input type="text" name="search" value="{{ searchQuery|default('') }}" placeholder="Rechercher une adresse..." 
                   class="w-full bg-dark-200/50 backdrop-blur-md text-white border border-white/10 rounded-xl pl-10 pr-4 py-2.5 focus:border-gold-500/50 focus:ring-1 focus:ring-gold-500/50 transition-all shadow-[inset_0_2px_4px_rgba(0,0,0,0.2)] placeholder-gray-500 font-medium">
        </form>
        <div class="flex gap-3 w-full sm:w-auto mt-4 sm:mt-0">
            <a href="{{ path('app_adresse_map') }}" class="flex-1 sm:flex-none flex items-center justify-center gap-2 bg-gradient-to-br from-blue-500/20 to-blue-600/10 hover:from-blue-500/30 hover:to-blue-600/20 text-blue-400 font-semibold py-2.5 px-5 rounded-xl border border-blue-500/20 hover:border-blue-500/40 transition-all duration-300 shadow-[0_0_15px_rgba(59,130,246,0.1)] hover:shadow-[0_0_20px_rgba(59,130,246,0.2)]" title="Voir sur la carte">
                <i class="fa-solid fa-map"></i> <span class="hidden sm:inline">Carte Interactive</span>
            </a>
            <a href="{{ path('app_adresse_pdf') }}" target="_blank" class="hidden sm:flex flex-1 sm:flex-none items-center justify-center gap-2 bg-gradient-to-br from-red-500/20 to-red-600/10 hover:from-red-500/30 hover:to-red-600/20 text-red-400 font-semibold py-2.5 px-5 rounded-xl border border-red-500/20 hover:border-red-500/40 transition-all duration-300 shadow-[0_0_15px_rgba(239,68,68,0.1)] hover:shadow-[0_0_20px_rgba(239,68,68,0.2)]" title="Exporter en PDF">
                <i class="fa-solid fa-file-pdf"></i> <span>PDF</span>
            </a>
            {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_adresse_new') }}" class="flex-1 sm:flex-none flex items-center justify-center gap-2 bg-gradient-to-r from-gold-500 to-gold-600 hover:from-gold-400 hover:to-gold-500 text-dark-300 font-black py-2.5 px-6 rounded-xl transition-all duration-300 transform hover:-translate-y-1 hover:shadow-[0_10px_20px_rgba(251,191,36,0.3)] whitespace-nowrap">
                <i class="fa-solid fa-plus text-lg"></i> Créer
            </a>
            {% endif %}
        </div>
    </div>
</div>

<div class="bg-dark-200/40 backdrop-blur-xl border border-white/5 rounded-3xl p-6 sm:p-8 shadow-[0_8px_30px_rgb(0,0,0,0.5)] relative overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute -top-24 -right-24 w-64 h-64 bg-gold-500/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-blue-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="flex flex-col sm:flex-row justify-between items-center sm:items-start mb-6 gap-4 relative z-10">
        <!-- Pagination sort removed -->
        <div class="flex items-center gap-2 ml-auto">
            <button type="button" class="w-10 h-10 rounded-xl bg-dark-300/50 hover:bg-gold-500/20 text-gray-400 hover:text-gold-400 flex items-center justify-center border border-white/5 hover:border-gold-500/30 transition-all duration-300" data-carousel-prev="adresse-carousel" aria-label="Précédent">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button type="button" class="w-10 h-10 rounded-xl bg-dark-300/50 hover:bg-gold-500/20 text-gray-400 hover:text-gold-400 flex items-center justify-center border border-white/5 hover:border-gold-500/30 transition-all duration-300" data-carousel-next="adresse-carousel" aria-label="Suivant">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>
    </div>

    {% if adresses is empty %}
        <div class="flex flex-col items-center justify-center py-20 text-center relative z-10">
            <div class="w-24 h-24 bg-dark-300/50 rounded-full flex items-center justify-center mb-6 border border-white/5">
                <i class="fa-solid fa-map-location-dot text-4xl text-gray-600"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">Aucune adresse</h3>
            <p class="text-gray-500 max-w-md">Ajoutez votre première adresse pour localiser vos lieux.</p>
        </div>
    {% else %}
        <div id="adresse-carousel" class="flex gap-6 overflow-x-auto pb-6 snap-x snap-mandatory scroll-smooth relative z-10">
            {% for adresse in adresses %}
                <article class="min-w-[85vw] sm:min-w-[400px] lg:min-w-[450px] max-w-[85vw] sm:max-w-[400px] lg:max-w-[450px] snap-start bg-gradient-to-br from-dark-200 to-dark-300 border border-white/5 hover:border-gold-500/30 rounded-2xl p-6 flex flex-col group transition-all duration-500 hover:-translate-y-2 shadow-[0_4px_15px_rgba(0,0,0,0.5)] relative overflow-hidden">
                    
                    <div class="absolute inset-0 bg-gold-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

                    {% set lat = adresse.latitude is not null ? adresse.latitude|number_format(6, '.', ' ') : null %}
                    {% set lng = adresse.longitude is not null ? adresse.longitude|number_format(6, '.', ' ') : null %}
                    {% set alt = adresse.altitude is not null ? adresse.altitude|number_format(1, '.', ' ') : null %}
                    
                    <div class="flex items-center justify-between mb-5 relative z-10">        
                        <span class="text-gold-500/70 font-bold text-xs uppercase tracking-widest bg-gold-500/10 px-3 py-1 rounded-full border border-gold-500/20">Ref #{{ adresse.id }}</span>
                        <span class="text-xs text-blue-400 font-semibold bg-blue-500/10 px-3 py-1 rounded-full border border-blue-500/20 flex items-center shadow-[0_0_10px_rgba(59,130,246,0.1)]">
                            <i class="fa-solid fa-city mr-1.5"></i>{{ adresse.ville }}
                        </span>
                    </div>

                    <h2 class="text-2xl font-black text-white mb-5 group-hover:text-gold-400 transition-colors drop-shadow relative z-10">{{ adresse.rue }}</h2>
                    
                    <div class="flex-1 space-y-4 relative z-10">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">     
                            <div class="rounded-xl border border-cyan-400/20 bg-cyan-400/5 px-4 py-3 hover:bg-cyan-400/10 transition-colors cursor-crosshair">
                                <p class="text-[10px] sm:text-xs uppercase tracking-widest text-cyan-500/80 font-bold mb-1"><i class="fa-solid fa-up-down mr-1"></i>Latitude</p>
                                <p class="text-sm font-black text-cyan-100">{{ lat ?: 'N/A' }}</p>
                            </div>
                            <div class="rounded-xl border border-emerald-400/20 bg-emerald-400/5 px-4 py-3 hover:bg-emerald-400/10 transition-colors cursor-crosshair">
                                <p class="text-[10px] sm:text-xs uppercase tracking-widest text-emerald-500/80 font-bold mb-1"><i class="fa-solid fa-left-right mr-1"></i>Longitude</p>
                                <p class="text-sm font-black text-emerald-100">{{ lng ?: 'N/A' }}</p>
                            </div>
                            <div class="rounded-xl border border-amber-400/20 bg-amber-400/5 px-4 py-3 sm:col-span-2 flex items-center justify-between hover:bg-amber-400/10 transition-colors cursor-crosshair">
                                <p class="text-[10px] sm:text-xs uppercase tracking-widest text-amber-500/80 font-bold"><i class="fa-solid fa-mountain mr-1"></i>Altitude</p>
                                <p class="text-sm font-black text-amber-100">{{ alt ? alt ~ ' mètres' : 'N/A' }}</p>
                            </div>
                        </div>
                        
                        {% if lat and lng %}
                            <a href="https://www.google.com/maps/search/?api=1&query={{ (adresse.latitude ~ ',' ~ adresse.longitude)|url_encode }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-full bg-dark-300 hover:bg-gold-500/10 text-sm text-gold-400 hover:text-gold-500 transition-colors py-2.5 rounded-xl border border-white/5 hover:border-gold-500/30 group/link">
                                <i class="fa-solid fa-location-arrow mr-2 group-hover/link:animate-bounce"></i>Ouvrir dans Google Maps
                            </a>
                        {% endif %}
                    </div>

                    <div class="mt-6 pt-5 border-t border-white/10 flex justify-end gap-3 relative z-10">
                        <a href="{{ path('app_adresse_show', {'id': adresse.id}) }}" class="w-10 h-10 rounded-xl bg-dark-300 hover:bg-gold-500/20 text-gray-400 hover:text-gold-400 flex items-center justify-center border border-white/5 transition-all duration-300 hover:border-gold-500/30" title="Détails">
                            <i class="fa-solid fa-eye"></i>
                        </a>     
                        {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_adresse_edit', {'id': adresse.id}) }}" class="w-10 h-10 rounded-xl bg-dark-300 hover:bg-blue-500/20 text-gray-400 hover:text-blue-400 flex items-center justify-center border border-white/5 transition-all duration-300 hover:border-blue-500/30" title="Modifier">
                            <i class="fa-solid fa-pen"></i>
                        </a>     
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
        
        <div class="mt-6 flex justify-center relative z-10">
            {{ knp_pagination_render(adresses) }}
        </div>
    {% endif %}
</div>

<script>
    document.querySelectorAll('[data-carousel-prev], [data-carousel-next]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-carousel-prev') || btn.getAttribute('data-carousel-next');
            const target = document.getElementById(id);
            if (!target) return;
            const step = target.clientWidth * 0.8;
            const direction = btn.hasAttribute('data-carousel-next') ? 1 : -1;
            target.scrollBy({ left: direction * step, behavior: 'smooth' });
        });
    });
</script>

<style>
    /* Custom Scrollbar for Carousel */
    .snap-x::-webkit-scrollbar {
        height: 12px;
    }
    .snap-x::-webkit-scrollbar-track {
        background: rgba(30, 41, 59, 0.5); /* dark-200 / slate-800 equivalent */
        border-radius: 9999px;
    }
    .snap-x::-webkit-scrollbar-thumb {
        background: linear-gradient(to right, #fbbf24, #b45309); /* gold gradient */
        border-radius: 9999px;
        border: 3px solid rgba(15, 23, 42, 1); /* dark-300 / slate-900 border to create padding effect */
    }
    .snap-x::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(to right, #f59e0b, #92400e);
    }
</style>
{% endblock %}
