{% extends 'base.html.twig' %}

{% block title %}Tabaany - Découvrez le monde autrement{% endblock %}

{% block body %}
<!-- Hero Section -->
<div class="hero-landing">
    <div class="container hero-landing-content">
        <div class="hero-text">
            <span class="hero-badge">🌍 Voyage & Loisirs</span>
            <h1 class="hero-title-large gradient-text">Découvrez votre destination comme un local</h1>
            <p class="hero-subtitle">
                Tabaany vous aide à trouver facilement <strong>où aller, quoi faire et où manger</strong>. 
                Toutes les meilleures adresses et activités, regroupées dans une seule application simple et pratique.
            </p>
            
            <div class="hero-buttons">
                <a class="btn solid btn-large" href="{{ path('app_signup') }}">
                    <span>Commencer l'aventure</span>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                </a>
                <a class="btn ghost btn-large" href="{{ path('app_login') }}">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/>
                    </svg>
                    Se connecter
                </a>
            </div>
            
            <div class="hero-stats">
                <div class="stat-item">
                    <span class="stat-number">1000+</span>
                    <span class="stat-label">Destinations</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number">5000+</span>
                    <span class="stat-label">Restaurants</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number">2000+</span>
                    <span class="stat-label">Activités</span>
                </div>
            </div>
        </div>
        
        <div class="hero-visual">
            <div class="floating-card card-1">
                <span class="card-icon">🗺️</span>
                <h4>Explorez</h4>
                <p>Découvrez les meilleurs spots</p>
            </div>
            <div class="floating-card card-2">
                <span class="card-icon">🍽️</span>
                <h4>Savourez</h4>
                <p>Les meilleures tables</p>
            </div>
            <div class="floating-card card-3">
                <span class="card-icon">🎭</span>
                <h4>Vivez</h4>
                <p>Activités inoubliables</p>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="features-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title-center gradient-text">Pourquoi choisir Tabaany ?</h2>
            <p class="section-subtitle">Une expérience de voyage simplifiée et personnalisée pour tous vos déplacements</p>
        </div>
        
        <div class="features-grid">
            <div class="feature-card bounce-in" style="--i: 0">
                <div class="feature-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                        <circle cx="12" cy="10" r="3"/>
                    </svg>
                </div>
                <h3>Tout au même endroit</h3>
                <p class="muted">Plus besoin de chercher partout. Restaurants, activités, attractions : tout est regroupé pour vous faciliter la vie.</p>
            </div>
            
            <div class="feature-card bounce-in" style="--i: 1">
                <div class="feature-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2a10 10 0 1 0 0 20 10 10 0 1 0 0-20z"/>
                        <path d="M12 6v6l4 2"/>
                    </svg>
                </div>
                <h3>Gagnez du temps</h3>
                <p class="muted">Des recommandations rapides et pertinentes. Trouvez les meilleures options en quelques clics, sans complications.</p>
            </div>
            
            <div class="feature-card bounce-in" style="--i: 2">
                <div class="feature-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>
                <h3>Profil personnalisé</h3>
                <p class="muted">Enregistrez vos lieux préférés, gérez vos réservations et conservez vos préférences en un seul endroit.</p>
            </div>
            
            <div class="feature-card bounce-in" style="--i: 3">
                <div class="feature-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                </div>
                <h3>Recommandations intelligentes</h3>
                <p class="muted">Des suggestions personnalisées adaptées à vos goûts et à votre historique de voyage.</p>
            </div>
            
            <div class="feature-card bounce-in" style="--i: 4">
                <div class="feature-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <path d="M16 2v4M8 2v4M3 10h18"/>
                    </svg>
                </div>
                <h3>Réservations faciles</h3>
                <p class="muted">Réservez vos restaurants et activités directement depuis l'application en toute simplicité.</p>
            </div>
            
            <div class="feature-card bounce-in" style="--i: 5">
                <div class="feature-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <path d="M9 22V12h6v10"/>
                    </svg>
                </div>
                <h3>Comme un local</h3>
                <p class="muted">Découvrez votre destination avec des informations claires et utiles, comme si vous y habitiez depuis toujours.</p>
            </div>
        </div>
    </div>
</div>

<!-- CTA Section -->
<div class="cta-section">
    <div class="container">
        <div class="cta-card">
            <h2 class="gradient-text">Prêt pour votre prochaine aventure ?</h2>
            <p>Rejoignez des milliers de voyageurs qui utilisent déjà Tabaany pour découvrir le monde</p>
            <a class="btn solid btn-large" href="{{ path('app_signup') }}">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                    <path d="M20 8v6M23 11h-6"/>
                </svg>
                Créer mon compte gratuitement
            </a>
        </div>
    </div>
</div>
{% endblock %}
